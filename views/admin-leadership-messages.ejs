<!-- CLIENT JAVASCRIPT: TABS, DRAG-AND-DROP, DYNAMIC PARAGRAPHS, AND ASYNC APIs -->
<script>
document.addEventListener('DOMContentLoaded', function() {
    
    // Toast notification utility
    const toast = document.getElementById('actionToast');
    const toastMessage = document.getElementById('toastMessage');
    function showToast(msg, isSuccess = true) {
        if (!toast || !toastMessage) return;
        toastMessage.textContent = msg;
        toast.className = `fixed bottom-6 right-6 z-50 text-white text-xs font-semibold px-4 py-3 rounded-xl shadow-2xl flex items-center gap-2.5 transition-all transform duration-300 ${isSuccess ? 'bg-slate-900' : 'bg-rose-900'}`;
        toast.classList.remove('hidden');
        setTimeout(() => {
            toast.classList.add('hidden');
        }, 3500);
    }

    // 1. Tab Navigation Handling
    const tabBtns = document.querySelectorAll('.tab-btn');
    const tabContents = document.querySelectorAll('.tab-content');

    tabBtns.forEach(btn => {
        btn.addEventListener('click', () => {
            const targetId = btn.getAttribute('data-tab-target');
            
            // Activate button style
            tabBtns.forEach(b => {
                b.className = 'tab-btn inline-flex items-center gap-2 py-4 px-1 border-b-2 border-transparent text-xs sm:text-sm font-semibold text-slate-500 hover:text-slate-700 hover:border-slate-300 whitespace-nowrap focus:outline-none';
            });
            btn.className = 'tab-btn active inline-flex items-center gap-2 py-4 px-1 border-b-2 border-blue-600 text-xs sm:text-sm font-bold text-blue-600 whitespace-nowrap focus:outline-none';

            // Show target content
            tabContents.forEach(c => c.classList.add('hidden'));
            const targetContent = document.getElementById(targetId);
            if (targetContent) targetContent.classList.remove('hidden');
        });
    });

    // 2. Dynamic Paragraphs Manager
    const paragraphsContainer = document.getElementById('paragraphsContainer');
    const btnAddParagraph = document.getElementById('btnAddParagraph');

    function createParagraphRow(text = '') {
        const row = document.createElement('div');
        row.className = 'paragraph-item flex items-start gap-2 bg-slate-50 border border-slate-200 p-3 rounded-xl transition';
        row.innerHTML = `
            <span class="text-xs font-bold text-slate-400 mt-2 shrink-0 paragraph-index">¶</span>
            <textarea class="paragraph-textarea w-full bg-white border border-slate-200 rounded-lg p-2.5 text-xs font-medium text-slate-800 leading-relaxed focus:outline-none focus:ring-1 focus:ring-blue-500" rows="3" placeholder="Enter paragraph content...">${text.replace(/</g, '&lt;').replace(/>/g, '&gt;')}</textarea>
            <div class="flex flex-col gap-1 shrink-0">
                <button type="button" class="btn-para-up p-1 text-slate-400 hover:text-slate-700 rounded hover:bg-slate-200 transition" title="Move Up">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7" /></svg>
                </button>
                <button type="button" class="btn-para-down p-1 text-slate-400 hover:text-slate-700 rounded hover:bg-slate-200 transition" title="Move Down">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
                </button>
                <button type="button" class="btn-para-del p-1 text-rose-500 hover:text-rose-700 rounded hover:bg-rose-50 transition" title="Remove Paragraph">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6" /></svg>
                </button>
            </div>
        `;

        // Up button
        row.querySelector('.btn-para-up').addEventListener('click', () => {
            const prev = row.previousElementSibling;
            if (prev) {
                paragraphsContainer.insertBefore(row, prev);
                updateParagraphIndices();
            }
        });

        // Down button
        row.querySelector('.btn-para-down').addEventListener('click', () => {
            const next = row.nextElementSibling;
            if (next) {
                paragraphsContainer.insertBefore(next, row);
                updateParagraphIndices();
            }
        });

        // Delete button
        row.querySelector('.btn-para-del').addEventListener('click', () => {
            if (paragraphsContainer.querySelectorAll('.paragraph-item').length > 1) {
                row.remove();
                updateParagraphIndices();
            } else {
                row.querySelector('textarea').value = '';
            }
        });

        return row;
    }

    function updateParagraphIndices() {
        const rows = paragraphsContainer.querySelectorAll('.paragraph-item');
        rows.forEach((r, idx) => {
            const badge = r.querySelector('.paragraph-index');
            if (badge) badge.textContent = `¶ ${idx + 1}`;
        });
    }

    if (btnAddParagraph) {
        btnAddParagraph.addEventListener('click', () => {
            const newRow = createParagraphRow('');
            paragraphsContainer.appendChild(newRow);
            updateParagraphIndices();
            newRow.querySelector('textarea').focus();
        });
    }

    // 3. Signature Type Switcher & Live Preview
    const signatureTypeSelect = document.getElementById('signatureTypeSelect');
    const signatureTypedBox = document.getElementById('signatureTypedBox');
    const signatureImageBox = document.getElementById('signatureImageBox');
    const signatureNameInput = document.getElementById('signatureNameInput');
    const signatureScriptPreview = document.getElementById('signatureScriptPreview');
    const leaderNameInput = document.getElementById('leaderName');

    if (signatureTypeSelect) {
        signatureTypeSelect.addEventListener('change', () => {
            if (signatureTypeSelect.value === 'image') {
                signatureTypedBox.classList.add('hidden');
                signatureImageBox.classList.remove('hidden');
            } else {
                signatureImageBox.classList.add('hidden');
                signatureTypedBox.classList.remove('hidden');
            }
        });
    }

    if (signatureNameInput && signatureScriptPreview) {
        signatureNameInput.addEventListener('input', () => {
            signatureScriptPreview.textContent = signatureNameInput.value || leaderNameInput.value || 'Signature';
        });
    }

    if (leaderNameInput) {
        leaderNameInput.addEventListener('input', () => {
            if (!signatureNameInput.value && signatureScriptPreview) {
                signatureScriptPreview.textContent = leaderNameInput.value || 'Signature';
            }
        });
    }

    // Image previews on file selection
    function setupImagePreview(fileInputId, previewImgId) {
        const fileInput = document.getElementById(fileInputId);
        const previewImg = document.getElementById(previewImgId);
        if (!fileInput || !previewImg) return;

        fileInput.addEventListener('change', (e) => {
            const file = e.target.files && e.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = (re) => {
                    previewImg.src = re.target.result;
                    previewImg.classList.remove('hidden');
                    const ph = document.getElementById('signaturePlaceholder');
                    if (ph && fileInputId === 'signatureImageInput') ph.classList.add('hidden');
                };
                reader.readAsDataURL(file);
            }
        });
    }

    setupImagePreview('portraitImageInput', 'portraitPreview');
    setupImagePreview('signatureImageInput', 'signaturePreview');
    setupImagePreview('supportingImageInput', 'supportingPreview');
    setupImagePreview('cardImageInput', 'cardImagePreview');

    // 4. Modal Open / Close Logic for Leaders
    const leaderModal = document.getElementById('leaderModal');
    const btnAddLeader = document.getElementById('btnAddLeader');
    const btnCloseLeaderModal = document.getElementById('btnCloseLeaderModal');
    const btnCancelLeaderModal = document.getElementById('btnCancelLeaderModal');
    const leaderForm = document.getElementById('leaderForm');
    const leaderModalTitle = document.getElementById('leaderModalTitle');

    function openLeaderModal(leaderData = null) {
        leaderForm.reset();
        paragraphsContainer.innerHTML = '';

        if (leaderData) {
            leaderModalTitle.textContent = 'Edit Leader Profile';
            document.getElementById('leaderId').value = leaderData.id || '';
            document.getElementById('leaderName').value = leaderData.name || '';
            document.getElementById('leaderDesignation').value = leaderData.designation || '';
            document.getElementById('leaderRoleLabel').value = leaderData.roleLabel || 'A MESSAGE FROM THE FOUNDER';
            document.getElementById('leaderCompanyName').value = leaderData.companyName || 'SOLANKI PIPES';
            document.getElementById('leaderHeadline').value = leaderData.headline || '';
            document.getElementById('leaderHeadlineHighlight').value = leaderData.headlineHighlight || '';
            document.getElementById('leaderGreeting').value = leaderData.greeting || '';
            document.getElementById('leaderQuote').value = leaderData.quote || '';
            document.getElementById('leaderClosing').value = leaderData.closing || 'Warm regards,';
            document.getElementById('leaderDisplayOrder').value = leaderData.displayOrder || 1;
            document.getElementById('leaderStatus').checked = leaderData.status !== 'inactive';

            // Portrait
            if (leaderData.portraitImage) {
                document.getElementById('portraitPreview').src = leaderData.portraitImage;
                document.getElementById('portraitImageUrl').value = leaderData.portraitImage;
            }

            // Supporting Image
            if (leaderData.supportingImage) {
                document.getElementById('supportingPreview').src = leaderData.supportingImage;
                document.getElementById('supportingImageUrl').value = leaderData.supportingImage;
            }

            // Signature
            signatureTypeSelect.value = leaderData.signatureType || 'typed';
            if (leaderData.signatureType === 'image') {
                signatureTypedBox.classList.add('hidden');
                signatureImageBox.classList.remove('hidden');
                if (leaderData.signature) {
                    const sp = document.getElementById('signaturePreview');
                    sp.src = leaderData.signature;
                    sp.classList.remove('hidden');
                    const sph = document.getElementById('signaturePlaceholder');
                    if (sph) sph.classList.add('hidden');
                }
            } else {
                signatureImageBox.classList.add('hidden');
                signatureTypedBox.classList.remove('hidden');
                document.getElementById('signatureNameInput').value = leaderData.signatureName || leaderData.name || '';
                signatureScriptPreview.textContent = leaderData.signatureName || leaderData.name || 'Signature';
            }

            // Paragraphs
            const paras = Array.isArray(leaderData.paragraphs) && leaderData.paragraphs.length > 0 ? leaderData.paragraphs : [''];
            paras.forEach(p => {
                paragraphsContainer.appendChild(createParagraphRow(p));
            });
            updateParagraphIndices();
        } else {
            leaderModalTitle.textContent = 'Add New Leader';
            document.getElementById('leaderId').value = '';
            document.getElementById('portraitPreview').src = '/images/sukinder_solanki.jpg';
            document.getElementById('supportingPreview').src = '/images/pipe_fittings_render.jpg';
            signatureTypeSelect.value = 'typed';
            signatureTypedBox.classList.remove('hidden');
            signatureImageBox.classList.add('hidden');
            signatureScriptPreview.textContent = 'New Leader';
            paragraphsContainer.appendChild(createParagraphRow(''));
            updateParagraphIndices();
        }

        leaderModal.classList.remove('hidden');
    }

    function closeLeaderModal() {
        leaderModal.classList.add('hidden');
    }

    if (btnAddLeader) btnAddLeader.addEventListener('click', () => openLeaderModal(null));
    if (btnCloseLeaderModal) btnCloseLeaderModal.addEventListener('click', closeLeaderModal);
    if (btnCancelLeaderModal) btnCancelLeaderModal.addEventListener('click', closeLeaderModal);

    // Edit Leader Click
    document.querySelectorAll('.btn-edit-leader').forEach(btn => {
        btn.addEventListener('click', async () => {
            const id = btn.getAttribute('data-id');
            try {
                const res = await fetch(`/api/leadership/${id}`);
                const json = await res.json();
                if (json.success && json.leader) {
                    openLeaderModal(json.leader);
                } else {
                    alert('Could not load leader details');
                }
            } catch (e) {
                console.error(e);
                alert('Error loading leader details');
            }
        });
    });

    // Delete Leader Click
    document.querySelectorAll('.btn-delete-leader').forEach(btn => {
        btn.addEventListener('click', async () => {
            const id = btn.getAttribute('data-id');
            const name = btn.getAttribute('data-name');
            if (confirm(`Are you sure you want to delete "${name}"? This action cannot be undone.`)) {
                try {
                    const res = await fetch(`/api/leadership/${id}`, { method: 'DELETE' });
                    const json = await res.json();
                    if (json.success) {
                        showToast('Leader removed successfully');
                        setTimeout(() => window.location.reload(), 600);
                    } else {
                        alert(json.message || 'Failed to delete leader');
                    }
                } catch (e) {
                    console.error(e);
                    alert('Error deleting leader');
                }
            }
        });
    });

    // Toggle Leader Active Status
    document.querySelectorAll('.btn-toggle-status').forEach(btn => {
        btn.addEventListener('click', async () => {
            const id = btn.getAttribute('data-id');
            const curStatus = btn.getAttribute('data-status');
            const newStatus = curStatus === 'active' ? 'inactive' : 'active';
            try {
                const res = await fetch(`/api/leadership/${id}/status`, {
                    method: 'PATCH',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ status: newStatus })
                });
                const json = await res.json();
                if (json.success) {
                    showToast(`Status updated: ${newStatus}`);
                    setTimeout(() => window.location.reload(), 500);
                }
            } catch (e) {
                console.error(e);
            }
        });
    });

    // Handle Leader Form Submit (Multipart / AJAX)
    if (leaderForm) {
        leaderForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            const submitBtn = document.getElementById('btnSubmitLeaderModal');
            const submitText = document.getElementById('btnSubmitLeaderText');
            submitBtn.disabled = true;
            submitText.textContent = 'Saving...';

            try {
                const formData = new FormData();
                const id = document.getElementById('leaderId').value;
                if (id) formData.append('id', id);

                formData.append('name', document.getElementById('leaderName').value);
                formData.append('designation', document.getElementById('leaderDesignation').value);
                formData.append('roleLabel', document.getElementById('leaderRoleLabel').value);
                formData.append('companyName', document.getElementById('leaderCompanyName').value);
                formData.append('headline', document.getElementById('leaderHeadline').value);
                formData.append('headlineHighlight', document.getElementById('leaderHeadlineHighlight').value);
                formData.append('greeting', document.getElementById('leaderGreeting').value);
                formData.append('quote', document.getElementById('leaderQuote').value);
                formData.append('closing', document.getElementById('leaderClosing').value);
                formData.append('displayOrder', document.getElementById('leaderDisplayOrder').value);
                formData.append('status', document.getElementById('leaderStatus').checked ? 'active' : 'inactive');
                
                // Images
                const portraitInput = document.getElementById('portraitImageInput');
                if (portraitInput.files && portraitInput.files[0]) {
                    formData.append('portraitImage', portraitInput.files[0]);
                } else {
                    formData.append('portraitImage', document.getElementById('portraitImageUrl').value);
                }

                const supportingInput = document.getElementById('supportingImageInput');
                if (supportingInput.files && supportingInput.files[0]) {
                    formData.append('supportingImage', supportingInput.files[0]);
                } else {
                    formData.append('supportingImage', document.getElementById('supportingImageUrl').value);
                }

                // Signature
                const sigType = signatureTypeSelect.value;
                formData.append('signatureType', sigType);
                if (sigType === 'image') {
                    const sigInput = document.getElementById('signatureImageInput');
                    if (sigInput.files && sigInput.files[0]) {
                        formData.append('signatureImage', sigInput.files[0]);
                    }
                } else {
                    formData.append('signatureName', document.getElementById('signatureNameInput').value || document.getElementById('leaderName').value);
                }

                // Collect paragraphs
                const paraTextareas = paragraphsContainer.querySelectorAll('.paragraph-textarea');
                paraTextareas.forEach(t => {
                    if (t.value.trim()) {
                        formData.append('paragraphs', t.value.trim());
                    }
                });

                const endpoint = id ? `/api/leadership/${id}` : '/api/leadership';
                const res = await fetch(endpoint, {
                    method: 'POST',
                    body: formData
                });
                const json = await res.json();

                if (json.success) {
                    showToast('Leader saved successfully!');
                    closeLeaderModal();
                    setTimeout(() => window.location.reload(), 600);
                } else {
                    alert(json.message || 'Error saving leader');
                }
            } catch (err) {
                console.error(err);
                alert('Failed to save leader');
            } finally {
                submitBtn.disabled = false;
                submitText.textContent = 'Save Leader';
            }
        });
    }

    // 5. Drag-and-Drop / Move Leaders Reordering
    const sortableLeaderBody = document.getElementById('leadersSortableBody');
    if (sortableLeaderBody) {
        let draggedRow = null;

        sortableLeaderBody.addEventListener('dragstart', (e) => {
            const row = e.target.closest('.leader-row');
            if (row) {
                draggedRow = row;
                row.classList.add('opacity-40', 'bg-blue-50');
            }
        });

        sortableLeaderBody.addEventListener('dragend', (e) => {
            const row = e.target.closest('.leader-row');
            if (row) {
                row.classList.remove('opacity-40', 'bg-blue-50');
            }
            draggedRow = null;
        });

        sortableLeaderBody.addEventListener('dragover', (e) => {
            e.preventDefault();
            const targetRow = e.target.closest('.leader-row');
            if (targetRow && targetRow !== draggedRow && draggedRow) {
                const rect = targetRow.getBoundingClientRect();
                const next = (e.clientY - rect.top) / (rect.bottom - rect.top) > 0.5;
                sortableLeaderBody.insertBefore(draggedRow, next ? targetRow.nextSibling : targetRow);
            }
        });

        sortableLeaderBody.addEventListener('drop', async (e) => {
            e.preventDefault();
            await saveLeadersOrder();
        });

        // Quick Move Up / Down
        document.querySelectorAll('.btn-move-leader').forEach(btn => {
            btn.addEventListener('click', async () => {
                const row = btn.closest('.leader-row');
                const dir = btn.getAttribute('data-dir');
                if (dir === 'up' && row.previousElementSibling) {
                    sortableLeaderBody.insertBefore(row, row.previousElementSibling);
                    await saveLeadersOrder();
                } else if (dir === 'down' && row.nextElementSibling) {
                    sortableLeaderBody.insertBefore(row.nextElementSibling, row);
                    await saveLeadersOrder();
                }
            });
        });

        async function saveLeadersOrder() {
            const rows = sortableLeaderBody.querySelectorAll('.leader-row');
            const leaderIds = [];
            rows.forEach((r, idx) => {
                leaderIds.push(r.getAttribute('data-id'));
                const numSpan = r.querySelector('.leader-order-num');
                if (numSpan) numSpan.textContent = idx + 1;
            });

            try {
                const res = await fetch('/api/leadership/reorder', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ leaderIds })
                });
                const json = await res.json();
                if (json.success) {
                    showToast('Sequence updated successfully');
                }
            } catch (e) {
                console.error(e);
            }
        }
    }

    // 6. Action Cards Modals & CRUD
    const actionCardModal = document.getElementById('actionCardModal');
    const btnAddActionCard = document.getElementById('btnAddActionCard');
    const btnCloseActionModal = document.getElementById('btnCloseActionModal');
    const btnCancelActionModal = document.getElementById('btnCancelActionModal');
    const actionCardForm = document.getElementById('actionCardForm');
    const actionModalTitle = document.getElementById('actionModalTitle');

    function openActionModal(cardData = null) {
        actionCardForm.reset();
        if (cardData) {
            actionModalTitle.textContent = 'Edit Action Card';
            document.getElementById('cardId').value = cardData.id || '';
            document.getElementById('cardCategory').value = cardData.category || '';
            document.getElementById('cardTitle').value = cardData.title || '';
            document.getElementById('cardDescription').value = cardData.description || '';
            document.getElementById('cardDisplayOrder').value = cardData.displayOrder || 1;
            document.getElementById('cardStatus').checked = cardData.status !== 'inactive';
            if (cardData.image) {
                document.getElementById('cardImagePreview').src = cardData.image;
                document.getElementById('cardImageUrl').value = cardData.image;
            }
        } else {
            actionModalTitle.textContent = 'Add Action Card';
            document.getElementById('cardId').value = '';
            document.getElementById('cardImagePreview').src = '/images/sp_img1.jpeg';
        }
        actionCardModal.classList.remove('hidden');
    }

    function closeActionModal() {
        actionCardModal.classList.add('hidden');
    }

    if (btnAddActionCard) btnAddActionCard.addEventListener('click', () => openActionModal(null));
    if (btnCloseActionModal) btnCloseActionModal.addEventListener('click', closeActionModal);
    if (btnCancelActionModal) btnCancelActionModal.addEventListener('click', closeActionModal);

    // Edit Action Card
    document.querySelectorAll('.btn-edit-card').forEach(btn => {
        btn.addEventListener('click', async () => {
            const id = btn.getAttribute('data-id');
            try {
                const res = await fetch(`/api/leadership-action/${id}`);
                const json = await res.json();
                if (json.success && json.actionCard) {
                    openActionModal(json.actionCard);
                }
            } catch (e) {
                console.error(e);
            }
        });
    });

    // Delete Action Card
    document.querySelectorAll('.btn-delete-card').forEach(btn => {
        btn.addEventListener('click', async () => {
            const id = btn.getAttribute('data-id');
            const title = btn.getAttribute('data-title');
            if (confirm(`Delete action card "${title}"?`)) {
                try {
                    const res = await fetch(`/api/leadership-action/${id}`, { method: 'DELETE' });
                    const json = await res.json();
                    if (json.success) {
                        showToast('Card deleted');
                        setTimeout(() => window.location.reload(), 500);
                    }
                } catch (e) {
                    console.error(e);
                }
            }
        });
    });

    // Toggle Card Status
    document.querySelectorAll('.btn-toggle-card-status').forEach(btn => {
        btn.addEventListener('click', async () => {
            const id = btn.getAttribute('data-id');
            const cur = btn.getAttribute('data-status');
            const newStatus = cur === 'active' ? 'inactive' : 'active';
            try {
                const res = await fetch(`/api/leadership-action/${id}/status`, {
                    method: 'PATCH',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ status: newStatus })
                });
                const json = await res.json();
                if (json.success) {
                    showToast(`Status updated: ${newStatus}`);
                    setTimeout(() => window.location.reload(), 500);
                }
            } catch (e) {
                console.error(e);
            }
        });
    });

    // Save Action Card Submit
    if (actionCardForm) {
        actionCardForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            try {
                const formData = new FormData();
                const id = document.getElementById('cardId').value;
                if (id) formData.append('id', id);

                formData.append('category', document.getElementById('cardCategory').value);
                formData.append('title', document.getElementById('cardTitle').value);
                formData.append('description', document.getElementById('cardDescription').value);
                formData.append('displayOrder', document.getElementById('cardDisplayOrder').value);
                formData.append('status', document.getElementById('cardStatus').checked ? 'active' : 'inactive');

                const imgInput = document.getElementById('cardImageInput');
                if (imgInput.files && imgInput.files[0]) {
                    formData.append('cardImage', imgInput.files[0]);
                } else {
                    formData.append('image', document.getElementById('cardImageUrl').value);
                }

                const endpoint = id ? `/api/leadership-action/${id}` : '/api/leadership-action';
                const res = await fetch(endpoint, { method: 'POST', body: formData });
                const json = await res.json();

                if (json.success) {
                    showToast('Action card saved!');
                    closeActionModal();
                    setTimeout(() => window.location.reload(), 600);
                } else {
                    alert(json.message || 'Error saving action card');
                }
            } catch (e) {
                console.error(e);
                alert('Failed to save action card');
            }
        });
    }

    // Save Action Section Headings
    const btnSaveActionHeaders = document.getElementById('btnSaveActionHeaders');
    if (btnSaveActionHeaders) {
        btnSaveActionHeaders.addEventListener('click', async () => {
            const payload = {
                actionSubtitle: document.getElementById('actionSubtitleInput').value,
                actionTitle: document.getElementById('actionTitleInput').value,
                actionLocationBadge: document.getElementById('actionLocationBadgeInput').value
            };
            try {
                const res = await fetch('/api/leadership-settings', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const json = await res.json();
                if (json.success) {
                    showToast('Section headings saved!');
                }
            } catch (e) {
                console.error(e);
            }
        });
    }

    // 7. Carousel Settings Form Submit
    const carouselSettingsForm = document.getElementById('carouselSettingsForm');
    if (carouselSettingsForm) {
        carouselSettingsForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            const payload = {
                carousel: {
                    autoplay: document.getElementById('settingAutoplay').checked,
                    autoplaySpeed: Number(document.getElementById('settingAutoplaySpeed').value) || 6000,
                    pauseOnHover: document.getElementById('settingPauseOnHover').checked,
                    showArrows: document.getElementById('settingShowArrows').checked,
                    showDots: document.getElementById('settingShowDots').checked,
                    showLeaderTabs: document.getElementById('settingShowLeaderTabs').checked,
                    transitionStyle: document.getElementById('settingTransitionStyle').value,
                    enableSwipe: document.getElementById('settingEnableSwipe').checked,
                    defaultActiveSlide: Number(document.getElementById('settingDefaultActiveSlide').value) || 0
                }
            };
            try {
                const res = await fetch('/api/leadership-settings', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const json = await res.json();
                if (json.success) {
                    showToast('Carousel settings updated!');
                }
            } catch (err) {
                console.error(err);
                alert('Error updating carousel settings');
            }
        });
    }

    // 8. Hero Settings Form Submit
    const heroSettingsForm = document.getElementById('heroSettingsForm');
    if (heroSettingsForm) {
        heroSettingsForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            const payload = {
                pageTitle: document.getElementById('settingPageTitle').value,
                tagline: document.getElementById('settingTagline').value,
                showTagline: document.getElementById('settingShowTagline').checked,
                breadcrumbHome: document.getElementById('settingBreadcrumbHome').value,
                breadcrumbAbout: document.getElementById('settingBreadcrumbAbout').value,
                breadcrumbCurrent: document.getElementById('settingBreadcrumbCurrent').value
            };
            try {
                const res = await fetch('/api/leadership-settings', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const json = await res.json();
                if (json.success) {
                    showToast('Hero banner settings saved!');
                }
            } catch (err) {
                console.error(err);
                alert('Error updating hero settings');
            }
        });
    }

});
</script>

<%- include('partials/admin-footer') %>

