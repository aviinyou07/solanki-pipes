                    <div>
                        <span class="block text-xs font-bold text-slate-800 uppercase">Enable Autoplay</span>
                        <span class="block text-[11px] text-slate-500 mt-0.5">Slides advance automatically</span>
                    </div>
                    <label class="relative inline-flex items-center cursor-pointer">
                        <input type="checkbox" id="settingAutoplay" class="sr-only peer" <%= carouselSettings.autoplay !== false ? 'checked' : '' %>>
                        <div class="w-11 h-6 bg-slate-300 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-blue-600"></div>
                    </label>
                </div>

                <!-- Pause on Hover -->
                <div class="p-5 rounded-xl border border-slate-200 bg-slate-50/50 flex items-center justify-between">
                    <div>
                        <span class="block text-xs font-bold text-slate-800 uppercase">Pause on Hover</span>
                        <span class="block text-[11px] text-slate-500 mt-0.5">Stops timer when cursor enters</span>
                    </div>
                    <label class="relative inline-flex items-center cursor-pointer">
                        <input type="checkbox" id="settingPauseOnHover" class="sr-only peer" <%= carouselSettings.pauseOnHover !== false ? 'checked' : '' %>>
                        <div class="w-11 h-6 bg-slate-300 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-blue-600"></div>
                    </label>
                </div>

                <!-- Navigation Arrows -->
                <div class="p-5 rounded-xl border border-slate-200 bg-slate-50/50 flex items-center justify-between">
                    <div>
                        <span class="block text-xs font-bold text-slate-800 uppercase">Navigation Arrows</span>
                        <span class="block text-[11px] text-slate-500 mt-0.5">Show left/right floating arrows</span>
                    </div>
                    <label class="relative inline-flex items-center cursor-pointer">
                        <input type="checkbox" id="settingShowArrows" class="sr-only peer" <%= carouselSettings.showArrows !== false ? 'checked' : '' %>>
                        <div class="w-11 h-6 bg-slate-300 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-blue-600"></div>
                    </label>
                </div>

                <!-- Pagination Dots -->
                <div class="p-5 rounded-xl border border-slate-200 bg-slate-50/50 flex items-center justify-between">
                    <div>
                        <span class="block text-xs font-bold text-slate-800 uppercase">Pagination Dots</span>
                        <span class="block text-[11px] text-slate-500 mt-0.5">Show indicator dots below carousel</span>
                    </div>
                    <label class="relative inline-flex items-center cursor-pointer">
                        <input type="checkbox" id="settingShowDots" class="sr-only peer" <%= carouselSettings.showDots !== false ? 'checked' : '' %>>
                        <div class="w-11 h-6 bg-slate-300 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-blue-600"></div>
                    </label>
                </div>

                <!-- Leader Navigation Tabs -->
                <div class="p-5 rounded-xl border border-slate-200 bg-slate-50/50 flex items-center justify-between">
                    <div>
                        <span class="block text-xs font-bold text-slate-800 uppercase">Leader Tabs / Pills</span>
                        <span class="block text-[11px] text-slate-500 mt-0.5">Show clickable person cards below</span>
                    </div>
                    <label class="relative inline-flex items-center cursor-pointer">
                        <input type="checkbox" id="settingShowLeaderTabs" class="sr-only peer" <%= carouselSettings.showLeaderTabs !== false ? 'checked' : '' %>>
                        <div class="w-11 h-6 bg-slate-300 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-blue-600"></div>
                    </label>
                </div>

                <!-- Mobile Swipe -->
                <div class="p-5 rounded-xl border border-slate-200 bg-slate-50/50 flex items-center justify-between">
                    <div>
                        <span class="block text-xs font-bold text-slate-800 uppercase">Mobile Touch Swipe</span>
                        <span class="block text-[11px] text-slate-500 mt-0.5">Allow swiping left/right on mobile</span>
                    </div>
                    <label class="relative inline-flex items-center cursor-pointer">
                        <input type="checkbox" id="settingEnableSwipe" class="sr-only peer" <%= carouselSettings.enableSwipe !== false ? 'checked' : '' %>>
                        <div class="w-11 h-6 bg-slate-300 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-blue-600"></div>
                    </label>
                </div>

            </div>

            <!-- Parameters (Speed, Style, Default Slide) -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 pt-4 border-t border-slate-100">
                <div>
                    <label class="block text-xs font-bold text-slate-700 uppercase mb-2">Autoplay Interval (Milliseconds)</label>
                    <input type="number" id="settingAutoplaySpeed" min="2000" max="20000" step="500" value="<%= carouselSettings.autoplaySpeed || 6000 %>" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm font-medium text-slate-800 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:bg-white transition">
                    <p class="text-[11px] text-slate-400 mt-1">6000 ms = 6 seconds</p>
                </div>

                <div>
                    <label class="block text-xs font-bold text-slate-700 uppercase mb-2">Transition Style</label>
                    <select id="settingTransitionStyle" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm font-medium text-slate-800 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:bg-white transition">
                        <option value="slide" <%= carouselSettings.transitionStyle === 'slide' ? 'selected' : '' %>>Slide Transition</option>
                        <option value="fade" <%= carouselSettings.transitionStyle === 'fade' ? 'selected' : '' %>>Fade Transition</option>
                    </select>
                </div>

                <div>
                    <label class="block text-xs font-bold text-slate-700 uppercase mb-2">Default Active Slide</label>
                    <select id="settingDefaultActiveSlide" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm font-medium text-slate-800 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:bg-white transition">
                        <% leaders.forEach((l, idx) => { %>
                            <option value="<%= idx %>" <%= (Number(carouselSettings.defaultActiveSlide) || 0) === idx ? 'selected' : '' %>>Slide <%= idx + 1 %>: <%= l.name %></option>
                        <% }); %>
                    </select>
                </div>
            </div>
        </form>
    </div>

    <!-- TAB 4: HERO BANNER & PAGE SETTINGS -->
    <div id="tab-hero" class="tab-content hidden space-y-6">
        <form id="heroSettingsForm" class="bg-white rounded-2xl border border-slate-200 shadow-xs p-6 sm:p-8 space-y-6">
