                    </div>
                    <div>
                        <label class="block text-[11px] font-semibold text-slate-500 mb-1">Level 3 (Current)</label>
                        <input type="text" id="settingBreadcrumbCurrent" value="<%= settings.breadcrumbCurrent || 'Leadership Messages' %>" class="w-full px-3 py-2 bg-white border border-slate-200 rounded-lg text-xs font-medium text-slate-800">
                    </div>
