            </div>

            <!-- Modal Footer -->
            <div class="pt-6 border-t border-slate-100 flex items-center justify-end gap-3 sticky bottom-0 bg-white z-20">
                <button type="button" id="btnCancelLeaderModal" class="px-5 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl text-xs font-bold transition">
                    Cancel
                </button>
                <button type="submit" id="btnSubmitLeaderModal" class="px-6 py-2.5 bg-blue-600 hover:bg-blue-700 text-white rounded-xl text-xs font-bold transition shadow-xs flex items-center gap-2">
                    <span id="btnSubmitLeaderText">Save Leader</span>
                </button>
            </div>
        </form>

    </div>
</div>

