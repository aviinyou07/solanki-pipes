                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>

    </div>

    <!-- TAB 3: CAROUSEL SETTINGS -->
