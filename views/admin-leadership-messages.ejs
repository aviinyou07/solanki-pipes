                            <span id="signatureScriptPreview" class="text-3xl text-blue-950 font-bold tracking-wide" style="font-family: 'Caveat', cursive;">Sukinder Solanki</span>
                            <input type="text" id="signatureNameInput" name="signatureName" placeholder="Signature text..." class="mt-3 w-full px-3 py-1.5 bg-white border border-slate-200 rounded-lg text-xs font-medium text-center">
