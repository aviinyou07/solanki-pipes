                        </div>
                        <input type="text" id="portraitImageUrl" name="portraitImageUrl" placeholder="or enter image URL" class="w-full px-3 py-1.5 bg-slate-50 border border-slate-200 rounded-lg text-xs">
                    </div>

                    <!-- Signature Image or Typed Alternative -->
                    <div class="space-y-2">
                        <div class="flex items-center justify-between">
                            <label class="text-xs font-bold text-slate-700 uppercase">Signature</label>
                            <select id="signatureTypeSelect" name="signatureType" class="text-[11px] font-semibold border border-slate-200 rounded-md px-1.5 py-0.5 bg-white text-slate-700">
                                <option value="typed">Typed Script</option>
                                <option value="image">Upload Image</option>
                            </select>
                        </div>
                        
                        <div id="signatureTypedBox" class="w-full h-44 rounded-2xl border border-slate-200 bg-slate-50 p-4 flex flex-col justify-center items-center">
