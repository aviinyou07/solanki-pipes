<%- include('partials/admin-header') %>

<%
    const d = (typeof data !== 'undefined' && data) ? data : {};
    const settings = d.settings || {};
    const carouselSettings = settings.carousel || {};
    const leaders = Array.isArray(d.leaders) ? d.leaders : [];
    const actionCards = Array.isArray(d.actionCards) ? d.actionCards : [];

    const activeLeaderCount = leaders.filter(l => l.status === 'active').length;
    const inactiveLeaderCount = leaders.length - activeLeaderCount;
    const activeActionCount = actionCards.filter(c => c.status === 'active').length;
%>

<div class="p-4 sm:p-6 lg:p-8 max-w-7xl mx-auto w-full">

    <!-- Top Page Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
        <div>
            <div class="flex items-center gap-2 mb-1">
                <span class="w-2.5 h-2.5 rounded-full bg-blue-600"></span>
                <span class="text-xs font-bold uppercase tracking-wider text-blue-600">Executive Content System</span>
            </div>
            <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
                Leadership <span class="text-blue-600">Messages CMS</span>
            </h1>
            <p class="text-slate-500 text-xs sm:text-sm mt-1">
                Manage leadership profiles, dynamic messages, carousel behavior, hero banner, and action cards.
            </p>
        </div>
        <div class="flex items-center gap-3">
            <a href="/leadership-messages" target="_blank" class="inline-flex items-center gap-2 px-4 py-2.5 bg-white border border-slate-200 rounded-xl text-xs font-bold text-slate-700 hover:bg-slate-50 hover:text-blue-600 transition shadow-xs">
                <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
                <span>Preview Public Page</span>
            </a>
        </div>
    </div>

    <!-- Alert / Flash Notifications -->
    <% if (typeof query !== 'undefined' && query.saved) { %>
    <div class="mb-6 p-4 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 flex items-center gap-3 shadow-xs">
        <svg class="w-5 h-5 text-emerald-600 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
        <div>
            <p class="text-xs sm:text-sm font-bold">Changes saved successfully!</p>
            <p class="text-xs text-emerald-600">Leadership messages and settings are live on the website.</p>
        </div>
    </div>
    <% } else if (typeof query !== 'undefined' && query.error) { %>
    <div class="mb-6 p-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 flex items-center gap-3 shadow-xs">
        <svg class="w-5 h-5 text-rose-600 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/></svg>
        <div>
            <p class="text-xs sm:text-sm font-bold">Operation failed</p>
            <p class="text-xs text-rose-600"><%= query.error %></p>
        </div>
    </div>
    <% } %>

    <!-- Global Floating Action Toast -->
    <div id="actionToast" class="hidden fixed bottom-6 right-6 z-50 bg-slate-900 text-white text-xs font-semibold px-4 py-3 rounded-xl shadow-2xl flex items-center gap-2.5 transition-all transform duration-300">
        <svg class="w-4 h-4 text-emerald-400 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
        <span id="toastMessage">Saved successfully</span>
    </div>

    <!-- Navigation Tabs -->
    <div class="border-b border-slate-200 mb-8">
        <nav class="flex space-x-2 sm:space-x-8 overflow-x-auto scrollbar-none" aria-label="Tabs">
            <button type="button" class="tab-btn active inline-flex items-center gap-2 py-4 px-1 border-b-2 border-blue-600 text-xs sm:text-sm font-bold text-blue-600 whitespace-nowrap focus:outline-none" data-tab-target="tab-leaders">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" /></svg>
                <span>Leadership Members</span>
                <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-blue-100 text-blue-700"><%= leaders.length %></span>
            </button>

            <button type="button" class="tab-btn inline-flex items-center gap-2 py-4 px-1 border-b-2 border-transparent text-xs sm:text-sm font-semibold text-slate-500 hover:text-slate-700 hover:border-slate-300 whitespace-nowrap focus:outline-none" data-tab-target="tab-actions">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" /></svg>
                <span>Leadership in Action</span>
                <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-slate-100 text-slate-600"><%= actionCards.length %></span>
            </button>

            <button type="button" class="tab-btn inline-flex items-center gap-2 py-4 px-1 border-b-2 border-transparent text-xs sm:text-sm font-semibold text-slate-500 hover:text-slate-700 hover:border-slate-300 whitespace-nowrap focus:outline-none" data-tab-target="tab-carousel">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" /></svg>
                <span>Carousel Settings</span>
            </button>

            <button type="button" class="tab-btn inline-flex items-center gap-2 py-4 px-1 border-b-2 border-transparent text-xs sm:text-sm font-semibold text-slate-500 hover:text-slate-700 hover:border-slate-300 whitespace-nowrap focus:outline-none" data-tab-target="tab-hero">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z" /></svg>
                <span>Hero Banner</span>
            </button>
        </nav>
    </div>

    <!-- TAB 1: LEADERSHIP MEMBERS -->
    <div id="tab-leaders" class="tab-content space-y-6">
        
        <!-- Summary Stats Card & Add Button -->
        <div class="bg-white rounded-2xl border border-slate-200 p-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4 shadow-xs">
            <div class="flex items-center gap-4 sm:gap-6">
                <div>
                    <span class="block text-2xl font-black text-slate-900"><%= leaders.length %></span>
                    <span class="block text-xs font-semibold text-slate-500">Total Leaders</span>
                </div>
                <div class="h-8 w-px bg-slate-200"></div>
                <div>
                    <span class="block text-2xl font-black text-emerald-600"><%= activeLeaderCount %></span>
                    <span class="block text-xs font-semibold text-slate-500">Active</span>
                </div>
                <div class="h-8 w-px bg-slate-200"></div>
                <div>
                    <span class="block text-2xl font-black text-slate-400"><%= inactiveLeaderCount %></span>
                    <span class="block text-xs font-semibold text-slate-500">Inactive</span>
                </div>
            </div>

            <div>
                <button type="button" id="btnAddLeader" class="inline-flex items-center gap-2 px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white rounded-xl text-xs font-bold transition shadow-xs">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
                    <span>Add New Leader</span>
                </button>
            </div>
        </div>

        <!-- Leaders List Table -->
        <div class="bg-white rounded-2xl border border-slate-200 shadow-xs overflow-hidden">
            <div class="p-6 border-b border-slate-100 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                <div>
                    <h3 class="text-base font-bold text-slate-900">Current Leadership Team</h3>
                    <p class="text-xs text-slate-500 mt-0.5">Drag rows using the handle or use the up/down arrows to change carousel display sequence.</p>
                </div>
                <% if (leaders.length > 1) { %>
                <div class="inline-flex items-center gap-1.5 bg-blue-50 text-blue-700 text-xs font-bold px-3 py-1.5 rounded-lg border border-blue-100">
                    <svg class="w-3.5 h-3.5 text-blue-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M7 16V4m0 0L3 8m4-4l4 4m6 0v12m0 0l4-4m-4 4l-4-4" /></svg>
                    <span>Drag & Drop Reordering Enabled</span>
                </div>
                <% } %>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse" id="leadersTable">
                    <thead>
                        <tr class="bg-slate-50 text-[11px] font-bold uppercase tracking-wider text-slate-500 border-b border-slate-200">
                            <th class="p-4 pl-6 w-24 text-center">Order</th>
                            <th class="p-4 w-20">Photo</th>
                            <th class="p-4">Name & Title</th>
                            <th class="p-4">Role Label</th>
                            <th class="p-4">Status</th>
                            <th class="p-4 text-center">Paragraphs</th>
                            <th class="p-4 pr-6 text-right w-44">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 text-xs sm:text-sm text-slate-700" id="leadersSortableBody">
                        <% if (leaders.length === 0) { %>
                            <tr>
                                <td colspan="7" class="p-8 text-center text-slate-400">
                                    No leadership members configured yet. Click "Add New Leader" above to create one.
                                </td>
                            </tr>
                        <% } else { %>
                            <% leaders.forEach((leader, index) => { %>
                                <tr class="hover:bg-blue-50/30 transition-colors group cursor-move leader-row" draggable="true" data-id="<%= leader.id %>">
                                    <!-- Sequence Handle -->
                                    <td class="p-4 pl-6 text-center">
                                        <div class="flex items-center justify-center gap-1.5">
                                            <span class="cursor-grab text-slate-300 group-hover:text-slate-600 transition" title="Drag to reorder">
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 8h16M4 16h16" /></svg>
                                            </span>
                                            <span class="inline-flex items-center justify-center w-6 h-6 rounded-md bg-slate-100 font-bold text-slate-700 text-xs leader-order-num">
                                                <%= index + 1 %>
                                            </span>
                                        </div>
                                    </td>

                                    <!-- Photo Thumbnail -->
                                    <td class="p-4">
                                        <div class="w-12 h-14 rounded-xl overflow-hidden bg-slate-100 border border-slate-200 shrink-0">
                                            <img src="<%= leader.portraitImage || '/images/sukinder_solanki.jpg' %>" alt="<%= leader.name %>" class="w-full h-full object-cover">
                                        </div>
                                    </td>

                                    <!-- Name & Designation -->
                                    <td class="p-4">
                                        <div class="font-bold text-slate-900"><%= leader.name %></div>
                                        <div class="text-xs text-blue-600 font-semibold"><%= leader.designation %></div>
                                        <% if (leader.companyName) { %>
                                            <div class="text-[11px] text-slate-400"><%= leader.companyName %></div>
                                        <% } %>
                                    </td>

                                    <!-- Role Label -->
                                    <td class="p-4">
                                        <span class="inline-block px-2.5 py-1 rounded-md text-[11px] font-bold bg-slate-100 text-slate-700">
                                            <%= leader.roleLabel || 'A MESSAGE FROM THE LEADER' %>
                                        </span>
                                    </td>

                                    <!-- Status Toggle -->
                                    <td class="p-4">
                                        <button type="button" class="btn-toggle-status inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold transition-all border <%= leader.status === 'active' ? 'bg-emerald-50 text-emerald-700 border-emerald-200' : 'bg-slate-100 text-slate-500 border-slate-200' %>" data-id="<%= leader.id %>" data-status="<%= leader.status %>">
                                            <span class="w-2 h-2 rounded-full <%= leader.status === 'active' ? 'bg-emerald-500' : 'bg-slate-400' %>"></span>
                                            <span><%= leader.status === 'active' ? 'Active' : 'Inactive' %></span>
                                        </button>
                                    </td>

                                    <!-- Paragraphs Count -->
                                    <td class="p-4 text-center">
                                        <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-slate-100 text-slate-600">
                                            <%= (Array.isArray(leader.paragraphs) ? leader.paragraphs.length : 1) %> ¶
                                        </span>
                                    </td>

                                    <!-- Actions -->
                                    <td class="p-4 pr-6 text-right">
                                        <div class="flex items-center justify-end gap-1.5">
                                            <!-- Quick Move Buttons -->
                                            <button type="button" class="btn-move-leader p-1.5 text-slate-400 hover:text-slate-700 hover:bg-slate-100 rounded-lg transition" data-dir="up" title="Move Up">
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7" /></svg>
                                            </button>
                                            <button type="button" class="btn-move-leader p-1.5 text-slate-400 hover:text-slate-700 hover:bg-slate-100 rounded-lg transition" data-dir="down" title="Move Down">
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
                                            </button>

                                            <!-- Edit Button -->
                                            <button type="button" class="btn-edit-leader p-1.5 text-blue-600 hover:bg-blue-50 rounded-lg transition" data-id="<%= leader.id %>" title="Edit Leader">
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" /></svg>
                                            </button>

                                            <!-- Delete Button -->
                                            <button type="button" class="btn-delete-leader p-1.5 text-rose-600 hover:bg-rose-50 rounded-lg transition" data-id="<%= leader.id %>" data-name="<%= leader.name %>" title="Delete Leader">
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>

    </div>

    <!-- TAB 2: LEADERSHIP IN ACTION CARDS -->
    <div id="tab-actions" class="tab-content hidden space-y-6">
        
        <!-- Header Controls for Action Section -->
        <div class="bg-white rounded-2xl border border-slate-200 p-6 space-y-6 shadow-xs">
            <div class="border-b border-slate-100 pb-3 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                <div>
                    <h3 class="text-base font-bold text-slate-900">Leadership in Action — Section Settings</h3>
                    <p class="text-xs text-slate-500">Configure the title, category tag, and facility badge shown above the action cards on the public page.</p>
                </div>
                <button type="button" id="btnSaveActionHeaders" class="px-4 py-2 bg-slate-900 hover:bg-blue-600 text-white rounded-xl text-xs font-bold transition shadow-xs">
                    Save Section Headings
                </button>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <div>
                    <label class="block text-xs font-bold text-slate-700 uppercase mb-2">Category Subtitle</label>
                    <input type="text" id="actionSubtitleInput" value="<%= settings.actionSubtitle || 'INFRASTRUCTURE & IMPACT' %>" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs font-medium text-slate-800 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:bg-white transition" placeholder="e.g. INFRASTRUCTURE & IMPACT">
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-700 uppercase mb-2">Main Section Title</label>
                    <input type="text" id="actionTitleInput" value="<%= settings.actionTitle || 'LEADERSHIP IN ACTION' %>" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs font-medium text-slate-800 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:bg-white transition" placeholder="e.g. LEADERSHIP IN ACTION">
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-700 uppercase mb-2">Location Badge Pill</label>
                    <input type="text" id="actionLocationBadgeInput" value="<%= settings.actionLocationBadge || '• Fatehabad & Bhiwani Facilities' %>" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs font-medium text-slate-800 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:bg-white transition" placeholder="e.g. • Fatehabad & Bhiwani Facilities">
                </div>
            </div>
        </div>

        <!-- Action Cards Management Header & Add Card -->
        <div class="bg-white rounded-2xl border border-slate-200 p-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4 shadow-xs">
            <div>
                <h3 class="text-base font-bold text-slate-900">Infrastructure & Impact Cards</h3>
                <p class="text-xs text-slate-500 mt-0.5">Cards rendered in a dynamic grid beneath the leadership message.</p>
            </div>
            <div>
                <button type="button" id="btnAddActionCard" class="inline-flex items-center gap-2 px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white rounded-xl text-xs font-bold transition shadow-xs">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
                    <span>Add New Action Card</span>
                </button>
            </div>
        </div>

        <!-- Action Cards Table -->
        <div class="bg-white rounded-2xl border border-slate-200 shadow-xs overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse" id="actionCardsTable">
                    <thead>
                        <tr class="bg-slate-50 text-[11px] font-bold uppercase tracking-wider text-slate-500 border-b border-slate-200">
                            <th class="p-4 pl-6 w-24 text-center">Order</th>
                            <th class="p-4 w-28">Image</th>
                            <th class="p-4">Category</th>
                            <th class="p-4">Title & Description</th>
                            <th class="p-4">Status</th>
                            <th class="p-4 pr-6 text-right w-36">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 text-xs sm:text-sm text-slate-700" id="actionCardsSortableBody">
                        <% if (actionCards.length === 0) { %>
                            <tr>
                                <td colspan="6" class="p-8 text-center text-slate-400">
                                    No action cards created yet. Click "Add New Action Card" above to add one.
                                </td>
                            </tr>
                        <% } else { %>
                            <% actionCards.forEach((card, index) => { %>
                                <tr class="hover:bg-blue-50/30 transition-colors group cursor-move action-card-row" draggable="true" data-id="<%= card.id %>">
                                    <td class="p-4 pl-6 text-center">
                                        <div class="flex items-center justify-center gap-1.5">
                                            <span class="cursor-grab text-slate-300 group-hover:text-slate-600 transition">
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 8h16M4 16h16" /></svg>
                                            </span>
                                            <span class="inline-flex items-center justify-center w-6 h-6 rounded-md bg-slate-100 font-bold text-slate-700 text-xs card-order-num">
                                                <%= index + 1 %>
                                            </span>
                                        </div>
                                    </td>

                                    <td class="p-4">
                                        <div class="w-20 h-14 rounded-xl overflow-hidden bg-slate-900 border border-slate-200 shrink-0">
                                            <img src="<%= card.image || '/images/sp_img1.jpeg' %>" alt="<%= card.title %>" class="w-full h-full object-cover">
                                        </div>
                                    </td>

                                    <td class="p-4">
                                        <span class="inline-block px-2.5 py-1 rounded-md text-[11px] font-bold bg-blue-50 text-blue-700 border border-blue-100 uppercase">
                                            <%= card.category %>
                                        </span>
                                    </td>

                                    <td class="p-4">
                                        <div class="font-bold text-slate-900"><%= card.title %></div>
                                        <% if (card.description) { %>
                                        <div class="text-xs text-slate-500 line-clamp-1 mt-0.5"><%= card.description %></div>
                                        <% } %>
                                    </td>

                                    <td class="p-4">
                                        <button type="button" class="btn-toggle-card-status inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold transition-all border <%= card.status === 'active' ? 'bg-emerald-50 text-emerald-700 border-emerald-200' : 'bg-slate-100 text-slate-500 border-slate-200' %>" data-id="<%= card.id %>" data-status="<%= card.status %>">
                                            <span class="w-2 h-2 rounded-full <%= card.status === 'active' ? 'bg-emerald-500' : 'bg-slate-400' %>"></span>
                                            <span><%= card.status === 'active' ? 'Active' : 'Inactive' %></span>
                                        </button>
                                    </td>

                                    <td class="p-4 pr-6 text-right">
                                        <div class="flex items-center justify-end gap-1.5">
                                            <button type="button" class="btn-edit-card p-1.5 text-blue-600 hover:bg-blue-50 rounded-lg transition" data-id="<%= card.id %>" title="Edit Card">
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" /></svg>
                                            </button>
