<%- include('partials/admin-header') %>

    <div class="flex-grow p-4 max-w-7xl w-full mx-auto">
        <!-- Header -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
            <div>
                <div class="flex items-center gap-2 text-xs font-bold text-slate-400 uppercase tracking-widest mb-1">
                    <a href="/admin/pages" class="hover:text-blue-600 transition">Pages</a>
                    <span>/</span>
                    <span class="text-blue-600">Downloads Center</span>
                </div>
                <h1 class="text-3xl font-extrabold text-gray-900 uppercase tracking-tight">Customize <span
                        class="text-blue-600">Downloads Page</span></h1>
                <p class="text-gray-500 text-sm mt-1">Manage downloadable official certificates, product catalogue,
                    corporate profile, MSDS, and upload PDF documents.</p>
            </div>
            <div class="flex items-center gap-3">
                <a href="/downloads" target="_blank"
                    class="bg-white hover:bg-slate-50 text-slate-700 border border-slate-200 font-bold py-2.5 px-4 rounded-xl shadow-sm transition flex items-center gap-2 text-xs">
                    <span>View Live Page</span>
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round"
                            d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25">
                        </path>
                    </svg>
                </a>
                <button type="submit" form="downloadsForm"
                    class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-2.5 px-6 rounded-xl shadow-md transition flex items-center gap-2 text-sm">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                    </svg>
                    <span>Save All Changes</span>
                </button>
            </div>
        </div>

        <!-- Edit Form -->
        <form id="downloadsForm" action="/admin/pages/downloads" method="POST" enctype="multipart/form-data"
            class="space-y-8">

            <!-- 1. HEADER SECTION -->
            <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm overflow-hidden">
                <div class="p-6 border-b border-slate-100 bg-slate-50/50 flex items-center justify-between">
                    <div>
                        <h2
                            class="text-base font-extrabold text-slate-800 uppercase tracking-wide flex items-center gap-2">
                            <span class="w-2.5 h-2.5 rounded-full bg-blue-600"></span>
                            1. Download Center Banner
                        </h2>
                        <p class="text-xs text-slate-400 mt-0.5">Top bold header and descriptive subtitle</p>
                    </div>
                </div>
                <div class="p-6">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                        <div>
                            <label class="block text-xs font-bold text-slate-700 mb-1.5 uppercase">Header Title</label>
                            <input type="text" name="headerTitle" value="<%= data.headerTitle || 'DOWNLOAD CENTER' %>"
                                class="w-full text-sm border border-slate-200 rounded-xl px-4 py-2.5 focus:outline-none focus:border-blue-500 bg-white font-bold">
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-slate-700 mb-1.5 uppercase">Header
                                Subtitle</label>
                            <input type="text" name="headerSubtitle"
                                value="<%= data.headerSubtitle || 'Official Documents and Certificates' %>"
                                class="w-full text-sm border border-slate-200 rounded-xl px-4 py-2.5 focus:outline-none focus:border-blue-500 bg-white">
                        </div>
                    </div>
                </div>
            </div>

            <!-- 2. DOWNLOADABLE DOCUMENTS GRID -->
            <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm overflow-hidden">
                <div
                    class="p-6 border-b border-slate-100 bg-slate-50/50 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                    <div>
                        <h2
                            class="text-base font-extrabold text-slate-800 uppercase tracking-wide flex items-center gap-2">
                            <span class="w-2.5 h-2.5 rounded-full bg-blue-600"></span>
                            2. Manage Downloadable Documents
                        </h2>
                        <p class="text-xs text-slate-400 mt-0.5">Customize document card titles, descriptions, emoji
                            icons, and upload new PDF or document files.</p>
                    </div>
                    <button type="button" onclick="addDocumentRow()"
                        class="bg-blue-50 hover:bg-blue-100 text-blue-700 border border-blue-200 font-bold px-3 py-1.5 rounded-lg text-xs transition flex items-center gap-1.5 w-fit">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5"
                            viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                        </svg>
                        <span>Add New Document Card</span>
                    </button>
                </div>

                <div class="p-6">
                    <div id="documentsContainer" class="space-y-4">
                        <% const docs=data.documents || []; %>
                            <% docs.forEach((doc, idx)=> { %>
                                <div class="border border-slate-200 rounded-2xl p-5 bg-slate-50/40 relative group doc-item"
                                    data-index="<%= idx %>">
                                    <div class="flex flex-col md:flex-row items-start md:items-center gap-4">
                                        <div class="w-16">
                                            <label
                                                class="block text-[10px] font-bold text-slate-500 uppercase mb-1">Icon</label>
                                            <input type="text" name="docIcon_<%= idx %>" value="<%= doc.icon || '📄' %>"
                                                class="w-full text-center text-xl border border-slate-200 rounded-xl py-2 bg-white focus:outline-none focus:border-blue-500">
                                        </div>
                                        <div class="flex-grow grid grid-cols-1 md:grid-cols-2 gap-4 w-full">
                                            <div>
                                                <label
                                                    class="block text-[11px] font-bold text-slate-700 uppercase mb-1">Document
                                                    Title</label>
                                                <input type="text" name="docTitle_<%= idx %>"
                                                    value="<%= doc.title || '' %>"
                                                    class="w-full text-xs border border-slate-200 rounded-lg px-3 py-2 bg-white focus:outline-none focus:border-blue-500 font-bold">
                                            </div>
                                            <div>
                                                <label
                                                    class="block text-[11px] font-bold text-slate-700 uppercase mb-1">Short
                                                    Description</label>
                                                <input type="text" name="docDesc_<%= idx %>"
                                                    value="<%= doc.description || '' %>"
                                                    class="w-full text-xs border border-slate-200 rounded-lg px-3 py-2 bg-white focus:outline-none focus:border-blue-500">
                                            </div>
                                            <div class="md:col-span-2 flex flex-col sm:flex-row sm:items-center gap-3">
                                                <div class="flex-grow">
                                                    <label
                                                        class="block text-[10px] font-bold text-slate-500 uppercase mb-1">Upload
                                                        File (PDF / Doc)</label>
                                                    <input type="file" name="docFile_<%= idx %>"
                                                        class="w-full text-xs text-slate-500 file:mr-3 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-bold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100">
                                                </div>
                                                <div class="sm:w-72">
                                                    <label
                                                        class="block text-[10px] font-bold text-slate-500 uppercase mb-1">Or
                                                        Existing File Link</label>
                                                    <input type="text" name="docUrl_<%= idx %>"
                                                        value="<%= doc.fileUrl || '' %>"
                                                        placeholder="/images/Catalog.pdf"
                                                        class="w-full text-xs border border-slate-200 rounded-lg px-3 py-1.5 bg-white focus:outline-none focus:border-blue-500">
                                                </div>
                                                <% if (doc.fileUrl) { %>
                                                    <div class="pt-4">
                                                        <a href="<%= doc.fileUrl %>" target="_blank"
                                                            class="text-xs text-blue-600 font-bold hover:underline inline-flex items-center gap-1">Download
                                                            ↗</a>
                                                    </div>
                                                    <% } %>
                                            </div>
                                        </div>
                                        <button type="button" onclick="removeDocumentRow(this)"
                                            class="text-rose-500 hover:text-rose-700 hover:bg-rose-50 p-2 rounded-lg transition shrink-0"
                                            title="Remove Document">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2"
                                                viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round"
                                                    d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" />
                                            </svg>
                                        </button>
                                    </div>
                                </div>
                                <% }) %>
                    </div>
                    <input type="hidden" name="docCount" id="docCount" value="<%= docs.length %>">
                </div>
            </div>

            <!-- Sticky Bottom Actions -->
            <div
                class="sticky bottom-6 z-30 bg-white/95 backdrop-blur-md p-4 rounded-2xl border border-slate-200 shadow-xl flex items-center justify-between">
                <span class="text-xs text-slate-500 font-medium">Changes will instantly update the Download Center
                    page.</span>
                <button type="submit"
                    class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-2.5 px-6 rounded-xl shadow-md transition flex items-center gap-2 text-sm">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                    </svg>
                    <span>Save All Changes</span>
                </button>
            </div>

        </form>
    </div>

    <script>
        function addDocumentRow() {
            const container = document.getElementById('documentsContainer');
            const docCountInput = document.getElementById('docCount');
            let count = parseInt(docCountInput.value, 10) || 0;

            const row = document.createElement('div');
            row.className = 'border border-slate-200 rounded-2xl p-5 bg-slate-50/40 relative group doc-item';
            row.setAttribute('data-index', count);
            row.innerHTML = `
        <div class="flex flex-col md:flex-row items-start md:items-center gap-4">
            <div class="w-16">
                <label class="block text-[10px] font-bold text-slate-500 uppercase mb-1">Icon</label>
                <input type="text" name="docIcon_${count}" value="📄" class="w-full text-center text-xl border border-slate-200 rounded-xl py-2 bg-white focus:outline-none focus:border-blue-500">
            </div>
            <div class="flex-grow grid grid-cols-1 md:grid-cols-2 gap-4 w-full">
                <div>
                    <label class="block text-[11px] font-bold text-slate-700 uppercase mb-1">Document Title</label>
                    <input type="text" name="docTitle_${count}" value="New Certificate / Document" class="w-full text-xs border border-slate-200 rounded-lg px-3 py-2 bg-white focus:outline-none focus:border-blue-500 font-bold">
                </div>
                <div>
                    <label class="block text-[11px] font-bold text-slate-700 uppercase mb-1">Short Description</label>
                    <input type="text" name="docDesc_${count}" value="Download official document" class="w-full text-xs border border-slate-200 rounded-lg px-3 py-2 bg-white focus:outline-none focus:border-blue-500">
                </div>
                <div class="md:col-span-2 flex flex-col sm:flex-row sm:items-center gap-3">
                    <div class="flex-grow">
                        <label class="block text-[10px] font-bold text-slate-500 uppercase mb-1">Upload File (PDF / Doc)</label>
                        <input type="file" name="docFile_${count}" class="w-full text-xs text-slate-500 file:mr-3 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-bold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100">
                    </div>
                    <div class="sm:w-72">
                        <label class="block text-[10px] font-bold text-slate-500 uppercase mb-1">Or Existing File Link</label>
                        <input type="text" name="docUrl_${count}" value="" placeholder="/images/Catalog.pdf" class="w-full text-xs border border-slate-200 rounded-lg px-3 py-1.5 bg-white focus:outline-none focus:border-blue-500">
                    </div>
                </div>
            </div>
            <button type="button" onclick="removeDocumentRow(this)" class="text-rose-500 hover:text-rose-700 hover:bg-rose-50 p-2 rounded-lg transition shrink-0" title="Remove Document">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0"/></svg>
            </button>
        </div>
    `;
            container.appendChild(row);
            docCountInput.value = count + 1;
        }

        function removeDocumentRow(button) {
            const item = button.closest('.doc-item');
            if (item) item.remove();
        }
    </script>

    <%- include('partials/admin-footer') %>