<%- include('partials/header') %>
  <!-- Hero Section -->
  <section
    class="relative w-full min-h-[85vh] flex items-center bg-gradient-to-br from-[#f8fafc] via-white to-[#eff6ff] overflow-hidden">
    <!-- Decorative elements -->
    <div
      class="absolute top-0 right-0 -mr-20 -mt-20 w-[600px] h-[600px] rounded-full bg-cyan-100/40 blur-3xl pointer-events-none">
    </div>
    <div
      class="absolute bottom-0 left-0 -ml-20 -mb-20 w-[500px] h-[500px] rounded-full bg-blue-100/40 blur-3xl pointer-events-none">
    </div>

    <div
      class="max-w-7xl mx-auto w-full px-6 md:px-12 grid grid-cols-1 lg:grid-cols-2 gap-12 items-center relative z-10 py-16 lg:py-0">

      <!-- Left Content -->
      <div id="hero-text-container" data-aos="fade-right" data-aos-duration="1000"
        class="flex flex-col space-y-6 md:space-y-8 z-20 transition-opacity duration-300 opacity-100">
        <div>
          <span id="hero-badge"
            class="inline-block py-1 px-3 rounded-full bg-blue-50 text-blue-600 font-bold tracking-widest uppercase text-xs mb-4">
            <%= (typeof pageData !=='undefined' && pageData && pageData.heroBadge) ? pageData.heroBadge
              : 'Welcome to Solanki Pipes' %>
          </span>
          <h1 id="hero-title" class="text-xl md:text-3xl lg:text-4xl font-extrabold text-gray-900 leading-[1.15]">
            <%- (typeof pageData !=='undefined' && pageData && pageData.heroTitle) ? pageData.heroTitle
              : `Trusted Piping Partner for North India's <br class="hidden lg:block" /><span
              class="text-transparent bg-clip-text bg-gradient-to-r from-blue-700 to-cyan-500">Water
              Infrastructure</span>` %>
          </h1>
        </div>
        <p id="hero-description" class="text-lg md:text-xl text-gray-600 max-w-lg leading-relaxed min-h-[80px]">
          <%= (typeof pageData !=='undefined' && pageData && pageData.heroDescription) ? pageData.heroDescription
            : '20+ Years of Manufacturing Excellence. Supplying high-quality PE 80 & PE 100 grades, PN 2.5 to PN 10 for a robust tomorrow.'
            %>
        </p>

        <div class="pt-2">
          <% const heroWhatsapp=(typeof siteSettings !=='undefined' && siteSettings && siteSettings.whatsapp) ?
            siteSettings.whatsapp.replace(/[^0-9]/g, '' ) : '919992177822' ; %>
            <a href="https://wa.me/<%= heroWhatsapp %>" target="_blank" rel="noopener noreferrer"
              aria-label="Contact Us on WhatsApp"
              class="inline-flex items-center justify-center gap-2.5 px-8 py-3.5 sm:py-4 bg-[#25D366] hover:bg-[#20bd5a] text-white text-sm sm:text-base font-semibold rounded-full shadow-lg shadow-green-500/30 hover:shadow-green-500/50 hover:shadow-xl transition-all duration-300 transform hover:-translate-y-0.5 group">
              <svg class="w-5 h-5 fill-current transition-transform duration-300 group-hover:scale-110"
                viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path
                  d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 00-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
              </svg>
              <span>
                <%= (typeof pageData !=='undefined' && pageData && pageData.heroWhatsappText) ?
                  pageData.heroWhatsappText : 'Contact Us' %>
              </span>
            </a>
        </div>
      </div>

      <!-- Right Image (Auto-changing) -->
      <div class="relative flex items-center justify-center h-[450px] sm:h-[550px] lg:h-[550px] w-full"
        data-aos="fade-left" data-aos-duration="1000" data-aos-delay="200">
        <!-- Glow behind image -->
        <div
          class="absolute inset-0 bg-gradient-to-tr from-blue-200 to-cyan-200 rounded-full blur-3xl opacity-30 animate-pulse duration-1000">
        </div>

        <!-- Images -->
        <div class="relative w-full h-full flex items-center justify-center">
          <img id="hero-img-0"
            src="<%= (typeof products !== 'undefined' && products[0]) ? products[0].heroImage : '/images/Hdpe_hero.png' %>"
            class="absolute max-h-[100%] max-w-[100%] object-contain transition-all duration-700 ease-in-out opacity-100 scale-100 z-10 drop-shadow-2xl"
            alt="<%= (typeof products !== 'undefined' && products[0]) ? products[0].name : 'HDPE Pipes' %>">
          <img id="hero-img-1"
            src="<%= (typeof products !== 'undefined' && products[1]) ? products[1].heroImage : '/images/solanki_hdpe_pipes.png' %>"
            class="absolute max-h-[100%] max-w-[100%] object-contain transition-all duration-700 ease-in-out opacity-0 scale-95 z-0 pointer-events-none drop-shadow-2xl"
            alt="<%= (typeof products !== 'undefined' && products[1]) ? products[1].name : 'Sprinkler Pipes' %>">
        </div>

        <!-- Image indicators -->
        <div
          class="absolute -bottom-6 left-1/2 -translate-x-1/2 flex gap-3 z-20 bg-white/50 backdrop-blur-sm py-2 px-4 rounded-full border border-white/60 shadow-sm">
          <button onclick="setHeroImage(0)" id="hero-dot-0"
            class="w-8 h-2.5 rounded-full bg-blue-600 transition-all duration-300 hover:bg-blue-700 focus:outline-none"></button>
          <button onclick="setHeroImage(1)" id="hero-dot-1"
            class="w-2.5 h-2.5 rounded-full bg-gray-300 transition-all duration-300 hover:bg-gray-400 focus:outline-none"></button>
        </div>
      </div>

    </div>
  </section>



  <div class="flex flex-col items-center justify-center mt-10">
    <div class="flex font-bold uppercase tracking-wider text-center">
      <%= (typeof pageData !== 'undefined' && pageData && pageData.exploreTitle) ? pageData.exploreTitle : 'EXPLORE OUR PRODUCT RANGE' %>
    </div>

    <h2 class="text-2xl md:text-3xl lg:text-5xl mb-20 mt-10 text-jacksonsPurple text-center" data-aos="fade-up">
      <%= (typeof pageData !== 'undefined' && pageData && pageData.exploreHeading) ? pageData.exploreHeading : 'What We Produce' %>
    </h2>

    <div class="w-full px-6 md:px-10 relative flex justify-center">
      <div class="flex lg:justify-center overflow-x-auto gap-6 pb-8 snap-x scrollbar-hide scroll-smooth w-full">
        <% if (typeof products !=='undefined' && products.length> 0) { %>
          <% products.forEach((prod, idx)=> { %>
            <div class="flex-none w-64 md:w-72 snap-center group" data-aos="zoom-in"
              data-aos-delay="<%= (idx + 1) * 100 %>">
              <div
                class="flex flex-col items-center border border-jacksonsPurple p-6 rounded-3xl transition-all hover:bg-jacksonsPurple relative">
                <h4 class="text-lg md:text-xl font-semibold mb-4 text-center">
                  <%= prod.name %>
                </h4>
                <div class="mb-6 h-40 w-full flex items-center justify-center overflow-hidden">
                  <img src="<%= prod.mainImage %>" alt="<%= prod.name %>"
                    class="group-hover:hidden h-full w-full object-contain max-h-40">
                  <img src="<%= prod.hoverImage || prod.mainImage %>" alt="<%= prod.name %> Hover"
                    class="hidden group-hover:block h-full w-full object-contain max-h-40">
                </div>
                <a href="<%= prod.link || '/' + prod.slug %>"
                  class="text-xs py-1 px-4 border border-black group-hover:border-white rounded-md transition-colors">more</a>
              </div>
            </div>
            <% }) %>
              <% } else { %>
                <div class="flex-none w-64 md:w-72 snap-center group" data-aos="zoom-in" data-aos-delay="100">
                  <div
                    class="flex flex-col items-center border border-jacksonsPurple p-6 rounded-3xl transition-all hover:bg-jacksonsPurple  relative">
                    <h4 class="text-lg md:text-xl font-semibold mb-4 text-center">HDPE PIPES</h4>
                    <div class="mb-6 h-40 flex items-center justify-center">
                      <img src="/images/product_01.png" alt="HDPE" class="group-hover:hidden max-h-full w-auto">
                      <img src="/images/product_01hover.png" alt="HDPE Hover"
                        class="hidden group-hover:block max-h-full w-auto">
                    </div>
                    <a href="/hdpe"
                      class="text-xs py-1 px-4 border border-black group-hover:border-white rounded-md transition-colors">more</a>
                  </div>
                </div>

                <div class="flex-none w-64 md:w-72 snap-center group" data-aos="zoom-in" data-aos-delay="200">
                  <div
                    class="flex flex-col items-center border border-jacksonsPurple p-6 rounded-3xl transition-all hover:bg-jacksonsPurple relative">
                    <h4 class="text-lg md:text-xl font-semibold mb-4 text-center">SPRINKLER PIPES</h4>
                    <div class="mb-6 h-40 flex items-center justify-center">
                      <img src="/images/lift_irrigation.jpeg" alt="Sprinkler Pipes"
                        class="group-hover:hidden max-h-full w-auto object-contain">
                      <img src="/images/sp_pipesimg.jpeg" alt="Sprinkler Pipes Hover"
                        class="hidden group-hover:block max-h-full w-auto object-contain">
                    </div>
                    <a href="/sprinkler"
                      class="text-xs py-1 px-4 border border-black group-hover:border-white rounded-md transition-colors">more</a>
                  </div>
                </div>
                <% } %>
      </div>
    </div>
  </div>


  <div class="font-sans overflow-x-hidden">
    <div class="flex flex-col items-center justify-center mt-10 px-4 sm:px-10 lg:px-20">
      <div class="text-center mb-10" data-aos="fade-up">
        <span class="text-blue-900 font-bold tracking-widest uppercase">
          <%= (typeof pageData !== 'undefined' && pageData && pageData.impactSubtitle) ? pageData.impactSubtitle : 'OUR IMPACT' %>
        </span>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl mt-4">
          <%= (typeof pageData !== 'undefined' && pageData && pageData.impactTitle) ? pageData.impactTitle : 'Projects & Events' %>
        </h2>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 w-full max-w-7xl mb-24">

        <!-- LEFT BIG CARD -->
        <% const bigProj=(typeof projects !=='undefined' && projects && projects.length> 0) ? projects[0] : null;
          const bigProjImg = bigProj ? (bigProj.image || '/images/project_1.jpg') : '/images/project_1.jpg';
          const bigProjTitle = bigProj ? (bigProj.title || 'Mega Food Park, Ludhiana') : 'Mega Food Park, Ludhiana';
          const bigProjDesc = bigProj ? (bigProj.shortDescription || 'Successful HDPE Pipeline Execution for STP Project – Mega Food Park, Ludhiana') : 'Successful HDPE Pipeline Execution for STP Project – Mega Food Park, Ludhiana';
          const bigProjLink = bigProj ? `/projects/${bigProj._id || bigProj.id}` : '/projects';
          %>
          <div class="lg:col-span-2 relative group overflow-hidden rounded-2xl" data-aos="fade-right">
            <a href="<%= bigProjLink %>" class="block h-full">
              <div class="overflow-hidden rounded-2xl h-[360px] sm:h-[440px] lg:h-[480px]">
                <img src="<%= bigProjImg %>" alt="<%= bigProjTitle %>"
                  class="object-cover w-full h-full transition-transform duration-500 group-hover:scale-105">
              </div>

              <div class="flex flex-col items-start pt-4 sm:pt-5">
                <span class="text-black text-xs font-bold py-1 px-3 bg-cyan-400 rounded-md mb-2">
                  Project
                </span>

                <div class="text-gray-900 text-xl sm:text-2xl font-bold leading-tight">
                  <p class="hover:text-blue-700 transition-colors">
                    <%= bigProjTitle %>
                  </p>

                  <p class="text-sm sm:text-base font-normal mt-2 text-gray-600 leading-relaxed">
                    <%= bigProjDesc %>
                  </p>
                </div>
              </div>
            </a>
          </div>

          <!-- RIGHT SIDE (Events & Sponsorships) -->
          <div class="flex flex-col gap-6">

            <!-- TOP CARD (Event 1) -->
            <% 
              const ev1Link = (typeof pageData !== 'undefined' && pageData && pageData.event1Link) ? pageData.event1Link : '/farmers-fair';
              const ev1Img = (typeof pageData !== 'undefined' && pageData && pageData.event1Image) ? pageData.event1Image : '/images/IMG_0524.jpg.jpeg';
              const ev1Badge = (typeof pageData !== 'undefined' && pageData && pageData.event1Badge) ? pageData.event1Badge : 'Event';
              const ev1Title = (typeof pageData !== 'undefined' && pageData && pageData.event1Title) ? pageData.event1Title : 'Sponsorship of Farmers’ Fair & Agricultural Exhibition – Haryana';
            %>
            <a href="<%= ev1Link %>" class="flex flex-col group" data-aos="fade-left" data-aos-delay="100">
              <div class="overflow-hidden rounded-xl h-60 relative">
                <img src="<%= ev1Img %>" alt="<%= ev1Title %>"
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105">

                <div class="absolute inset-0 bg-black/10"></div>
              </div>

              <span
                class="text-white text-[10px] uppercase tracking-wider py-1 px-3 bg-emerald-700 rounded-md w-fit mt-4 mb-2 font-bold">
                <%= ev1Badge %>
              </span>

              <p class="text-gray-900 font-bold text-sm leading-snug">
                <%= ev1Title %>
              </p>
            </a>

            <!-- BOTTOM CARD (Event 2) -->
            <% 
              const ev2Link = (typeof pageData !== 'undefined' && pageData && pageData.event2Link) ? pageData.event2Link : '';
              const ev2Img = (typeof pageData !== 'undefined' && pageData && pageData.event2Image) ? pageData.event2Image : '/images/kabadi.jpeg';
              const ev2Badge = (typeof pageData !== 'undefined' && pageData && pageData.event2Badge) ? pageData.event2Badge : 'Community & Sponsorships';
              const ev2Title = (typeof pageData !== 'undefined' && pageData && pageData.event2Title) ? pageData.event2Title : 'Solanki Pipes Proudly Sponsors JKL (Just Kabaddi League)';
            %>
            <<%= ev2Link ? 'a href="' + ev2Link + '"' : 'div' %> class="flex flex-col <%= ev2Link ? 'group cursor-pointer' : '' %>" data-aos="fade-left" data-aos-delay="200">
              <div class="overflow-hidden rounded-xl h-60 relative">
                <img src="<%= ev2Img %>" alt="<%= ev2Title %>" class="w-full h-full object-cover <%= ev2Link ? 'transition-transform duration-500 group-hover:scale-105' : '' %>">
                <div class="absolute inset-0 bg-black/10"></div>
              </div>

              <span
                class="text-white text-[10px] uppercase tracking-wider py-1 px-3 bg-blue-800 rounded-md w-fit mt-4 mb-2">
                <%= ev2Badge %>
              </span>

              <p class="text-blue-900 font-medium text-sm leading-snug">
                <%= ev2Title %>
              </p>
            </<%= ev2Link ? 'a' : 'div' %>>

          </div>
      </div>
    </div>


    <!-- DHBVN EMPANELMENT ANNOUNCEMENT SECTION -->
    <section id="dhbvn-announcement"
      class="relative w-full py-12 md:py-16 px-4 sm:px-8 lg:px-16 bg-gradient-to-br from-[#f8faff] via-white to-[#eff6ff] overflow-hidden mb-16">
      <!-- Subtle ambient decorative glow -->
      <div class="absolute -top-32 -left-32 w-96 h-96 bg-blue-100/30 rounded-full blur-3xl pointer-events-none"></div>
      <div
        class="absolute -bottom-32 -right-32 w-[500px] h-[500px] bg-sky-100/40 rounded-full blur-3xl pointer-events-none">
      </div>

      <div class="max-w-7xl mx-auto relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">

          <!-- LEFT COLUMN: Visually stunning certificate frame + zoom -->
          <div class="lg:col-span-5 flex flex-col items-center justify-center z-20" data-aos="zoom-in-right">
            <div
              class="w-full max-w-[440px] bg-white p-4 sm:p-5 md:p-6 rounded-2xl md:rounded-3xl border border-sky-200/90 shadow-sm relative group overflow-hidden">
              <!-- Main certificate image -->
              <% const certImg=(typeof pageData !=='undefined' && pageData && pageData.dhbvnCertificate) ?
                pageData.dhbvnCertificate : ((typeof siteSettings !=='undefined' && siteSettings &&
                siteSettings.dhbvnEmpanelment) ? siteSettings.dhbvnEmpanelment : '/images/dhbvn_empanelment.jpg' ); %>
                <img src="<%= certImg %>" alt="Solanki Industries Empanelled with DHBVN"
                  class="w-full h-auto object-contain rounded-xl transition-transform duration-500 group-hover:scale-[1.01] cursor-pointer"
                  onclick="openZoomModal()">
            </div>
          </div>

          <!-- RIGHT COLUMN: Text & dynamic accordions -->
          <div class="lg:col-span-7 flex flex-col justify-center space-y-6 z-10" data-aos="fade-up">

            <div class="space-y-3">
              <h2 class="text-3xl sm:text-4xl lg:text-[42px] font-normal text-gray-900 leading-tight tracking-tight">
                <%- (typeof pageData !=='undefined' && pageData && pageData.dhbvnHeading) ? pageData.dhbvnHeading
                  : 'Empanelled with <span class="font-bold text-[#0f3d89]">DHBVN</span>' %>
              </h2>

              <h3 class="text-base sm:text-lg lg:text-xl font-medium text-[#1e40af] tracking-normal leading-snug">
                <%= (typeof pageData !=='undefined' && pageData && pageData.dhbvnSubheading) ? pageData.dhbvnSubheading
                  : 'Strengthening Haryana’s Power Infrastructure with Quality HDPE Pipes' %>
              </h3>

              <div class="space-y-3 text-xs sm:text-[13.5px] lg:text-[14px] text-gray-600 leading-relaxed pt-1">
                <% let para1=(typeof pageData !=='undefined' && pageData && pageData.dhbvnParagraph1) ?
                  pageData.dhbvnParagraph1
                  : 'Solanki Industries (Solanki Pipes) is proud to announce its empanelment with <strong>Dakshin Haryana Bijli Vitran Nigam Limited (DHBVN)</strong> under the category of HDPE Pipes. This achievement reflects our commitment to manufacturing high-quality, ISI-marked HDPE piping solutions that meet the stringent requirements of government infrastructure and utility projects.'
                  ; if (!para1.includes('<strong>') && para1.includes('Dakshin Haryana Bijli Vitran Nigam Limited (DHBVN)')) {
                  para1 = para1.replace('Dakshin Haryana Bijli Vitran Nigam Limited (DHBVN)', '<strong>Dakshin Haryana Bijli Vitran Nigam Limited (DHBVN)</strong>');
                  }
                  %>
                  <p><%- para1 %></p>

                  <p>
                    <%= (typeof pageData !=='undefined' && pageData && pageData.dhbvnParagraph2) ?
                      pageData.dhbvnParagraph2
                      : 'The empanelment enables Solanki Industries to participate in DHBVN-related turnkey and deposit works, supporting the development of reliable underground electrical infrastructure across Haryana.'
                      %>
                  </p>
              </div>
            </div>

            <!-- ACCORDIONS CONTAINER -->
            <div class="space-y-3 pt-1" id="dhbvn-accordions">
              <% const defaultAccs=[ { title: "What is DHBVN?" ,
                content: "DHBVN is a state-owned electricity distribution utility engaged in power distribution, electrification, underground cabling, and power infrastructure development projects across Haryana."
                }, { title: "Why HDPE Pipes are Essential for Electrical Infrastructure" ,
                content: "HDPE (High-Density Polyethylene) pipes have become the preferred choice for underground cable protection due to their exceptional properties: high mechanical strength to withstand external soil loads, corrosion resistance, internal smoothness for cable protection, and long service life exceeding 50 years."
                }, { title: "Solanki Industries: Trusted HDPE Pipe Manufacturer" ,
                content: "With over two decades of manufacturing expertise, Solanki Industries has established itself as a trusted and premium brand name in the HDPE pipe segment with ISI marked pipes (IS 4984), BIS licensed manufacturing facility, advanced automated production lines, and in-house quality testing laboratory."
                }, { title: "Supporting Growth, Quality & Compliance" ,
                content: "The DHBVN empanelment reinforces Solanki Industries’ growing contribution to government infrastructure development, supporting DHBVN contractors, turnkey agencies, EPC companies, and government departments with quality-driven products."
                } ]; const liveAccs=(typeof pageData !=='undefined' && pageData && pageData.dhbvnAccordions &&
                pageData.dhbvnAccordions.length> 0) ? pageData.dhbvnAccordions : defaultAccs;
                %>
                <% liveAccs.forEach((acc, aIdx)=> { %>
                  <div
                    class="bg-white rounded-xl sm:rounded-2xl border border-blue-200/90 shadow-sm overflow-hidden transition-all duration-300 hover:border-blue-300 hover:shadow">
                    <button type="button" onclick="toggleAccordion('acc-<%= aIdx %>')"
                      class="w-full flex items-center justify-between p-3.5 sm:px-5 sm:py-3.5 text-left focus:outline-none transition-colors duration-200 group">
                      <div class="flex items-center gap-3.5 sm:gap-4 pr-3">
                        <span
                          class="w-8 h-8 rounded-lg bg-blue-50/90 text-blue-600 font-bold text-xs sm:text-[13px] flex items-center justify-center flex-shrink-0 tracking-wide">
                          0<%= aIdx + 1 %>
                        </span>
                        <span
                          class="font-semibold text-gray-800 text-xs sm:text-[14.5px] leading-snug group-hover:text-blue-900 transition-colors">
                          <%= acc.title %>
                        </span>
                      </div>
                      <svg id="icon-acc-<%= aIdx %>"
                        class="w-4 h-4 text-blue-400 transition-transform duration-300 flex-shrink-0" fill="none"
                        stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                      </svg>
                    </button>
                    <div id="content-acc-<%= aIdx %>"
                      class="max-h-0 overflow-hidden transition-all duration-300 ease-in-out">
                      <div
                        class="px-5 pb-4 pt-1 border-t border-gray-100 text-xs sm:text-sm text-gray-600 leading-relaxed">
                        <p>
                          <%= acc.content %>
                        </p>
                      </div>
                    </div>
                  </div>
                  <% }) %>
            </div>

          </div>
        </div>
      </div>
    </section>

    <!-- FULL SCREEN ZOOM MODAL FOR CERTIFICATE -->
    <div id="zoom-modal"
      class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/90 p-4 transition-all duration-300 backdrop-blur-sm"
      onclick="closeZoomModal()">
      <!-- Close Button -->
      <button
        class="absolute top-6 right-6 text-white/70 hover:text-white transition-colors duration-200 focus:outline-none"
        onclick="closeZoomModal()">
        <svg class="w-9 h-9" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>

      <!-- Image Container -->
      <div
        class="max-w-4xl max-h-[85vh] w-full flex items-center justify-center relative scale-95 transition-transform duration-300 ease-out"
        id="zoom-modal-content" onclick="event.stopPropagation()">
        <% const zoomCertImg=(typeof pageData !=='undefined' && pageData && pageData.dhbvnCertificate) ?
          pageData.dhbvnCertificate : ((typeof siteSettings !=='undefined' && siteSettings &&
          siteSettings.dhbvnEmpanelment) ? siteSettings.dhbvnEmpanelment : '/images/dhbvn_empanelment.jpg' ); %>
