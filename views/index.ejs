<%
      /* Pre-compute hero slide data server-side to avoid regex/quote issues in JS strings */
      function escapeJs(str) {
        if (!str) return '';
        return String(str).replace(/\\/g, '\\\\').replace(/"/g, '\\"').replace(/'/g, "\\'").replace(/\n/g, '\\n').replace(/\r/g, '\\r');
      }

      var heroSlide0Badge = (typeof pageData !== 'undefined' && pageData && pageData.heroBadge)
        ? pageData.heroBadge
        : ((typeof products !== 'undefined' && products && products[0] && products[0].badge) ? products[0].badge : 'Welcome to Solanki Pipes');

      var heroSlide0Title = (typeof pageData !== 'undefined' && pageData && pageData.heroTitle)
        ? pageData.heroTitle
        : ((typeof products !== 'undefined' && products && products[0] && products[0].headline) ? products[0].headline : "Trusted Piping Partner for North India's Water Infrastructure");

      var heroSlide0Desc = (typeof pageData !== 'undefined' && pageData && pageData.heroDescription)
        ? pageData.heroDescription
        : ((typeof products !== 'undefined' && products && products[0] && (products[0].heroSubtitle || products[0].shortDescription)) ? (products[0].heroSubtitle || products[0].shortDescription) : '20+ Years of Manufacturing Excellence. Supplying high-quality PE 80 & PE 100 grades, PN 2.5 to PN 10 for a robust tomorrow.');

      var heroSlide1Badge = (typeof pageData !== 'undefined' && pageData && pageData.heroSlide2Badge)
        ? pageData.heroSlide2Badge
        : ((typeof products !== 'undefined' && products && products[1] && products[1].badge) ? products[1].badge : 'Agricultural Innovation');

      var heroSlide1Title = (typeof pageData !== 'undefined' && pageData && pageData.heroSlide2Title)
        ? pageData.heroSlide2Title
        : ((typeof products !== 'undefined' && products && products[1] && products[1].headline) ? products[1].headline : 'Quick-Coupler Sprinkler Pipes for Efficient Micro-Irrigation');

      var heroSlide1Desc = (typeof pageData !== 'undefined' && pageData && pageData.heroSlide2Description)
        ? pageData.heroSlide2Description
        : ((typeof products !== 'undefined' && products && products[1] && (products[1].heroSubtitle || products[1].shortDescription)) ? (products[1].heroSubtitle || products[1].shortDescription) : 'IS 14151 certified sprinkler piping systems with quick-locking couplers, delivering up to 50% water savings and higher crop yields.');
    %>
    <script>
      let currentHeroImage = 0;
      const totalHeroImages = 2;
      let heroInterval;

      const heroData = [
        {
          badge: "<%- escapeJs(heroSlide0Badge) %>",
          title: "<%- escapeJs(heroSlide0Title) %>",
          description: "<%- escapeJs(heroSlide0Desc) %>"
        },
        {
          badge: "<%- escapeJs(heroSlide1Badge) %>",
          title: "<%- escapeJs(heroSlide1Title) %>",
          description: "<%- escapeJs(heroSlide1Desc) %>"
        }
      ];

      function updateHeroImage() {
        const textContainer = document.getElementById('hero-text-container');
        if (textContainer) {
          textContainer.classList.remove('opacity-100');
          textContainer.classList.add('opacity-0');

          setTimeout(() => {
            const badgeEl = document.getElementById('hero-badge');
            const titleEl = document.getElementById('hero-title');
            const descEl = document.getElementById('hero-description');

            if (badgeEl) badgeEl.innerHTML = heroData[currentHeroImage].badge;
            if (titleEl) titleEl.innerHTML = heroData[currentHeroImage].title;
            if (descEl) descEl.innerHTML = heroData[currentHeroImage].description;

            textContainer.classList.remove('opacity-0');
            textContainer.classList.add('opacity-100');
          }, 300);
        }

        for (let i = 0; i < totalHeroImages; i++) {
          const img = document.getElementById(`hero-img-${i}`);
          const dot = document.getElementById(`hero-dot-${i}`);
          if (!img || !dot) continue;

          if (i === currentHeroImage) {
            img.classList.remove('opacity-0', 'scale-95', 'z-0', 'pointer-events-none');
            img.classList.add('opacity-100', 'scale-100', 'z-10');
            dot.classList.remove('bg-gray-300', 'w-2.5');
            dot.classList.add('bg-blue-600', 'w-8');
          } else {
            img.classList.remove('opacity-100', 'scale-100', 'z-10');
            img.classList.add('opacity-0', 'scale-95', 'z-0', 'pointer-events-none');
            dot.classList.remove('bg-blue-600', 'w-8');
            dot.classList.add('bg-gray-300', 'w-2.5');
          }
        }
      }

      function nextHeroImage() {
        currentHeroImage = (currentHeroImage + 1) % totalHeroImages;
        updateHeroImage();
      }

      function setHeroImage(index) {
        currentHeroImage = index;
        updateHeroImage();
        resetHeroInterval();
      }

      function resetHeroInterval() {
        clearInterval(heroInterval);
        heroInterval = setInterval(nextHeroImage, 3500); // Change image every 3.5 seconds
      }

      // Start interval on load
      window.addEventListener('DOMContentLoaded', () => {
        resetHeroInterval();
      });
    </script>