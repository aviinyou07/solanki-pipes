<%- include('partials/admin-header') %>

<div class="flex-grow p-6 md:p-10 max-w-7xl w-full mx-auto">
    
    <!-- Dashboard Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
        <div>
            <h1 class="text-3xl font-extrabold text-gray-900 uppercase tracking-tight">Manage <span class="text-blue-600">Products</span></h1>
            <p class="text-gray-500 text-sm mt-1">Manage product catalog details and update product images displayed across the entire application.</p>
        </div>
        <div>
            <a href="/admin/products/add" class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-2.5 px-5 rounded-lg shadow-md transition flex items-center gap-2 text-sm">
                <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"></path>
                </svg>
                <span>Add New Product</span>
            </a>
        </div>
    </div>

    <!-- Products Table / List -->
    <div class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden mb-12">
        <div class="p-6 border-b border-gray-200">
            <h2 class="text-xl font-bold text-gray-800">Product Catalog</h2>
        </div>
        
        <% if (products && products.length > 0) { %>
            <!-- Desktop Table view -->
            <div class="hidden md:block overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-gray-50 text-xs font-bold uppercase tracking-wider text-gray-500 border-b border-gray-200">
                            <th class="p-4 pl-6">Product Images</th>
                            <th class="p-4">Name & Highlights</th>
                            <th class="p-4">Slug / Route</th>
                            <th class="p-4">Media Features</th>
                            <th class="p-4">Badge</th>
                            <th class="p-4 pr-6 text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100 text-sm text-gray-700">
                        <% products.forEach(product => { %>
                            <tr class="hover:bg-gray-50/50 transition-colors">
                                <td class="p-4 pl-6">
                                    <div class="flex items-center gap-3">
                                        <div class="text-center">
                                            <img src="<%= product.mainImage %>" alt="<%= product.name %> Main" class="w-12 h-12 object-contain bg-slate-50 rounded border border-gray-200 p-1">
                                            <span class="text-[10px] text-gray-400 font-bold block mt-0.5">Card</span>
                                        </div>
                                        <div class="text-center">
                                            <img src="<%= product.heroImage %>" alt="<%= product.name %> Hero" class="w-12 h-12 object-contain bg-slate-50 rounded border border-gray-200 p-1">
                                            <span class="text-[10px] text-gray-400 font-bold block mt-0.5">Hero</span>
                                        </div>
                                        <div class="text-center">
                                            <img src="<%= product.detailImage %>" alt="<%= product.name %> Detail" class="w-12 h-12 object-contain bg-slate-50 rounded border border-gray-200 p-1">
                                            <span class="text-[10px] text-gray-400 font-bold block mt-0.5">Detail</span>
                                        </div>
                                    </div>
                                </td>
                                <td class="p-4">
                                    <span class="font-extrabold text-gray-900 block text-base"><%= product.name %></span>
                                    <span class="text-xs text-blue-800 font-semibold block"><%= product.standards || 'BIS Standard' %></span>
                                    <span class="text-xs text-gray-500 line-clamp-1 max-w-sm"><%= product.shortDescription || 'No description' %></span>
                                </td>
                                <td class="p-4">
                                    <span class="bg-slate-100 text-slate-700 text-xs font-mono font-bold px-2.5 py-1 rounded-md border border-slate-200"><%= product.link || '/' + product.slug %></span>
                                </td>
                                <td class="p-4">
                                    <div class="flex flex-col gap-1">
                                        <% if (product.videoUrl || product.videoFile) { %>
                                            <span class="inline-flex items-center gap-1 text-[10px] font-bold text-blue-700 bg-blue-50 px-2 py-0.5 rounded border border-blue-200 w-fit">
                                                <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path d="M4 4a2 2 0 00-2 2v8a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2H4zm8 6l-5 3V7l5 3z"/></svg>
                                                Video Active
                                            </span>
                                        <% } %>
                                        <% if (product.animationUrl || product.animationFile) { %>
                                            <span class="inline-flex items-center gap-1 text-[10px] font-bold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200 w-fit">
                                                <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M11.3 1.046A1 1 0 0112 2v5h4a1 1 0 01.82 1.573l-7 10A1 1 0 018 18v-5H4a1 1 0 01-.82-1.573l7-10a1 1 0 011.12-.38z" clip-rule="evenodd"/></svg>
                                                Animation Active
                                            </span>
                                        <% } %>
                                        <% if (!product.videoUrl && !product.videoFile && !product.animationUrl && !product.animationFile) { %>
                                            <span class="text-xs text-gray-400">Default Simulation</span>
                                        <% } %>
                                    </div>
                                </td>
                                <td class="p-4">
                                    <% if (product.badge) { %>
                                        <span class="bg-blue-100 text-blue-800 text-xs font-bold px-2.5 py-1 rounded-full uppercase tracking-wider"><%= product.badge %></span>
                                    <% } else { %>
                                        <span class="text-gray-400 text-xs">—</span>
                                    <% } %>
                                </td>
                                <td class="p-4 pr-6 text-right">
                                    <div class="flex items-center justify-end gap-3">
                                        <a href="<%= product.link || '/' + product.slug %>" target="_blank" class="text-blue-600 hover:text-blue-800 font-semibold text-xs">View Page</a>
                                        <a href="/admin/products/edit/<%= product._id %>" class="text-amber-600 hover:text-amber-800 font-semibold text-xs border border-amber-200 hover:border-amber-300 rounded px-2.5 py-1 transition-colors">Edit</a>
                                        <form action="/admin/products/delete/<%= product._id %>" method="POST" onsubmit="return confirm('Are you sure you want to delete this product?');" class="inline">
                                            <button type="submit" class="text-rose-600 hover:text-rose-800 font-semibold text-xs border border-rose-200 hover:border-rose-300 rounded px-2.5 py-1 transition-colors">Delete</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>

            <!-- Mobile/Tablet Grid view -->
            <div class="md:hidden p-4 space-y-4 bg-slate-50/30">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <% products.forEach(product => { %>
                        <div class="bg-white rounded-xl border border-gray-200 p-4 shadow-sm space-y-3 hover:border-blue-200 transition-colors">
                            <div class="flex items-center gap-3">
                                <img src="<%= product.mainImage %>" alt="<%= product.name %>" class="w-16 h-16 object-contain bg-slate-50 p-1 rounded-lg border border-gray-100 shrink-0">
                                <div class="min-w-0">
                                    <h3 class="font-bold text-gray-900 text-sm truncate"><%= product.name %></h3>
                                    <span class="text-xs font-mono text-gray-500 block truncate"><%= product.link || '/' + product.slug %></span>
                                    <% if (product.badge) { %>
                                        <span class="bg-blue-50 text-blue-800 text-[10px] font-bold px-2 py-0.5 rounded-md inline-block mt-1"><%= product.badge %></span>
                                    <% } %>
                                </div>
                            </div>
                            <div class="flex items-center justify-between pt-2 border-t border-gray-100">
                                <a href="<%= product.link || '/' + product.slug %>" target="_blank" class="text-blue-600 hover:text-blue-800 font-bold text-xs inline-flex items-center gap-0.5">
                                    <span>View Page</span>
                                    <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"></path>
                                    </svg>
                                </a>
                                <div class="flex items-center gap-2">
                                    <a href="/admin/products/edit/<%= product._id %>" class="text-amber-600 hover:text-amber-800 font-bold text-xs border border-amber-200 hover:border-amber-300 rounded-lg px-3 py-1.5 transition-colors bg-amber-50/30">Edit</a>
                                    <form action="/admin/products/delete/<%= product._id %>" method="POST" onsubmit="return confirm('Are you sure you want to delete this product?');" class="inline">
                                        <button type="submit" class="text-rose-600 hover:text-rose-800 font-bold text-xs border border-rose-200 hover:border-rose-300 rounded-lg px-3 py-1.5 transition-colors bg-rose-50/30">Delete</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                </div>
            </div>
        <% } else { %>
            <div class="p-12 text-center">
                <div class="w-16 h-16 bg-blue-50 text-blue-600 rounded-full flex items-center justify-center mx-auto mb-4">
                    <svg class="w-8 h-8" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
                    </svg>
                </div>
                <h3 class="text-lg font-bold text-gray-800 mb-1">No products found</h3>
                <p class="text-gray-500 text-sm mb-6">Get started by creating your first product item.</p>
                <a href="/admin/products/add" class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded-lg text-sm inline-flex items-center gap-2">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"></path>
                    </svg>
                    <span>Add New Product</span>
                </a>
            </div>
        <% } %>
    </div>
</div>

<%- include('partials/admin-footer') %>
