<%- include('partials/admin-header') %>

<div class="p-6">

    <!-- Page Header -->
    <div class="flex items-center justify-between mb-8">
        <div>
            <h1 class="text-3xl font-extrabold text-gray-900 uppercase tracking-tight">Site <span class="text-blue-600">Media & Settings</span></h1>
            <p class="text-gray-500 text-sm mt-1">Manage global logos, certificates, lab banners, and downloadable assets across the website.</p>
        </div>
    </div>

    <!-- Settings Form -->
    <form action="/admin/settings" method="POST" enctype="multipart/form-data" class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden mb-12">
        <div class="p-6 md:p-8 space-y-8">

            <!-- Section 1: Brand Logos -->
            <div>
                <h3 class="text-lg font-bold text-gray-800 mb-4 pb-2 border-b border-gray-100 flex items-center gap-2">
                    <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                    <span>Branding & Navigation Logos</span>
                </h3>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <!-- Header Logo -->
                    <div class="bg-slate-50 p-5 rounded-xl border border-slate-200">
                        <label class="block text-xs font-bold text-gray-800 uppercase mb-1">Header Navbar Logo</label>
                        <p class="text-[11px] text-gray-500 mb-3">Logo displayed in top header navigation and browser favicon.</p>
                        <div class="mb-3 flex items-center gap-3 bg-white p-2 rounded-lg border border-gray-200">
                            <img id="preview-headerLogo" src="<%= settings.headerLogo %>" alt="Header Logo" class="h-10 w-auto object-contain">
                            <span class="text-xs text-gray-500 truncate font-mono"><%= settings.headerLogo %></span>
                        </div>
                        <input type="file" name="headerLogo" accept="image/*" onchange="previewImage(this, 'preview-headerLogo')" class="w-full text-xs text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-blue-600 file:text-white hover:file:bg-blue-700 cursor-pointer">
                    </div>

                    <!-- Footer Logo -->
                    <div class="bg-slate-50 p-5 rounded-xl border border-slate-200">
                        <label class="block text-xs font-bold text-gray-800 uppercase mb-1">Footer White Logo</label>
                        <p class="text-[11px] text-gray-500 mb-3">Logo displayed in footer bottom banner.</p>
                        <div class="mb-3 flex items-center gap-3 bg-slate-900 p-2 rounded-lg border border-gray-800">
                            <img id="preview-footerLogo" src="<%= settings.footerLogo %>" alt="Footer Logo" class="h-10 w-auto object-contain">
                            <span class="text-xs text-gray-300 truncate font-mono"><%= settings.footerLogo %></span>
                        </div>
                        <input type="file" name="footerLogo" accept="image/*" onchange="previewImage(this, 'preview-footerLogo')" class="w-full text-xs text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-blue-600 file:text-white hover:file:bg-blue-700 cursor-pointer">
                    </div>
                </div>
            </div>

            <!-- Section 2: Certifications & Lab Banners -->
            <div>
                <h3 class="text-lg font-bold text-gray-800 mb-4 pb-2 border-b border-gray-100 flex items-center gap-2">
                    <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138z"></path></svg>
                    <span>Homepage & Quality Section Banners</span>
                </h3>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <!-- DHBVN Empanelment -->
                    <div class="bg-slate-50 p-5 rounded-xl border border-slate-200">
                        <label class="block text-xs font-bold text-gray-800 uppercase mb-1">DHBVN Empanelment Certificate Image</label>
                        <p class="text-[11px] text-gray-500 mb-3">Displayed in DHBVN Empanelment announcement on Home page.</p>
                        <div class="mb-3 flex items-center gap-3 bg-white p-2 rounded-lg border border-gray-200">
                            <img id="preview-dhbvnEmpanelment" src="<%= settings.dhbvnEmpanelment %>" alt="DHBVN Certificate" class="h-16 w-auto object-contain">
                            <span class="text-xs text-gray-500 truncate font-mono"><%= settings.dhbvnEmpanelment %></span>
                        </div>
                        <input type="file" name="dhbvnEmpanelment" accept="image/*" onchange="previewImage(this, 'preview-dhbvnEmpanelment')" class="w-full text-xs text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-blue-600 file:text-white hover:file:bg-blue-700 cursor-pointer">
                    </div>

                    <!-- Quality Banner -->
                    <div class="bg-slate-50 p-5 rounded-xl border border-slate-200">
                        <label class="block text-xs font-bold text-gray-800 uppercase mb-1">Quality Page Testing Lab Banner</label>
                        <p class="text-[11px] text-gray-500 mb-3">Displayed at top of Quality Assurance page (`/quality`).</p>
                        <div class="mb-3 flex items-center gap-3 bg-white p-2 rounded-lg border border-gray-200">
                            <img id="preview-qualityBanner" src="<%= settings.qualityBanner %>" alt="Quality Lab Banner" class="h-16 w-auto object-contain">
                            <span class="text-xs text-gray-500 truncate font-mono"><%= settings.qualityBanner %></span>
                        </div>
                        <input type="file" name="qualityBanner" accept="image/*" onchange="previewImage(this, 'preview-qualityBanner')" class="w-full text-xs text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-blue-600 file:text-white hover:file:bg-blue-700 cursor-pointer">
                    </div>

                    <!-- CIPET Logo -->
                    <div class="bg-slate-50 p-5 rounded-xl border border-slate-200">
                        <label class="block text-xs font-bold text-gray-800 uppercase mb-1">CIPET Lab Partner Logo</label>
                        <p class="text-[11px] text-gray-500 mb-3">CIPET logo on Quality page & Project Inspection details.</p>
                        <div class="mb-3 flex items-center gap-3 bg-white p-2 rounded-lg border border-gray-200">
                            <img id="preview-cipetLogo" src="<%= settings.cipetLogo %>" alt="CIPET Logo" class="h-12 w-auto object-contain">
                            <span class="text-xs text-gray-500 truncate font-mono"><%= settings.cipetLogo %></span>
                        </div>
                        <input type="file" name="cipetLogo" accept="image/*" onchange="previewImage(this, 'preview-cipetLogo')" class="w-full text-xs text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-blue-600 file:text-white hover:file:bg-blue-700 cursor-pointer">
                    </div>

                    <!-- Shri Ram Lab Logo -->
                    <div class="bg-slate-50 p-5 rounded-xl border border-slate-200">
                        <label class="block text-xs font-bold text-gray-800 uppercase mb-1">Shri Ram Lab Partner Logo</label>
                        <p class="text-[11px] text-gray-500 mb-3">Shri Ram Lab logo on Quality page & Project Inspection details.</p>
                        <div class="mb-3 flex items-center gap-3 bg-white p-2 rounded-lg border border-gray-200">
                            <img id="preview-shriramlabLogo" src="<%= settings.shriramlabLogo %>" alt="Shri Ram Lab Logo" class="h-12 w-auto object-contain">
                            <span class="text-xs text-gray-500 truncate font-mono"><%= settings.shriramlabLogo %></span>
                        </div>
                        <input type="file" name="shriramlabLogo" accept="image/*" onchange="previewImage(this, 'preview-shriramlabLogo')" class="w-full text-xs text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-blue-600 file:text-white hover:file:bg-blue-700 cursor-pointer">
                    </div>
                </div>
            </div>

            <!-- Section 3: Promotional & Download Assets -->
            <div>
                <h3 class="text-lg font-bold text-gray-800 mb-4 pb-2 border-b border-gray-100 flex items-center gap-2">
                    <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                    <span>Catalog PDF & Promotional Assets</span>
                </h3>

                    <!-- Product Collection Banner -->
                    <div class="bg-slate-50 p-5 rounded-xl border border-slate-200">
                        <label class="block text-xs font-bold text-gray-800 uppercase mb-1">Home Feature Pipe Banner Image (Strong Pipes Section)</label>
                        <p class="text-[11px] text-gray-500 mb-3">Displayed next to "Strong Pipes For a Stronger Future" & Catalog Download on Home page.</p>
                        <div class="mb-3 flex items-center gap-3 bg-white p-2 rounded-lg border border-gray-200">
                            <img id="preview-collectionBanner" src="<%= settings.collectionBanner %>" alt="Collection Banner" class="h-16 w-auto max-w-[120px] object-contain rounded border border-gray-100">
                            <div class="overflow-hidden">
                                <span class="text-xs text-gray-600 block truncate font-mono"><%= settings.collectionBanner %></span>
                                <span class="text-[10px] text-blue-600 font-semibold">Current Image</span>
                            </div>
                        </div>
                        <input type="file" name="collectionBanner" accept="image/*" onchange="previewImage(this, 'preview-collectionBanner')" class="w-full text-xs text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-blue-600 file:text-white hover:file:bg-blue-700 cursor-pointer">
                    </div>

                    <!-- Catalog PDF -->
                    <div class="bg-slate-50 p-5 rounded-xl border border-slate-200">
                        <label class="block text-xs font-bold text-gray-800 uppercase mb-1">Downloadable Product Catalog PDF</label>
                        <p class="text-[11px] text-gray-500 mb-3">PDF file downloaded when users click "Download Catalogue".</p>
                        <div class="mb-3 flex items-center gap-3 bg-white p-2 rounded-lg border border-gray-200">
                            <svg class="w-8 h-8 text-rose-600 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4z"></path></svg>
                            <span class="text-xs text-gray-700 truncate font-mono"><%= settings.catalogPdf %></span>
                        </div>
                        <input type="file" name="catalogPdf" accept="application/pdf,image/*" class="w-full text-xs text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-blue-600 file:text-white hover:file:bg-blue-700 cursor-pointer">
                    </div>
                </div>
            </div>

            <!-- Submit Button -->
            <div class="pt-6 border-t border-gray-100 flex items-center justify-end">
                <button type="submit" class="px-6 py-2.5 text-xs font-bold text-white bg-blue-600 hover:bg-blue-700 rounded-lg shadow-md transition-colors flex items-center gap-2">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                    <span>Save Site Media Settings</span>
                </button>
            </div>
        </div>
    </form>
</div>

<script>
function previewImage(input, previewId) {
    if (input.files && input.files[0]) {
        const reader = new FileReader();
        reader.onload = function(e) {
            const preview = document.getElementById(previewId);
            if (preview) {
                preview.src = e.target.result;
            }
        }
        reader.readAsDataURL(input.files[0]);
    }
}
</script>

<%- include('partials/admin-footer') %>
