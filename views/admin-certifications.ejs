<%- include('partials/admin-header') %>

<div class="flex-grow p-6 md:p-10 max-w-7xl w-full mx-auto">
    
    <!-- Dashboard Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
        <div>
            <h1 class="text-3xl font-extrabold text-gray-900 uppercase tracking-tight">Manage <span class="text-blue-600">Certifications</span></h1>
            <p class="text-gray-500 text-sm mt-1">Manage certifications and legal registrations displayed on the Quality Assurance page.</p>
        </div>
        <div>
            <a href="/admin/certifications/add" class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-2.5 px-5 rounded-lg shadow-md transition flex items-center gap-2 text-sm">
                <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"></path>
                </svg>
                <span>Add New Certification</span>
            </a>
        </div>
    </div>

    <!-- Certifications Table / List -->
    <div class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden mb-12">
        <div class="p-6 border-b border-gray-200">
            <h2 class="text-xl font-bold text-gray-800">Current Certifications</h2>
        </div>
        
        <% if (certifications && certifications.length > 0) { %>
            <!-- Desktop Table view -->
            <div class="hidden md:block overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-gray-50 text-xs font-bold uppercase tracking-wider text-gray-500 border-b border-gray-200">
                            <th class="p-4 pl-6">Icon</th>
                            <th class="p-4">Title / Subtitle</th>
                            <th class="p-4">Badge (Highlight)</th>
                            <th class="p-4">Note (Info)</th>
                            <th class="p-4">Link (Certificate)</th>
                            <th class="p-4 pr-6 text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100 text-sm text-gray-700">
                        <% certifications.forEach(cert => { %>
                            <tr class="hover:bg-gray-50/50 transition-colors">
                                <td class="p-4 pl-6">
                                    <div class="w-10 h-10 rounded-lg bg-blue-50 border border-blue-100 flex items-center justify-center text-blue-600">
                                        <% if (cert.iconType === 'shield-check') { %>
                                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
                                            </svg>
                                        <% } else if (cert.iconType === 'badge-check') { %>
                                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138z"></path>
                                            </svg>
                                        <% } else if (cert.iconType === 'clipboard-check') { %>
                                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path>
                                            </svg>
                                        <% } else if (cert.iconType === 'office-building') { %>
                                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
                                            </svg>
                                        <% } else { %>
                                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
                                            </svg>
                                        <% } %>
                                    </div>
                                </td>
                                <td class="p-4">
                                    <div class="font-bold text-gray-900"><%= cert.title %></div>
                                    <% if (cert.subtitle) { %>
                                        <div class="text-xs text-gray-500 font-medium"><%= cert.subtitle %></div>
                                    <% } %>
                                </td>
                                <td class="p-4 font-semibold text-xs text-blue-700">
                                    <%= cert.badgeText || 'N/A' %>
                                </td>
                                <td class="p-4 text-xs text-gray-500 font-normal">
                                    <%= cert.noteText || 'N/A' %>
                                </td>
                                <td class="p-4 text-xs">
                                    <% if (cert.link) { %>
                                        <a href="<%= cert.link %>" target="_blank" class="text-blue-600 hover:text-blue-800 font-semibold inline-flex items-center gap-1">
                                            View Document ↗
                                        </a>
                                    <% } else { %>
                                        <span class="text-gray-400">No Document</span>
                                    <% } %>
                                </td>
                                <td class="p-4 pr-6 text-right">
                                    <div class="flex items-center justify-end gap-3">
                                        <a href="/admin/certifications/edit/<%= cert._id %>" class="text-amber-600 hover:text-amber-800 font-semibold text-xs border border-amber-200 hover:border-amber-300 rounded px-2.5 py-1 transition-colors">Edit</a>
                                        <form action="/admin/certifications/delete/<%= cert._id %>" method="POST" onsubmit="return confirm('Are you sure you want to delete this certification?');" class="inline">
                                            <button type="submit" class="text-rose-600 hover:text-rose-800 font-semibold text-xs border border-rose-200 hover:border-rose-300 rounded px-2.5 py-1 transition-colors">Delete</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>

            <!-- Mobile/Tablet Grid view -->
            <div class="md:hidden p-4 space-y-4 bg-slate-50/30">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <% certifications.forEach(cert => { %>
                        <div class="bg-white rounded-xl border border-gray-200 p-4 shadow-sm space-y-3 hover:border-blue-200 transition-colors">
                            <div class="flex items-start gap-3">
                                <div class="w-10 h-10 rounded-lg bg-blue-50 border border-blue-100 flex items-center justify-center text-blue-600 shrink-0">
                                    <% if (cert.iconType === 'shield-check') { %>
                                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
                                        </svg>
                                    <% } else if (cert.iconType === 'badge-check') { %>
                                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138z"></path>
                                        </svg>
                                    <% } else if (cert.iconType === 'clipboard-check') { %>
                                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path>
                                        </svg>
                                    <% } else if (cert.iconType === 'office-building') { %>
                                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
                                        </svg>
                                    <% } else { %>
                                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
                                        </svg>
                                    <% } %>
                                </div>
                                <div class="min-w-0 flex-grow">
                                    <h3 class="font-bold text-gray-900 text-sm truncate" title="<%= cert.title %>"><%= cert.title %></h3>
                                    <% if (cert.subtitle) { %>
                                        <p class="text-xs text-gray-500 font-medium truncate" title="<%= cert.subtitle %>"><%= cert.subtitle %></p>
                                    <% } %>
                                    <% if (cert.badgeText) { %>
                                        <span class="bg-blue-50 text-blue-700 text-[10px] font-bold px-2 py-0.5 rounded-md inline-block mt-1"><%= cert.badgeText %></span>
                                    <% } %>
                                </div>
                            </div>
                            <div class="text-xs text-gray-500 border-t border-b border-gray-50 py-2">
                                <span class="block text-[10px] text-gray-400 font-bold uppercase tracking-wider">Note (Info)</span>
                                <p class="font-medium text-gray-700 mt-0.5 leading-relaxed"><%= cert.noteText || 'N/A' %></p>
                            </div>
                            <div class="flex items-center justify-between pt-1">
                                <% if (cert.link) { %>
                                    <a href="<%= cert.link %>" target="_blank" class="text-blue-600 hover:text-blue-800 font-bold text-xs inline-flex items-center gap-0.5">
                                        <span>View Document</span>
                                        <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"></path>
                                        </svg>
                                    </a>
                                <% } else { %>
                                    <span class="text-gray-400 text-xs">No Document</span>
                                <% } %>
                                <div class="flex items-center gap-2">
                                    <a href="/admin/certifications/edit/<%= cert._id %>" class="text-amber-600 hover:text-amber-800 font-bold text-xs border border-amber-200 hover:border-amber-300 rounded-lg px-3 py-1.5 transition-colors bg-amber-50/30">Edit</a>
                                    <form action="/admin/certifications/delete/<%= cert._id %>" method="POST" onsubmit="return confirm('Are you sure you want to delete this certification?');" class="inline">
                                        <button type="submit" class="text-rose-600 hover:text-rose-800 font-bold text-xs border border-rose-200 hover:border-rose-300 rounded-lg px-3 py-1.5 transition-colors bg-rose-50/30">Delete</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                </div>
            </div>
        <% } else { %>
            <div class="p-12 text-center text-gray-400">
                <p class="font-medium">No certifications found in the system. Click "Add New Certification" to create one.</p>
            </div>
        <% } %>
    </div>

</div>

<%- include('partials/admin-footer') %>
