<%- include('partials/admin-header') %>

    <div class="flex-grow p-4 max-w-7xl w-full mx-auto">
        <!-- Header -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
            <div>
                <div class="flex items-center gap-2 text-xs font-bold text-slate-400 uppercase tracking-widest mb-1">
                    <a href="/admin/pages" class="hover:text-blue-600 transition">Pages</a>
                    <span>/</span>
                    <span class="text-blue-600">About Us</span>
                </div>
                <h1 class="text-3xl font-extrabold text-gray-900 uppercase tracking-tight">Customize <span
                        class="text-blue-600">About Us</span></h1>
                <p class="text-gray-500 text-sm mt-1">Manage company introduction, credentials box, mission & vision, 4
                    core value pillars, and manufacturing infrastructure.</p>
            </div>
            <div class="flex items-center gap-3">
                <a href="/about" target="_blank"
                    class="bg-white hover:bg-slate-50 text-slate-700 border border-slate-200 font-bold py-2.5 px-4 rounded-xl shadow-sm transition flex items-center gap-2 text-xs">
                    <span>View Live Page</span>
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round"
                            d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25">
                        </path>
                    </svg>
                </a>
                <button type="submit" form="aboutForm"
                    class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-2.5 px-6 rounded-xl shadow-md transition flex items-center gap-2 text-sm">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                    </svg>
                    <span>Save All Changes</span>
                </button>
            </div>
        </div>

        <!-- Edit Form -->
        <form id="aboutForm" action="/admin/pages/about" method="POST" enctype="multipart/form-data" class="space-y-8">

            <!-- 1. COMPANY INTRODUCTION -->
            <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm overflow-hidden">
                <div class="p-6 border-b border-slate-100 bg-slate-50/50 flex items-center justify-between">
                    <div>
                        <h2
                            class="text-base font-extrabold text-slate-800 uppercase tracking-wide flex items-center gap-2">
                            <span class="w-2.5 h-2.5 rounded-full bg-blue-600"></span>
                            1. Company Introduction & Credentials
                        </h2>
                        <p class="text-xs text-slate-400 mt-0.5">Top overview text, legal registration details, and
                            sidebar imagery</p>
                    </div>
                </div>
                <div class="p-6 space-y-6">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                        <div class="md:col-span-2">
                            <label class="block text-xs font-bold text-slate-700 mb-1.5 uppercase">Section
                                Heading</label>
                            <input type="text" name="introHeading" value="<%= data.introHeading || 'About Us' %>"
                                class="w-full text-sm border border-slate-200 rounded-xl px-4 py-2.5 focus:outline-none focus:border-blue-500 bg-white">
                        </div>
                        <div class="md:col-span-2">
                            <label class="block text-xs font-bold text-slate-700 mb-1.5 uppercase">Introduction
                                Paragraph 1 (HTML supported)</label>
                            <textarea name="introParagraph1" rows="3"
                                class="w-full text-sm border border-slate-200 rounded-xl p-4 focus:outline-none focus:border-blue-500 bg-white resize-y"><%= data.introParagraph1 || '' %></textarea>
                        </div>
                        <div class="md:col-span-2">
                            <label class="block text-xs font-bold text-slate-700 mb-1.5 uppercase">Introduction
                                Paragraph 2</label>
                            <textarea name="introParagraph2" rows="3"
                                class="w-full text-sm border border-slate-200 rounded-xl p-4 focus:outline-none focus:border-blue-500 bg-white resize-y"><%= data.introParagraph2 || '' %></textarea>
                        </div>
                    </div>

                    <!-- Credentials Box -->
                    <div class="border border-blue-100 rounded-xl p-5 bg-blue-50/40">
                        <h3 class="text-xs font-extrabold text-blue-900 uppercase tracking-wider mb-4">Official
                            Credentials Box</h3>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <% const creds=data.companyCredentials || {}; %>
                                <div>
                                    <label class="block text-[11px] font-bold text-slate-700 mb-1 uppercase">Legal
                                        Entity</label>
                                    <input type="text" name="legalEntity" value="<%= creds.legalEntity || '' %>"
                                        class="w-full text-xs border border-slate-200 rounded-lg px-3 py-2 bg-white focus:outline-none focus:border-blue-500">
                                </div>
                                <div>
                                    <label
                                        class="block text-[11px] font-bold text-slate-700 mb-1 uppercase">GSTIN</label>
                                    <input type="text" name="gstin" value="<%= creds.gstin || '' %>"
                                        class="w-full text-xs border border-slate-200 rounded-lg px-3 py-2 bg-white focus:outline-none focus:border-blue-500">
                                </div>
                                <div>
                                    <label class="block text-[11px] font-bold text-slate-700 mb-1 uppercase">BIS
                                        Licence</label>
                                    <input type="text" name="bisLicence" value="<%= creds.bisLicence || '' %>"
                                        class="w-full text-xs border border-slate-200 rounded-lg px-3 py-2 bg-white focus:outline-none focus:border-blue-500">
                                </div>
                                <div>
                                    <label
                                        class="block text-[11px] font-bold text-slate-700 mb-1 uppercase">Brands</label>
                                    <input type="text" name="brands" value="<%= creds.brands || '' %>"
                                        class="w-full text-xs border border-slate-200 rounded-lg px-3 py-2 bg-white focus:outline-none focus:border-blue-500">
                                </div>
                        </div>
                    </div>

                    <!-- Intro Side Images -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-5 pt-2">
                        <div>
                            <label class="block text-xs font-bold text-slate-700 mb-1.5 uppercase">Sidebar Pipe Stack
                                Image 1</label>
                            <div class="flex items-center gap-3">
                                <% if (data.sidebarImage1) { %>
                                    <img src="<%= data.sidebarImage1 %>"
                                        class="w-16 h-14 object-cover rounded-lg border border-slate-200">
                                    <% } %>
                                        <input type="file" name="sidebarImage1" accept="image/*"
                                            class="w-full text-xs text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-bold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100">
                            </div>
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-slate-700 mb-1.5 uppercase">Sidebar Pipe Stack
                                Image 2</label>
                            <div class="flex items-center gap-3">
                                <% if (data.sidebarImage2) { %>
                                    <img src="<%= data.sidebarImage2 %>"
                                        class="w-16 h-14 object-cover rounded-lg border border-slate-200">
                                    <% } %>
                                        <input type="file" name="sidebarImage2" accept="image/*"
                                            class="w-full text-xs text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-bold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100">
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 2. MISSION & VISION -->
            <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm overflow-hidden">
                <div class="p-6 border-b border-slate-100 bg-slate-50/50 flex items-center justify-between">
                    <div>
                        <h2
                            class="text-base font-extrabold text-slate-800 uppercase tracking-wide flex items-center gap-2">
                            <span class="w-2.5 h-2.5 rounded-full bg-blue-600"></span>
                            2. Mission, Vision & Banner
                        </h2>
                        <p class="text-xs text-slate-400 mt-0.5">Middle section image banner and organizational
                            statements</p>
                    </div>
                </div>
                <div class="p-6 space-y-6">
                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1.5 uppercase">Middle Pipeline Section
                            Banner Image</label>
                        <div class="flex items-center gap-3">
                            <% if (data.bannerImage) { %>
                                <img src="<%= data.bannerImage %>"
                                    class="w-24 h-14 object-cover rounded-lg border border-slate-200">
                                <% } %>
                                    <input type="file" name="bannerImage" accept="image/*"
                                        class="w-full text-xs text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-bold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100">
                        </div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                        <div class="border border-slate-200 rounded-xl p-4 bg-slate-50/40">
                            <label class="block text-xs font-bold text-blue-900 mb-1.5 uppercase">Mission Statement
                                Title</label>
                            <input type="text" name="missionTitle" value="<%= data.missionTitle || 'MISSION' %>"
                                class="w-full text-sm border border-slate-200 rounded-xl px-4 py-2 mb-3 bg-white focus:outline-none focus:border-blue-500 font-bold">
                            <label class="block text-xs font-bold text-slate-700 mb-1.5 uppercase">Mission Statement
                                Text</label>
                            <textarea name="missionText" rows="3"
                                class="w-full text-sm border border-slate-200 rounded-xl p-3 bg-white focus:outline-none focus:border-blue-500 resize-y"><%= data.missionText || '' %></textarea>
                        </div>

                        <div class="border border-slate-200 rounded-xl p-4 bg-slate-50/40">
                            <label class="block text-xs font-bold text-blue-900 mb-1.5 uppercase">Vision Statement
                                Title</label>
                            <input type="text" name="visionTitle" value="<%= data.visionTitle || 'VISION' %>"
                                class="w-full text-sm border border-slate-200 rounded-xl px-4 py-2 mb-3 bg-white focus:outline-none focus:border-blue-500 font-bold">
                            <label class="block text-xs font-bold text-slate-700 mb-1.5 uppercase">Vision Statement
                                Text</label>
                            <textarea name="visionText" rows="3"
                                class="w-full text-sm border border-slate-200 rounded-xl p-3 bg-white focus:outline-none focus:border-blue-500 resize-y"><%= data.visionText || '' %></textarea>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 3. CORE VALUES (4 PILLARS) -->
            <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm overflow-hidden">
                <div class="p-6 border-b border-slate-100 bg-slate-50/50 flex items-center justify-between">
                    <div>
                        <h2
                            class="text-base font-extrabold text-slate-800 uppercase tracking-wide flex items-center gap-2">
                            <span class="w-2.5 h-2.5 rounded-full bg-blue-600"></span>
                            3. Core Values (4 Pillars)
                        </h2>
                        <p class="text-xs text-slate-400 mt-0.5">Edit the 4 core corporate values displayed on the
                            timeline</p>
                    </div>
                </div>
                <div class="p-6">
                    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4">
                        <% const vals=data.values || []; %>
                            <% for (let i=0; i < 4; i++) { %>
                                <% const v=vals[i] || {}; %>
                                    <div class="border border-slate-200 rounded-xl p-4 bg-slate-50/50">
                                        <span
                                            class="inline-block text-[10px] font-bold text-blue-700 bg-blue-50 px-2 py-0.5 rounded uppercase mb-2">Value
                                            <%= i + 1 %>
                                        </span>
                                        <div class="space-y-3">
                                            <div>
                                                <label
                                                    class="block text-[11px] font-bold text-slate-700 mb-1 uppercase">Pillar
                                                    Name</label>
                                                <input type="text" name="valTitle_<%= i %>" value="<%= v.title || '' %>"
                                                    class="w-full text-xs border border-slate-200 rounded-lg px-3 py-2 bg-white focus:outline-none focus:border-blue-500 font-bold">
                                            </div>
                                            <div>
                                                <label
                                                    class="block text-[11px] font-bold text-slate-700 mb-1 uppercase">Pillar
                                                    Description</label>
                                                <textarea name="valDesc_<%= i %>" rows="3"
                                                    class="w-full text-xs border border-slate-200 rounded-lg p-2.5 bg-white focus:outline-none focus:border-blue-500 resize-y"><%= v.description || '' %></textarea>
                                            </div>
                                        </div>
                                    </div>
                                    <% } %>
                    </div>
                </div>
            </div>

            <!-- 4. INFRASTRUCTURE SECTION -->
            <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm overflow-hidden">
                <div class="p-6 border-b border-slate-100 bg-slate-50/50 flex items-center justify-between">
                    <div>
                        <h2
                            class="text-base font-extrabold text-slate-800 uppercase tracking-wide flex items-center gap-2">
                            <span class="w-2.5 h-2.5 rounded-full bg-blue-600"></span>
                            4. Manufacturing Infrastructure
                        </h2>
                        <p class="text-xs text-slate-400 mt-0.5">Factory floor, extrusion lines, and machinery photo
                            gallery</p>
                    </div>
                </div>
                <div class="p-6 space-y-6">
                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1.5 uppercase">Infrastructure
                            Title</label>
                        <input type="text" name="infraTitle" value="<%= data.infraTitle || 'Our Infrastructure' %>"
                            class="w-full text-sm border border-slate-200 rounded-xl px-4 py-2.5 focus:outline-none focus:border-blue-500 bg-white">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1.5 uppercase">Infrastructure
                            Description</label>
                        <textarea name="infraText" rows="3"
                            class="w-full text-sm border border-slate-200 rounded-xl p-4 focus:outline-none focus:border-blue-500 bg-white resize-y"><%= data.infraText || '' %></textarea>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-5 pt-2">
                        <div>
                            <label class="block text-xs font-bold text-slate-700 mb-1.5 uppercase">Factory Floor Photo
                                1</label>
                            <div class="flex items-center gap-3">
                                <% if (data.infraImage1) { %>
                                    <img src="<%= data.infraImage1 %>"
                                        class="w-16 h-14 object-cover rounded-lg border border-slate-200">
                                    <% } %>
                                        <input type="file" name="infraImage1" accept="image/*"
                                            class="w-full text-xs text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-bold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100">
                            </div>
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-slate-700 mb-1.5 uppercase">Extrusion Line Photo
                                2</label>
                            <div class="flex items-center gap-3">
                                <% if (data.infraImage2) { %>
                                    <img src="<%= data.infraImage2 %>"
                                        class="w-16 h-14 object-cover rounded-lg border border-slate-200">
                                    <% } %>
                                        <input type="file" name="infraImage2" accept="image/*"
                                            class="w-full text-xs text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-bold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100">
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Sticky Bottom Actions -->
            <div
                class="sticky bottom-6 z-30 bg-white/95 backdrop-blur-md p-4 rounded-2xl border border-slate-200 shadow-xl flex items-center justify-between">
                <span class="text-xs text-slate-500 font-medium">Changes will instantly reflect on the About Us
                    page.</span>
                <button type="submit"
                    class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-2.5 px-6 rounded-xl shadow-md transition flex items-center gap-2 text-sm">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                    </svg>
                    <span>Save All Changes</span>
                </button>
            </div>

        </form>
    </div>

    <%- include('partials/admin-footer') %>