<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <title><%= title %></title>
    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
        }
    </style>
</head>
<body class="bg-[#F8FAFC] text-[#1E293B] min-h-screen flex">

    <!-- Sidebar -->
    <aside class="w-64 bg-white text-slate-600 min-h-screen flex flex-col justify-between border-r border-slate-200 shrink-0 sticky top-0 hidden md:flex shadow-sm">
        <div>
            <!-- Sidebar Brand Header -->
            <div class="p-6 border-b border-slate-100 flex items-center gap-3">
                <div class="w-8 h-8 rounded-lg bg-blue-600 flex items-center justify-center font-bold text-white text-lg shadow-sm">
                    S
                </div>
                <div>
                    <h2 class="text-sm font-extrabold text-slate-800 tracking-wider uppercase">Solanki Pipes</h2>
                    <p class="text-[10px] text-blue-600 font-bold tracking-widest uppercase">Admin Console</p>
                </div>
            </div>

            <!-- Navigation Links -->
            <nav class="p-4 space-y-1.5">
                <a href="/admin/projects" class="flex items-center gap-3 py-2.5 px-4 rounded-lg font-semibold text-sm transition-all <%= typeof activeTab !== 'undefined' && activeTab === 'projects' ? 'bg-blue-50 text-blue-700 shadow-sm border border-blue-100/50' : 'hover:bg-slate-50 hover:text-slate-800' %>">
                    <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"></path>
                    </svg>
                    <span>Manage Projects</span>
                </a>
                <a href="/admin/certifications" class="flex items-center gap-3 py-2.5 px-4 rounded-lg font-semibold text-sm transition-all <%= typeof activeTab !== 'undefined' && activeTab === 'certifications' ? 'bg-blue-50 text-blue-700 shadow-sm border border-blue-100/50' : 'hover:bg-slate-50 hover:text-slate-800' %>">
                    <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"></path>
                    </svg>
                    <span>Manage Certifications</span>
                </a>
            </nav>
        </div>

        <!-- Sidebar Footer Info & Actions -->
        <div class="p-4 border-t border-slate-100 space-y-3 bg-slate-50/50">
            <div class="px-4 py-3 bg-white border border-slate-100 rounded-xl flex items-center gap-3 shadow-sm">
                <div class="w-8 h-8 rounded-full bg-blue-600/10 text-blue-700 flex items-center justify-center text-xs font-extrabold">
                    A
                </div>
                <div class="truncate">
                    <p class="text-xs font-bold text-slate-800 truncate">Administrator</p>
                    <p class="text-[10px] text-slate-400 font-medium truncate">Control Portal</p>
                </div>
            </div>
            
            <div class="flex flex-col gap-1.5">
                <a href="/" target="_blank" class="flex items-center justify-center gap-2 py-2 px-4 rounded-lg border border-slate-200 hover:bg-slate-50 text-xs font-bold text-slate-600 hover:text-slate-800 transition">
                    <svg class="w-4 h-4 flex-shrink-0 text-slate-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9s2.015-9 4.5-9m0 0a9.003 9.003 0 018.716 6.747M12 3a9.003 9.003 0 00-8.716 6.747M3 12h18"></path>
                    </svg>
                    <span>Visit Website</span>
                    <svg class="w-3 h-3 flex-shrink-0 opacity-70" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"></path>
                    </svg>
                </a>
                <a href="/admin/logout" class="flex items-center justify-center gap-2 py-2 px-4 rounded-lg bg-rose-50 hover:bg-rose-100/70 border border-rose-200 text-xs font-bold text-rose-700 hover:text-rose-800 transition">
                    Logout
                </a>
            </div>
        </div>
    </aside>

    <!-- Mobile Navigation Bar -->
    <div class="md:hidden fixed top-0 left-0 right-0 h-16 bg-white text-slate-800 flex items-center justify-between px-6 z-40 border-b border-slate-200 shadow-sm">
        <div class="flex items-center gap-2">
            <div class="w-7 h-7 rounded-md bg-blue-600 flex items-center justify-center font-bold text-white text-sm">
                S
            </div>
            <span class="font-extrabold text-sm tracking-wider uppercase text-slate-800">Solanki Admin</span>
        </div>
        <div class="flex items-center gap-3">
            <a href="/admin/projects" class="text-xs font-bold <%= typeof activeTab !== 'undefined' && activeTab === 'projects' ? 'text-blue-600' : 'text-slate-500' %>">Projects</a>
            <a href="/admin/certifications" class="text-xs font-bold <%= typeof activeTab !== 'undefined' && activeTab === 'certifications' ? 'text-blue-600' : 'text-slate-500' %>">Certifications</a>
            <a href="/admin/logout" class="text-xs font-bold text-rose-600">Logout</a>
        </div>
    </div>

    <!-- Main Workspace Container -->
    <div class="flex-grow flex flex-col min-h-screen pt-16 md:pt-0 overflow-x-hidden">
