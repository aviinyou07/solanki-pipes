<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : 'Solanki Pipes — Admin Console' %></title>
    
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Google Fonts: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Inline script to apply saved sidebar state before rendering to prevent layout shift -->
    <script>
        (function() {
            try {
                if (localStorage.getItem('solanki_sidebar_collapsed') === 'true') {
                    document.documentElement.classList.add('sidebar-collapsed');
                }
            } catch (e) {}
        })();
    </script>
    
    <style>
        body {
            font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }

        /* Custom Scrollbar */
        .admin-scrollbar::-webkit-scrollbar {
            width: 4px;
        }
        .admin-scrollbar::-webkit-scrollbar-track {
            background: transparent;
        }
        .admin-scrollbar::-webkit-scrollbar-thumb {
            background: #E2E8F0;
            border-radius: 9999px;
        }
        .admin-scrollbar::-webkit-scrollbar-thumb:hover {
            background: #CBD5E1;
        }

        /* Fixed Desktop Sidebar */
        #desktop-sidebar {
            position: fixed !important;
            top: 0 !important;
            left: 0 !important;
            bottom: 0 !important;
            height: 100vh !important;
            max-height: 100vh !important;
            z-index: 40 !important;
            transition: width 0.25s cubic-bezier(0.4, 0, 0.2, 1) !important;
        }

        #main-content-wrapper {
            margin-left: 16rem; /* 256px = w-64 */
            width: calc(100% - 16rem);
            min-height: 100vh;
            transition: margin-left 0.25s cubic-bezier(0.4, 0, 0.2, 1), width 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        }

        /* Collapsed Sidebar Styles */
        html.sidebar-collapsed #desktop-sidebar {
            width: 4.5rem !important; /* 72px */
        }

        html.sidebar-collapsed #main-content-wrapper {
            margin-left: 4.5rem !important; /* 72px */
            width: calc(100% - 4.5rem) !important;
        }

        @media (max-width: 767px) {
            #desktop-sidebar {
                display: none !important;
            }
            #main-content-wrapper {
                margin-left: 0 !important;
                width: 100% !important;
            }
        }
        
        html.sidebar-collapsed .sidebar-hide-on-collapse {
            display: none !important;
        }

        html.sidebar-collapsed .sidebar-nav-item {
            justify-content: center;
            padding-left: 0.5rem;
            padding-right: 0.5rem;
        }

        html.sidebar-collapsed .sidebar-divider {
            display: block;
            margin: 0.6rem auto;
            width: 1.75rem;
            height: 1px;
            background-color: #E2E8F0;
        }

        html.sidebar-collapsed .sidebar-collapse-icon {
            transform: rotate(180deg);
        }

        /* Tooltip behavior only when sidebar is collapsed */
        html.sidebar-collapsed .sidebar-tooltip {
            display: none;
        }
        html.sidebar-collapsed .group:hover .sidebar-tooltip {
            display: block !important;
            animation: fadeIn 0.15s ease-in-out;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(-50%) translateX(-4px); }
            to { opacity: 1; transform: translateY(-50%) translateX(0); }
        }

        /* ======================================================== */
        /* PROFESSIONAL COMPACT & FLUID WORKSPACE (NO EXCESS SPACE) */
        /* ======================================================== */
        #main-content-wrapper {
            background-color: #F8FAFC;
            width: 100%;
            min-height: 100vh;
        }

        /* 1. Eliminate huge side gutters & padding (overrides max-w-7xl mx-auto md:p-10) */
        #main-content-wrapper > .flex-grow,
        #main-content-wrapper > div:not(header) {
            max-width: 100% !important;
            width: 100% !important;
            margin-left: 0 !important;
            margin-right: 0 !important;
            padding: 1rem 1.5rem !important; /* Clean 16px vertical, 24px horizontal */
        }

        @media (max-width: 640px) {
            #main-content-wrapper > .flex-grow,
            #main-content-wrapper > div:not(header) {
                padding: 0.75rem 0.875rem !important;
            }
        }

        /* 2. Tighten excessive vertical margins between header and content */
        #main-content-wrapper .mb-8 {
            margin-bottom: 0.875rem !important;
        }
        #main-content-wrapper .mb-12 {
            margin-bottom: 1rem !important;
        }
        #main-content-wrapper .mb-6 {
            margin-bottom: 0.75rem !important;
        }

        /* 3. Professional, sleek page headers */
        #main-content-wrapper h1.text-3xl {
            font-size: 1.25rem !important; /* 20px instead of bloated 30px */
            line-height: 1.5rem !important;
            font-weight: 800 !important;
            letter-spacing: -0.015em !important;
        }
        #main-content-wrapper p.text-sm {
            font-size: 0.8rem !important;
            line-height: 1.2rem !important;
            margin-top: 0.15rem !important;
        }

        /* 4. Compact action buttons */
        #main-content-wrapper a.bg-blue-600,
        #main-content-wrapper button.bg-blue-600 {
            padding: 0.45rem 0.875rem !important;
            font-size: 0.8125rem !important;
            border-radius: 0.5rem !important;
        }

        /* 5. Professional High-Density Tables */
        #main-content-wrapper .bg-white.rounded-2xl {
            border-radius: 0.625rem !important;
            border: 1px solid #E2E8F0 !important;
            box-shadow: 0 1px 2px rgba(0, 0, 0, 0.03) !important;
        }

        #main-content-wrapper .p-6.border-b {
            padding: 0.625rem 1rem !important;
        }
        #main-content-wrapper .p-6.border-b h2.text-xl {
            font-size: 0.95rem !important;
            font-weight: 700 !important;
        }

        #main-content-wrapper table th {
            padding: 0.5rem 0.75rem !important;
            font-size: 0.6875rem !important;
            font-weight: 700 !important;
            background-color: #F8FAFC !important;
            border-bottom: 1px solid #E2E8F0 !important;
        }

        #main-content-wrapper table td {
            padding: 0.5rem 0.75rem !important;
            font-size: 0.8125rem !important;
        }

        /* 6. Compact Grid & Card spacing for pages hub */
        #main-content-wrapper .grid.grid-cols-1.md\:grid-cols-2.lg\:grid-cols-3 {
            gap: 0.875rem !important;
        }
        #main-content-wrapper .grid .p-6 {
            padding: 0.875rem 1rem !important;
        }
        #main-content-wrapper .grid .bg-slate-50\/70.p-4 {
            padding: 0.5rem 1rem !important;
        }
    </style>
</head>
<body class="bg-[#F8FAFC] text-[#0F172A] min-h-screen flex antialiased">

    <% 
        // Active tab detection
        var currentTab = typeof activeTab !== 'undefined' ? activeTab : '';
        var pageTitle = typeof title !== 'undefined' ? title : '';
        if (!currentTab && pageTitle) {
            var pt = pageTitle.toLowerCase();
            if (pt.includes('project')) currentTab = 'projects';
            else if (pt.includes('product')) currentTab = 'products';
            else if (pt.includes('certification')) currentTab = 'certifications';
            else if (pt.includes('setting') || pt.includes('logo') || pt.includes('media')) currentTab = 'settings';
            else if (pt.includes('founder') || pt.includes('leader')) currentTab = 'leadership-messages';
            else if (pt.includes('home')) currentTab = 'page-home';
            else if (pt.includes('about')) currentTab = 'page-about';
            else if (pt.includes('contact')) currentTab = 'page-contact';
            else if (pt.includes('quality')) currentTab = 'page-quality';
            else if (pt.includes('download')) currentTab = 'page-downloads';
            else if (pt.includes('farmer')) currentTab = 'page-farmers-fair';
            else if (pt.includes('vendor')) currentTab = 'page-vendor-empanelment';
            else if (pt.includes('popup') || pt.includes('announcement') || pt.includes('modal')) currentTab = 'popup';
        }
    %>

    <!-- ========================================================================= -->
    <!-- DESKTOP SIDEBAR (Clean Light Professional Design - Fixed with Fixed Footer) -->
    <!-- ========================================================================= -->
    <aside id="desktop-sidebar" 
           class="w-64 bg-white text-slate-600 h-screen fixed top-0 left-0 bottom-0 border-r border-slate-200/90 hidden md:flex flex-col justify-between z-40 select-none shadow-sm overflow-hidden">
        
        <!-- Brand Header (Fixed Top) -->
        <div class="h-14 px-4 border-b border-slate-100 flex items-center justify-between shrink-0 bg-white">
            <a href="/admin/pages" class="flex items-center gap-3 group min-w-0">
                <div class="w-8 h-8 rounded-lg bg-blue-600 flex items-center justify-center font-bold text-white text-sm shadow-sm shrink-0">
                    S
                </div>
                <div class="sidebar-hide-on-collapse min-w-0">
                    <h2 class="text-xs font-bold tracking-wider uppercase text-slate-800 truncate">Solanki Pipes</h2>
                    <p class="text-[9px] text-blue-600 font-bold tracking-widest uppercase truncate">Admin Console</p>
                </div>
            </a>

                <!-- Collapse / Expand Trigger on Sidebar -->
                <button id="btn-sidebar-collapse" 
                        type="button"
                        title="Toggle Sidebar"
                        class="p-1.5 rounded-lg text-slate-400 hover:text-slate-700 hover:bg-slate-100 transition focus:outline-none">
                    <svg class="w-4 h-4 sidebar-collapse-icon transition-transform duration-200" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M11 19l-7-7 7-7m8 14l-7-7 7-7" />
                    </svg>
                </button>
            </div>

            <!-- Navigation Menu Items -->
            <nav class="p-3 space-y-4 overflow-y-auto admin-scrollbar flex-grow">
                
                <!-- 1. Catalog & Core -->
                <div>
                    <span class="sidebar-hide-on-collapse px-3 text-[10px] font-bold uppercase tracking-wider text-slate-400 block mb-1">Catalog & Core</span>
                    <div class="sidebar-divider hidden"></div>
                    
                    <div class="space-y-1">
                        <!-- Projects -->
                        <div class="relative group">
                            <a href="/admin/projects" 
                               class="sidebar-nav-item flex items-center gap-3 py-2 px-3 rounded-lg font-semibold text-xs transition-all <%= currentTab === 'projects' ? 'bg-blue-50 text-blue-700 font-bold shadow-xs border border-blue-100' : 'text-slate-600 hover:bg-slate-50 hover:text-slate-900' %>">
                                <svg class="w-4 h-4 shrink-0 <%= currentTab === 'projects' ? 'text-blue-600' : 'text-slate-400 group-hover:text-slate-600' %>" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"/>
                                </svg>
                                <span class="sidebar-hide-on-collapse truncate">Manage Projects</span>
                            </a>
                            <div class="sidebar-tooltip hidden absolute left-full ml-3 top-1/2 -translate-y-1/2 bg-slate-800 text-white text-xs font-semibold px-2.5 py-1 rounded-md shadow-lg pointer-events-none whitespace-nowrap z-50">
                                Manage Projects
                            </div>
                        </div>

                        <!-- Products -->
                        <div class="relative group">
                            <a href="/admin/products" 
                               class="sidebar-nav-item flex items-center gap-3 py-2 px-3 rounded-lg font-semibold text-xs transition-all <%= currentTab === 'products' ? 'bg-blue-50 text-blue-700 font-bold shadow-xs border border-blue-100' : 'text-slate-600 hover:bg-slate-50 hover:text-slate-900' %>">
                                <svg class="w-4 h-4 shrink-0 <%= currentTab === 'products' ? 'text-blue-600' : 'text-slate-400 group-hover:text-slate-600' %>" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
                                </svg>
                                <span class="sidebar-hide-on-collapse truncate">Manage Products</span>
                            </a>
                            <div class="sidebar-tooltip hidden absolute left-full ml-3 top-1/2 -translate-y-1/2 bg-slate-800 text-white text-xs font-semibold px-2.5 py-1 rounded-md shadow-lg pointer-events-none whitespace-nowrap z-50">
                                Manage Products
                            </div>
                        </div>

                        <!-- Certifications -->
                        <div class="relative group">
                            <a href="/admin/certifications" 
                               class="sidebar-nav-item flex items-center gap-3 py-2 px-3 rounded-lg font-semibold text-xs transition-all <%= currentTab === 'certifications' ? 'bg-blue-50 text-blue-700 font-bold shadow-xs border border-blue-100' : 'text-slate-600 hover:bg-slate-50 hover:text-slate-900' %>">
                                <svg class="w-4 h-4 shrink-0 <%= currentTab === 'certifications' ? 'text-blue-600' : 'text-slate-400 group-hover:text-slate-600' %>" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"/>
                                </svg>
                                <span class="sidebar-hide-on-collapse truncate">Manage Certifications</span>
                            </a>
                            <div class="sidebar-tooltip hidden absolute left-full ml-3 top-1/2 -translate-y-1/2 bg-slate-800 text-white text-xs font-semibold px-2.5 py-1 rounded-md shadow-lg pointer-events-none whitespace-nowrap z-50">
                                Manage Certifications
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 2. Page Content Customizer -->
                <div>
                    <div class="sidebar-hide-on-collapse flex items-center justify-between px-3 mb-1">
                        <span class="text-[10px] font-bold text-blue-600 uppercase tracking-wider">Page Customizer</span>
                        <a href="/admin/pages" class="text-[10px] font-bold text-slate-400 hover:text-blue-600">Hub ↗</a>
                    </div>
                    <div class="sidebar-divider hidden"></div>

                    <div class="space-y-0.5">
                        <!-- Hub -->
                        <div class="relative group">
                            <a href="/admin/pages" 
                               class="sidebar-nav-item flex items-center gap-3 py-1.5 px-3 rounded-lg font-semibold text-xs transition-all <%= currentTab === 'pages-hub' ? 'bg-blue-600 text-white font-bold shadow-xs' : 'text-slate-600 hover:bg-slate-50 hover:text-slate-900' %>">
                                <svg class="w-4 h-4 shrink-0 <%= currentTab === 'pages-hub' ? 'text-white' : 'text-slate-400 group-hover:text-slate-600' %>" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/>
                                </svg>
                                <span class="sidebar-hide-on-collapse truncate">All Pages Directory</span>
                            </a>
                            <div class="sidebar-tooltip hidden absolute left-full ml-3 top-1/2 -translate-y-1/2 bg-slate-800 text-white text-xs font-semibold px-2.5 py-1 rounded-md shadow-lg pointer-events-none whitespace-nowrap z-50">
                                All Pages Directory
                            </div>
                        </div>

                        <!-- Home Page -->
                        <div class="relative group">
                            <a href="/admin/pages/home" 
                               class="sidebar-nav-item flex items-center gap-3 py-1.5 px-3 rounded-lg font-semibold text-xs transition-all <%= currentTab === 'page-home' ? 'bg-blue-50 text-blue-700 font-bold shadow-xs border border-blue-100' : 'text-slate-600 hover:bg-slate-50 hover:text-slate-900' %>">
                                <svg class="w-4 h-4 shrink-0 <%= currentTab === 'page-home' ? 'text-blue-600' : 'text-slate-400 group-hover:text-slate-600' %>" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
                                </svg>
                                <span class="sidebar-hide-on-collapse truncate">Home Page</span>
                            </a>
                            <div class="sidebar-tooltip hidden absolute left-full ml-3 top-1/2 -translate-y-1/2 bg-slate-800 text-white text-xs font-semibold px-2.5 py-1 rounded-md shadow-lg pointer-events-none whitespace-nowrap z-50">
                                Home Page
                            </div>
                        </div>

                        <!-- About Us -->
                        <div class="relative group">
                            <a href="/admin/pages/about" 
                               class="sidebar-nav-item flex items-center gap-3 py-1.5 px-3 rounded-lg font-semibold text-xs transition-all <%= currentTab === 'page-about' ? 'bg-blue-50 text-blue-700 font-bold shadow-xs border border-blue-100' : 'text-slate-600 hover:bg-slate-50 hover:text-slate-900' %>">
                                <svg class="w-4 h-4 shrink-0 <%= currentTab === 'page-about' ? 'text-blue-600' : 'text-slate-400 group-hover:text-slate-600' %>" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
                                </svg>
                                <span class="sidebar-hide-on-collapse truncate">About Us</span>
                            </a>
                            <div class="sidebar-tooltip hidden absolute left-full ml-3 top-1/2 -translate-y-1/2 bg-slate-800 text-white text-xs font-semibold px-2.5 py-1 rounded-md shadow-lg pointer-events-none whitespace-nowrap z-50">
                                About Us
                            </div>
                        </div>

                        <!-- Contact Us -->
                        <div class="relative group">
                            <a href="/admin/pages/contact" 
                               class="sidebar-nav-item flex items-center gap-3 py-1.5 px-3 rounded-lg font-semibold text-xs transition-all <%= currentTab === 'page-contact' ? 'bg-blue-50 text-blue-700 font-bold shadow-xs border border-blue-100' : 'text-slate-600 hover:bg-slate-50 hover:text-slate-900' %>">
                                <svg class="w-4 h-4 shrink-0 <%= currentTab === 'page-contact' ? 'text-blue-600' : 'text-slate-400 group-hover:text-slate-600' %>" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                                </svg>
                                <span class="sidebar-hide-on-collapse truncate">Contact Us</span>
                            </a>
                            <div class="sidebar-tooltip hidden absolute left-full ml-3 top-1/2 -translate-y-1/2 bg-slate-800 text-white text-xs font-semibold px-2.5 py-1 rounded-md shadow-lg pointer-events-none whitespace-nowrap z-50">
                                Contact Us
                            </div>
                        </div>

                        <!-- Quality Assurance -->
                        <div class="relative group">
                            <a href="/admin/pages/quality" 
                               class="sidebar-nav-item flex items-center gap-3 py-1.5 px-3 rounded-lg font-semibold text-xs transition-all <%= currentTab === 'page-quality' ? 'bg-blue-50 text-blue-700 font-bold shadow-xs border border-blue-100' : 'text-slate-600 hover:bg-slate-50 hover:text-slate-900' %>">
                                <svg class="w-4 h-4 shrink-0 <%= currentTab === 'page-quality' ? 'text-blue-600' : 'text-slate-400 group-hover:text-slate-600' %>" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                                </svg>
                                <span class="sidebar-hide-on-collapse truncate">Quality Assurance</span>
                            </a>
                            <div class="sidebar-tooltip hidden absolute left-full ml-3 top-1/2 -translate-y-1/2 bg-slate-800 text-white text-xs font-semibold px-2.5 py-1 rounded-md shadow-lg pointer-events-none whitespace-nowrap z-50">
                                Quality Assurance
                            </div>
                        </div>

                        <!-- Downloads Center -->
                        <div class="relative group">
                            <a href="/admin/pages/downloads" 
                               class="sidebar-nav-item flex items-center gap-3 py-1.5 px-3 rounded-lg font-semibold text-xs transition-all <%= currentTab === 'page-downloads' ? 'bg-blue-50 text-blue-700 font-bold shadow-xs border border-blue-100' : 'text-slate-600 hover:bg-slate-50 hover:text-slate-900' %>">
                                <svg class="w-4 h-4 shrink-0 <%= currentTab === 'page-downloads' ? 'text-blue-600' : 'text-slate-400 group-hover:text-slate-600' %>" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
                                </svg>
                                <span class="sidebar-hide-on-collapse truncate">Downloads Center</span>
                            </a>
                            <div class="sidebar-tooltip hidden absolute left-full ml-3 top-1/2 -translate-y-1/2 bg-slate-800 text-white text-xs font-semibold px-2.5 py-1 rounded-md shadow-lg pointer-events-none whitespace-nowrap z-50">
                                Downloads Center
                            </div>
                        </div>

                        <!-- Farmers' Fair CSR -->
                        <div class="relative group">
