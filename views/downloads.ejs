<%- include('partials/header') %>

<header class="py-16 px-8 max-w-7xl mx-auto text-center relative">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 text-blue-700 text-xs font-bold uppercase tracking-wider mb-4 border border-blue-100">
        <svg class="w-3.5 h-3.5 text-blue-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m.75 12l3 3m0 0l3-3m-3 3v-6m-1.5-9H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z"/></svg>
        <span>Verified Compliance Documents</span>
    </div>
    <h1 class="text-4xl md:text-6xl font-black tracking-tight text-slate-900 mb-4 uppercase">
        <%= (typeof pageData !== 'undefined' && pageData && pageData.headerTitle) ? pageData.headerTitle : 'DOWNLOAD CENTER' %>
    </h1>
    <p class="text-lg md:text-2xl font-light text-slate-600 max-w-2xl mx-auto">
        <%= (typeof pageData !== 'undefined' && pageData && pageData.headerSubtitle) ? pageData.headerSubtitle : 'Official Documents, BIS Licenses, and Quality Test Reports' %>
    </p>
</header>

<main class="max-w-7xl mx-auto px-6 py-6 mb-24">
    <% 
      const docsList = (typeof pageData !== 'undefined' && pageData && pageData.documents && pageData.documents.length) ? pageData.documents : [
        { icon: 'profile', title: 'Company Profile', description: 'Comprehensive corporate overview, manufacturing capacity, and technical infrastructure.', fileUrl: '/images/Catalog Solanki Pipes.pdf' },
        { icon: 'bis', title: 'BIS Licence (IS 4984:2016)', description: 'Bureau of Indian Standards certification licence for HDPE pipes (CM/L 9100182616).', fileUrl: '/images/Catalog Solanki Pipes.pdf' },
        { icon: 'iso', title: 'ISO 9001:2015 Certificate', description: 'Certified Quality Management System for consistent manufacturing excellence.', fileUrl: '/images/Catalog Solanki Pipes.pdf' },
        { icon: 'gst', title: 'GST Registration Certificate', description: 'Official Government of India Goods and Services Tax credentials and registration details.', fileUrl: '/images/Catalog Solanki Pipes.pdf' },
        { icon: 'catalog', title: 'Full Product Catalogue', description: 'Complete dimensional tables, pressure ratings (PN 2.5 to PN 10), and fittings range.', fileUrl: (typeof siteSettings !== 'undefined' && siteSettings && siteSettings.catalogPdf) ? siteSettings.catalogPdf : '/images/Catalog Solanki Pipes.pdf' },
        { icon: 'test', title: 'Sample Test Certificates', description: 'Hydrostatic, carbon dispersion, MFR, and density third-party batch test reports.', fileUrl: '/images/Catalog Solanki Pipes.pdf' },
        { icon: 'msds', title: 'MSDS Material Safety', description: 'Comprehensive material safety data sheets for non-toxic, potable water applications.', fileUrl: '/images/Catalog Solanki Pipes.pdf' }
      ];

      function getDocIconSvg(doc, idx) {
        const text = (doc.title + ' ' + (doc.icon || '')).toLowerCase();
        if (text.includes('bis') || text.includes('licence') || text.includes('license')) {
          return {
            bg: 'bg-emerald-50 text-emerald-600 border-emerald-200 group-hover:bg-emerald-600 group-hover:text-white',
            svg: '<path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 01-1.043 3.296 3.745 3.745 0 01-3.296 1.043A3.745 3.745 0 0112 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 01-3.296-1.043 3.745 3.745 0 01-1.043-3.296A3.745 3.745 0 013 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 011.043-3.296 3.746 3.746 0 013.296-1.043A3.746 3.746 0 0112 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 013.296 1.043 3.746 3.746 0 011.043 3.296A3.745 3.745 0 0121 12z" />'
          };
        }
        if (text.includes('iso') || text.includes('award') || text.includes('quality')) {
          return {
            bg: 'bg-amber-50 text-amber-600 border-amber-200 group-hover:bg-amber-500 group-hover:text-white',
            svg: '<path stroke-linecap="round" stroke-linejoin="round" d="M16.5 18.75h-9m9 0a3 3 0 013 3h-15a3 3 0 013-3m9 0v-3.375c0-.621-.503-1.125-1.125-1.125h-.871M7.5 18.75v-3.375c0-.621.504-1.125 1.125-1.125h.872m5.007 0H9.496m5.007 0a3 3 0 002.247-1.043l2.84-3.246a3 3 0 00.67-1.956V4.875A2.625 2.625 0 0017.635 2.25H6.365A2.625 2.625 0 003.74 4.875v4.255c0 .736.242 1.448.67 1.956l2.84 3.246a3 3 0 002.246 1.043" />'
          };
        }
        if (text.includes('catalog') || text.includes('catalogue') || text.includes('brochure')) {
          return {
            bg: 'bg-blue-50 text-blue-600 border-blue-200 group-hover:bg-blue-600 group-hover:text-white',
            svg: '<path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" />'
          };
        }
        if (text.includes('test') || text.includes('lab') || text.includes('certificate')) {
          return {
            bg: 'bg-purple-50 text-purple-600 border-purple-200 group-hover:bg-purple-600 group-hover:text-white',
            svg: '<path stroke-linecap="round" stroke-linejoin="round" d="M9.75 3.104v5.714a2.25 2.25 0 01-.659 1.591L5 14.5m4.75-11.396A2.25 2.25 0 0112 2.25c.621 0 1.19.252 1.604.664M9.75 3.104c-.621.414-1.125 1.055-1.125 1.896m5.625-1.896v5.714c0 .597.237 1.17.659 1.591L19 14.5m-4.75-11.396A2.25 2.25 0 0012 2.25m4.125 4.5v1.5m-8.25-1.5v1.5M3.375 21.75h17.25c.621 0 1.125-.504 1.125-1.125a9 9 0 00-9-9 9 9 0 00-9 9c0 .621.504 1.125 1.125 1.125z" />'
          };
        }
        if (text.includes('gst') || text.includes('tax') || text.includes('finance')) {
          return {
            bg: 'bg-indigo-50 text-indigo-600 border-indigo-200 group-hover:bg-indigo-600 group-hover:text-white',
            svg: '<path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18.75a60.07 60.07 0 0115.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 013 6H2.25m0 0v9m0 0H3a.75.75 0 01.75.75v.75m0 0h16.5m0 0v-.75a.75.75 0 01.75-.75h.75m0 0V6a.75.75 0 00-.75-.75h-.75m0 0V4.5m0 0H3.75m16.5 0h.75A2.25 2.25 0 0123.25 6.75v9a2.25 2.25 0 01-2.25 2.25h-.75M3.75 4.5A2.25 2.25 0 001.5 6.75v9a2.25 2.25 0 002.25 2.25h.75m6-10.5h6m-6 3h6m-6 3h3" />'
          };
        }
        if (text.includes('msds') || text.includes('safety') || text.includes('hazard')) {
          return {
            bg: 'bg-rose-50 text-rose-600 border-rose-200 group-hover:bg-rose-600 group-hover:text-white',
            svg: '<path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m0-10.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.75c0 5.592 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.57-.598-3.75h-.152c-3.196 0-6.1-1.25-8.25-3.286zm0 13.036h.008v.008H12v-.008z" />'
          };
        }
        return {
          bg: 'bg-cyan-50 text-cyan-700 border-cyan-200 group-hover:bg-cyan-600 group-hover:text-white',
          svg: '<path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />'
        };
      }
    %>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <% docsList.forEach((doc, idx) => { 
            const iconData = getDocIconSvg(doc, idx);
        %>
            <div class="bg-white border border-slate-200/80 rounded-2xl p-7 hover:shadow-xl transition-all duration-300 group flex flex-col justify-between hover:border-blue-400 relative overflow-hidden">
                <div class="absolute -right-12 -top-12 w-28 h-28 rounded-full bg-slate-50 group-hover:bg-blue-50/50 transition-colors pointer-events-none"></div>

                <div>
                    <!-- Vector SVG Badge -->
                    <div class="w-14 h-14 rounded-2xl <%= iconData.bg %> border flex items-center justify-center transition-all duration-300 shadow-sm mb-6 group-hover:scale-105">
                        <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                            <%- iconData.svg %>
                        </svg>
                    </div>

                    <div class="flex items-center gap-2 mb-2">
                        <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400">PDF Document</span>
                        <span class="w-1 h-1 rounded-full bg-slate-300"></span>
                        <span class="text-[10px] font-bold uppercase tracking-wider text-emerald-600">Official</span>
                    </div>

                    <h3 class="font-extrabold text-lg text-slate-900 mb-2 group-hover:text-blue-700 transition-colors leading-snug">
                        <%= doc.title %>
                    </h3>

                    <p class="text-xs text-slate-600 leading-relaxed">
                        <%= doc.description %>
                    </p>
                </div>

                <!-- Download CTA Bar -->
                <div class="mt-8 pt-5 border-t border-slate-100 flex items-center justify-between">
                    <span class="text-[11px] text-slate-400 font-medium flex items-center gap-1">
                        <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                        Verified
                    </span>
                    <% 
                       const isCatalogueOrProfile = doc.title && (doc.title.toLowerCase().includes('catalogue') || doc.title.toLowerCase().includes('catalog') || doc.title.toLowerCase().includes('company profile'));
                       const hasSpecificFile = doc.fileUrl && doc.fileUrl !== '#' && (isCatalogueOrProfile || !doc.fileUrl.includes('Catalog Solanki Pipes.pdf'));
                    %>
                    <% if (hasSpecificFile) { %>
                    <a href="<%= doc.fileUrl %>" download target="_blank"
                       class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-wider px-4 py-2.5 rounded-xl bg-blue-50 text-blue-700 hover:bg-blue-600 hover:text-white transition-all duration-200 shadow-sm group-hover:bg-blue-600 group-hover:text-white">
                        <span>Download</span>
                        <svg class="w-4 h-4 transform group-hover:translate-y-0.5 transition-transform" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3"></path>
                        </svg>
                    </a>
                    <% } else { %>
                    <span class="inline-flex items-center gap-1.5 text-xs font-semibold px-3 py-1.5 rounded-lg bg-slate-100 text-slate-500">
                        <span>Available on Request</span>
                    </span>
                    <% } %>
                </div>
            </div>
        <% }) %>
    </div>
</main>

<%- include('partials/footer') %>
