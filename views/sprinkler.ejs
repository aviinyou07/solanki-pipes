                        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
                    </div>
                    <span class="text-sm font-black tracking-wider uppercase">TEA & COFFEE PLANTATIONS</span>
                </div>

                <div class="flex items-center gap-4 bg-white/60 backdrop-blur border border-slate-200/80 px-5 py-3.5 rounded-2xl shadow-sm">
                    <div class="w-9 h-9 rounded-xl bg-sky-50 text-[#0284c7] flex items-center justify-center shrink-0">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"/></svg>
                    </div>
                    <span class="text-sm font-black tracking-wider uppercase">WATER CONSERVATION</span>
                </div>

            </div>

        </div>
    </section>

    <!-- ========================================== -->
    <!-- 11. EXPLORE OTHER PRODUCTS -->
    <!-- ========================================== -->
    <section class="max-w-7xl mx-auto px-4 sm:px-8 lg:px-12 py-12">
        <h3 class="text-center font-black text-2xl sm:text-3xl mb-8 uppercase text-slate-900 tracking-tight">
            Explore Other Products
        </h3>
        <div class="flex flex-wrap justify-center gap-8 md:gap-12">
            <% if (typeof products !== 'undefined' && products.length > 0) { %>
                <% products.filter(p => !product || (p._id !== product._id && p.id !== 'sprinkler' && p._id !== 'sprinkler')).forEach(p => { %>
                    <a class="group flex flex-col gap-4 items-center justify-center text-center cursor-pointer bg-white p-6 rounded-2xl border border-slate-200/90 shadow-sm hover:border-sky-300 hover:shadow-md transition-all w-64"
                        href="<%= p.link || '/' + p.slug %>">
                        <img alt="<%= p.name %>" class="w-40 h-28 object-contain transition-transform duration-300 group-hover:scale-105"
                            src="<%= p.hoverImage || p.mainImage %>">
                        <p class="text-sm group-hover:text-[#0284c7] font-extrabold text-slate-900 transition-colors uppercase tracking-wide"><%= p.name %></p>
                    </a>
                <% }) %>
            <% } %>

            <a class="group flex flex-col gap-4 items-center justify-center text-center cursor-pointer bg-white p-6 rounded-2xl border border-slate-200/90 shadow-sm hover:border-sky-300 hover:shadow-md transition-all w-64" href="/hdpe">
                <img alt="HDPE Pipes" class="w-40 h-28 object-contain transition-transform duration-300 group-hover:scale-105" src="/images/product_01.png">
                <p class="text-sm group-hover:text-[#0284c7] font-extrabold text-slate-900 transition-colors uppercase tracking-wide">HDPE PIPES (IS 4984)</p>
            </a>

            <a class="group flex flex-col gap-4 items-center justify-center text-center cursor-pointer bg-white p-6 rounded-2xl border border-slate-200/90 shadow-sm hover:border-sky-300 hover:shadow-md transition-all w-64" href="/">
                <div class="w-40 h-28 flex items-center justify-center bg-sky-50 rounded-xl group-hover:bg-[#0284c7] transition-colors">
                    <svg class="w-10 h-10 text-[#0284c7] group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
                    </svg>
                </div>
                <p class="text-sm group-hover:text-[#0284c7] font-extrabold text-slate-900 transition-colors uppercase tracking-wide">BACK TO HOME</p>
            </a>
        </div>
    </section>

</div>

