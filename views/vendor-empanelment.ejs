<%- include('partials/header') %>

<header class="py-16 px-8 max-w-7xl mx-auto text-center">
    <h1 class="text-4xl md:text-6xl font-bold tracking-tight text-black mb-4 uppercase">
        <%= (typeof pageData !== 'undefined' && pageData && pageData.headerTitle) ? pageData.headerTitle : 'VENDOR EMPANELMENT' %>
    </h1>
    <p class="text-xl md:text-2xl font-light mt-2 text-gray-700">
        <%= (typeof pageData !== 'undefined' && pageData && pageData.headerSubtitle) ? pageData.headerSubtitle : 'Join our growing network of distributors and partners' %>
    </p>
</header>

<main class="max-w-7xl mx-auto px-8 py-10 mb-20">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
        
        <div>
            <h2 class="text-3xl font-bold mb-6 text-blue-900">
                <%= (typeof pageData !== 'undefined' && pageData && pageData.empanelmentTitle) ? pageData.empanelmentTitle : 'Current Empanelment List' %>
            </h2>
            <p class="text-gray-700 mb-8 leading-relaxed text-base">
                <%= (typeof pageData !== 'undefined' && pageData && pageData.empanelmentIntro) ? pageData.empanelmentIntro : 'Solanki Industries is proud to be empanelled and approved by various government departments, water boards, and private infrastructural companies across North India. We are continuously expanding our reach to serve more regions efficiently.' %>
            </p>
            <% 
              const deptList = (typeof pageData !== 'undefined' && pageData && pageData.approvedDepartments && pageData.approvedDepartments.length) ? pageData.approvedDepartments : [
                'Dakshin Haryana Bijli Vitran Nigam Limited (DHBVN) - Haryana (Underground HDPE Pipe Category)',
                'Public Health Engineering Department (PHED) - Haryana',
                'Water Supply & Sanitation Departments',
                'Panchayati Raj Institutions',
                'Major EPC Contractors',
                'Agriculture and Irrigation Departments'
              ];
            %>
            <ul class="space-y-4 text-gray-800 font-semibold">
                <% deptList.forEach(dept => { %>
                    <li class="flex items-start gap-3 bg-blue-50/50 p-4 rounded-xl border border-blue-100">
                        <svg class="w-5 h-5 text-blue-600 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
                        </svg>
                        <span><%= dept %></span>
                    </li>
                <% }) %>
            </ul>
        </div>

        <div class="bg-gray-50 p-8 md:p-10 rounded-2xl border border-gray-200 shadow-sm">
            <h2 class="text-2xl font-bold mb-6 text-blue-900">
                <%= (typeof pageData !== 'undefined' && pageData && pageData.formTitle) ? pageData.formTitle : 'Distributor / Vendor Application' %>
            </h2>
            <form action="mailto:<%= (typeof pageData !== 'undefined' && pageData && pageData.formRecipientEmail) ? pageData.formRecipientEmail : 'sales@solankipipes.com' %>" method="post" enctype="text/plain" class="grid grid-cols-1 gap-6">
                <div>
                    <input type="text" name="Company Name" required placeholder="COMPANY NAME *" class="w-full border border-gray-300 rounded-lg py-3 px-4 focus:outline-none focus:border-blue-500 text-sm placeholder-gray-400 bg-white">
                </div>
                <div>
                    <input type="text" name="Contact Person" required placeholder="CONTACT PERSON *" class="w-full border border-gray-300 rounded-lg py-3 px-4 focus:outline-none focus:border-blue-500 text-sm placeholder-gray-400 bg-white">
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <input type="email" name="Email" required placeholder="EMAIL *" class="w-full border border-gray-300 rounded-lg py-3 px-4 focus:outline-none focus:border-blue-500 text-sm placeholder-gray-400 bg-white">
                    <input type="text" name="Mobile" required placeholder="MOBILE *" class="w-full border border-gray-300 rounded-lg py-3 px-4 focus:outline-none focus:border-blue-500 text-sm placeholder-gray-400 bg-white">
                </div>
                <div>
                    <input type="text" name="City/State" required placeholder="CITY / STATE *" class="w-full border border-gray-300 rounded-lg py-3 px-4 focus:outline-none focus:border-blue-500 text-sm placeholder-gray-400 bg-white">
                </div>
                <div>
                    <select name="Application Type" class="w-full border border-gray-300 rounded-lg py-3 px-4 focus:outline-none focus:border-blue-500 text-sm text-gray-500 bg-white">
                        <option value="" disabled selected>APPLICATION TYPE</option>
                        <option value="Distributorship">Distributorship</option>
                        <option value="Dealership">Dealership</option>
                        <option value="Raw Material Vendor">Raw Material Vendor</option>
                    </select>
                </div>
                <div>
                    <textarea name="Message" placeholder="BRIEF ABOUT YOUR BUSINESS" rows="4" class="w-full border border-gray-300 rounded-lg py-3 px-4 focus:outline-none focus:border-blue-500 text-sm placeholder-gray-400 resize-none bg-white"></textarea>
                </div>
                
                <div class="pt-2">
                    <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white rounded-xl w-full h-12 flex items-center justify-center shadow-lg transition duration-300">
                        <span class="text-sm font-bold uppercase tracking-wider">Submit Application</span>
                    </button>
                </div>
            </form>
        </div>

    </div>
</main>

<%- include('partials/footer') %>
