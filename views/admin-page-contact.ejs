<%- include('partials/admin-header') %>

    <div class="flex-grow p-4 max-w-7xl w-full mx-auto">
        <!-- Header -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
            <div>
                <div class="flex items-center gap-2 text-xs font-bold text-slate-400 uppercase tracking-widest mb-1">
                    <a href="/admin/pages" class="hover:text-blue-600 transition">Pages</a>
                    <span>/</span>
                    <span class="text-blue-600">Contact Us</span>
                </div>
                <h1 class="text-3xl font-extrabold text-gray-900 uppercase tracking-tight">Customize <span
                        class="text-blue-600">Contact Us</span></h1>
                <p class="text-gray-500 text-sm mt-1">Manage corporate addresses, contact numbers, WhatsApp button, and
                    inquiry form lead destination.</p>
            </div>
            <div class="flex items-center gap-3">
                <a href="/contact" target="_blank"
                    class="bg-white hover:bg-slate-50 text-slate-700 border border-slate-200 font-bold py-2.5 px-4 rounded-xl shadow-sm transition flex items-center gap-2 text-xs">
                    <span>View Live Page</span>
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round"
                            d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25">
                        </path>
                    </svg>
                </a>
                <button type="submit" form="contactForm"
                    class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-2.5 px-6 rounded-xl shadow-md transition flex items-center gap-2 text-sm">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                    </svg>
                    <span>Save All Changes</span>
                </button>
            </div>
        </div>

        <!-- Edit Form -->
        <form id="contactForm" action="/admin/pages/contact" method="POST" class="space-y-8">

            <!-- 1. HEADER SECTION -->
            <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm overflow-hidden">
                <div class="p-6 border-b border-slate-100 bg-slate-50/50 flex items-center justify-between">
                    <div>
                        <h2
                            class="text-base font-extrabold text-slate-800 uppercase tracking-wide flex items-center gap-2">
                            <span class="w-2.5 h-2.5 rounded-full bg-blue-600"></span>
                            1. Contact Header Banner
                        </h2>
                        <p class="text-xs text-slate-400 mt-0.5">Top bold headline displayed on the contact page</p>
                    </div>
                </div>
                <div class="p-6">
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
                        <div>
                            <label class="block text-xs font-bold text-slate-700 mb-1.5 uppercase">Title Part 1
                                (Bold)</label>
                            <input type="text" name="titlePart1" value="<%= data.titlePart1 || 'CONTACTING' %>"
                                class="w-full text-sm border border-slate-200 rounded-xl px-4 py-2.5 focus:outline-none focus:border-blue-500 bg-white">
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-slate-700 mb-1.5 uppercase">Title Part 2
                                (Light)</label>
                            <input type="text" name="titlePart2" value="<%= data.titlePart2 || 'SOLANKI' %>"
                                class="w-full text-sm border border-slate-200 rounded-xl px-4 py-2.5 focus:outline-none focus:border-blue-500 bg-white">
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-slate-700 mb-1.5 uppercase">Header
                                Subtitle</label>
                            <input type="text" name="subtitle"
                                value="<%= data.subtitle || 'First Step to Excellence.' %>"
                                class="w-full text-sm border border-slate-200 rounded-xl px-4 py-2.5 focus:outline-none focus:border-blue-500 bg-white">
                        </div>
                    </div>
                </div>
            </div>

            <!-- 2. OFFICE LOCATIONS -->
            <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm overflow-hidden">
                <div class="p-6 border-b border-slate-100 bg-slate-50/50 flex items-center justify-between">
                    <div>
                        <h2
                            class="text-base font-extrabold text-slate-800 uppercase tracking-wide flex items-center gap-2">
                            <span class="w-2.5 h-2.5 rounded-full bg-blue-600"></span>
                            2. Office & Manufacturing Locations
                        </h2>
                        <p class="text-xs text-slate-400 mt-0.5">Physical facility addresses and business entities</p>
                    </div>
                </div>
                <div class="p-6 space-y-6">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <!-- Head Office -->
                        <div class="border border-slate-200 rounded-xl p-5 bg-slate-50/40">
                            <span
                                class="inline-block text-[10px] font-bold text-blue-700 bg-blue-50 px-2 py-0.5 rounded uppercase mb-3">Head
                                Office Card</span>
                            <div class="space-y-4">
                                <div>
                                    <label class="block text-[11px] font-bold text-slate-700 mb-1 uppercase">Card
                                        Title</label>
                                    <input type="text" name="headOfficeTitle"
                                        value="<%= data.headOfficeTitle || 'Head Office' %>"
                                        class="w-full text-xs border border-slate-200 rounded-lg px-3 py-2 bg-white focus:outline-none focus:border-blue-500 font-bold">
                                </div>
                                <div>
                                    <label class="block text-[11px] font-bold text-slate-700 mb-1 uppercase">Firm /
                                        Entity Name</label>
                                    <input type="text" name="headOfficeFirm" value="<%= data.headOfficeFirm || '' %>"
                                        class="w-full text-xs border border-slate-200 rounded-lg px-3 py-2 bg-white focus:outline-none focus:border-blue-500">
                                </div>
                                <div>
                                    <label class="block text-[11px] font-bold text-slate-700 mb-1 uppercase">Address
                                        (Line breaks supported)</label>
                                    <textarea name="headOfficeAddress" rows="3"
                                        class="w-full text-xs border border-slate-200 rounded-lg p-2.5 bg-white focus:outline-none focus:border-blue-500 resize-y"><%= data.headOfficeAddress || '' %></textarea>
                                </div>
                            </div>
                        </div>

                        <!-- Manufacturing Unit -->
                        <div class="border border-slate-200 rounded-xl p-5 bg-slate-50/40">
                            <span
                                class="inline-block text-[10px] font-bold text-cyan-700 bg-cyan-50 px-2 py-0.5 rounded uppercase mb-3">Plant
                                Unit Card</span>
                            <div class="space-y-4">
                                <div>
                                    <label class="block text-[11px] font-bold text-slate-700 mb-1 uppercase">Card
                                        Title</label>
                                    <input type="text" name="manufacturingTitle"
                                        value="<%= data.manufacturingTitle || 'Manufacturing Unit' %>"
                                        class="w-full text-xs border border-slate-200 rounded-lg px-3 py-2 bg-white focus:outline-none focus:border-blue-500 font-bold">
                                </div>
                                <div>
                                    <label class="block text-[11px] font-bold text-slate-700 mb-1 uppercase">Plant
                                        Address (Line breaks supported)</label>
                                    <textarea name="manufacturingAddress" rows="5"
                                        class="w-full text-xs border border-slate-200 rounded-lg p-2.5 bg-white focus:outline-none focus:border-blue-500 resize-y"><%= data.manufacturingAddress || '' %></textarea>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 3. DIRECT CONTACTS & INQUIRY FORM -->
            <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm overflow-hidden">
                <div class="p-6 border-b border-slate-100 bg-slate-50/50 flex items-center justify-between">
                    <div>
                        <h2
                            class="text-base font-extrabold text-slate-800 uppercase tracking-wide flex items-center gap-2">
                            <span class="w-2.5 h-2.5 rounded-full bg-blue-600"></span>
                            3. Communication Channels & Project Pipeline Form
                        </h2>
                        <p class="text-xs text-slate-400 mt-0.5">Direct phone numbers, email addresses, and the
                            quotation form headline</p>
                    </div>
                </div>
                <div class="p-6 space-y-6">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                        <div>
                            <label class="block text-xs font-bold text-slate-700 mb-1.5 uppercase">Primary Phone</label>
                            <input type="text" name="phone1" value="<%= data.phone1 || '' %>"
                                class="w-full text-sm border border-slate-200 rounded-xl px-4 py-2.5 focus:outline-none focus:border-blue-500 bg-white">
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-slate-700 mb-1.5 uppercase">Secondary
                                Phone</label>
                            <input type="text" name="phone2" value="<%= data.phone2 || '' %>"
                                class="w-full text-sm border border-slate-200 rounded-xl px-4 py-2.5 focus:outline-none focus:border-blue-500 bg-white">
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-slate-700 mb-1.5 uppercase">Sales Email</label>
                            <input type="email" name="email" value="<%= data.email || '' %>"
                                class="w-full text-sm border border-slate-200 rounded-xl px-4 py-2.5 focus:outline-none focus:border-blue-500 bg-white">
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-slate-700 mb-1.5 uppercase">WhatsApp Button
                                Label</label>
                            <input type="text" name="whatsappBtnText"
                                value="<%= data.whatsappBtnText || 'Chat on WhatsApp' %>"
                                class="w-full text-sm border border-slate-200 rounded-xl px-4 py-2.5 focus:outline-none focus:border-blue-500 bg-white">
                        </div>
                        <div class="md:col-span-2">
                            <label class="block text-xs font-bold text-slate-700 mb-1.5 uppercase">Form Section
                                Headline</label>
                            <textarea name="formHeading" rows="2"
                                class="w-full text-sm border border-slate-200 rounded-xl p-3 focus:outline-none focus:border-blue-500 bg-white resize-y"><%= data.formHeading || '' %></textarea>
                        </div>
                        <div class="md:col-span-2">
                            <label class="block text-xs font-bold text-slate-700 mb-1.5 uppercase">Form Subtitle /
                                Instructions</label>
                            <input type="text" name="formSubheading" value="<%= data.formSubheading || '' %>"
                                class="w-full text-sm border border-slate-200 rounded-xl px-4 py-2.5 focus:outline-none focus:border-blue-500 bg-white">
                        </div>
                    </div>
                </div>
            </div>

            <!-- Sticky Bottom Actions -->
            <div
                class="sticky bottom-6 z-30 bg-white/95 backdrop-blur-md p-4 rounded-2xl border border-slate-200 shadow-xl flex items-center justify-between">
                <span class="text-xs text-slate-500 font-medium">Changes will instantly update the Contact Us
                    page.</span>
                <button type="submit"
                    class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-2.5 px-6 rounded-xl shadow-md transition flex items-center gap-2 text-sm">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                    </svg>
                    <span>Save All Changes</span>
                </button>
            </div>

        </form>
    </div>

    <%- include('partials/admin-footer') %>