<%- include('partials/admin-header') %>

<div class="p-4 sm:p-6 md:p-8 max-w-6xl mx-auto space-y-6">

    <!-- Breadcrumb & Top Bar -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 pb-4 border-b border-slate-200">
        <div>
            <div class="flex items-center gap-2 text-xs font-semibold text-slate-500 mb-1">
                <span>Admin</span>
                <span class="text-slate-300">/</span>
                <span>Global Configuration</span>
                <span class="text-slate-300">/</span>
                <span class="text-blue-600">Promotional Popup</span>
            </div>
            <div class="flex items-center gap-3">
                <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
                    Promotional <span class="text-blue-600">Popup Modal</span>
                </h1>
                <% if (popup && popup.enabled) { %>
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-100 text-emerald-800 border border-emerald-200">
                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-600 animate-pulse"></span>
                        Active on Home Page
                    </span>
                <% } else { %>
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-bold bg-slate-100 text-slate-600 border border-slate-200">
                        <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>
                        Disabled
                    </span>
                <% } %>
            </div>
            <p class="text-slate-500 text-xs sm:text-sm mt-1">
                Control the announcement or promotional modal dialog displayed to visitors when they land on or refresh the home page.
            </p>
        </div>

        <div class="flex items-center gap-2 shrink-0">
            <!-- Test Preview Button -->
            <button type="button"
                    id="btn-admin-preview-modal"
                    class="inline-flex items-center gap-2 px-4 py-2 rounded-xl border border-slate-300 bg-white hover:bg-slate-50 text-slate-700 font-bold text-xs shadow-xs transition">
                <svg class="w-4 h-4 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                </svg>
                <span>Live Test Preview</span>
            </button>

            <!-- Visit Live Website -->
            <a href="/" target="_blank"
               class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-slate-900 hover:bg-slate-800 text-white font-bold text-xs shadow-xs transition">
                <span>View Live Site</span>
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
            </a>
        </div>
    </div>

    <!-- Feedback Notifications -->
    <% if (query && query.saved === 'true') { %>
        <div class="p-4 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 flex items-center justify-between text-xs sm:text-sm font-semibold shadow-xs animate-fadeIn">
            <div class="flex items-center gap-2">
                <svg class="w-5 h-5 text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <span>Promotional popup modal configuration successfully saved and published!</span>
            </div>
            <a href="/" target="_blank" class="underline text-emerald-900 font-bold hover:text-emerald-700">Check Home Page ↗</a>
        </div>
    <% } %>

    <% if (query && query.error) { %>
        <div class="p-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 flex items-center gap-2 text-xs sm:text-sm font-semibold shadow-xs">
            <svg class="w-5 h-5 text-rose-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
            <span>Error saving popup: <%= query.error %></span>
        </div>
    <% } %>

    <!-- Main Configuration Form -->
    <form id="popup-admin-form"
          action="/admin/popup"
          method="POST"
          enctype="multipart/form-data"
          class="space-y-6">

        <!-- Section 1: Activation & Trigger Frequency -->
        <div class="bg-white rounded-2xl border border-slate-200/90 shadow-xs overflow-hidden">
            <div class="px-5 py-4 bg-slate-50 border-b border-slate-100 flex items-center justify-between">
                <div class="flex items-center gap-2.5">
                    <div class="w-8 h-8 rounded-lg bg-blue-100 text-blue-600 flex items-center justify-center font-bold text-sm">
                        1
                    </div>
                    <div>
                        <h2 class="text-sm font-bold text-slate-800">Display Activation & Frequency</h2>
                        <p class="text-[11px] text-slate-500">Enable or disable the popup and choose how often visitors see it.</p>
                    </div>
                </div>

                <!-- Enabled Status Toggle Switch -->
                <div class="flex items-center gap-3">
                    <span class="text-xs font-bold text-slate-700" id="enabled-label">
                        <%= (popup && popup.enabled) ? 'Enabled' : 'Disabled' %>
                    </span>
                    <label class="relative inline-flex items-center cursor-pointer">
                        <input type="checkbox"
                               name="enabled"
                               value="true"
                               id="popup-enabled-input"
                               class="sr-only peer"
                               <%= (popup && popup.enabled) ? 'checked' : '' %>
                               onchange="document.getElementById('enabled-label').textContent = this.checked ? 'Enabled' : 'Disabled'">
                        <div class="w-11 h-6 bg-slate-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-emerald-600"></div>
                    </label>
                </div>
            </div>

            <div class="p-5 sm:p-6 grid grid-cols-1 md:grid-cols-2 gap-5">
                <!-- Display Frequency Setting -->
                <div>
                    <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">
                        Display Frequency on Home Page
                    </label>
                    <select name="frequency"
                            id="popup-frequency-input"
                            class="w-full text-xs font-medium rounded-xl border-slate-300 shadow-xs focus:border-blue-500 focus:ring-blue-500 bg-white py-2.5 px-3">
                        <option value="every_refresh" <%= (!popup || !popup.frequency || popup.frequency === 'every_refresh' || popup.displayFrequency === 'every_refresh') ? 'selected' : '' %>>
                            Every Page Visit / Refresh (Always Show) — Recommended for testing
                        </option>
                        <option value="once_session" <%= (popup && (popup.frequency === 'once_session' || popup.displayFrequency === 'once_session')) ? 'selected' : '' %>>
                            Once per Browser Session (Disappears after closing until browser restarts)
                        </option>
                        <option value="once_day" <%= (popup && (popup.frequency === 'once_day' || popup.displayFrequency === 'once_day')) ? 'selected' : '' %>>
                            Once per 24 Hours (Only once a day per device)
                        </option>
                    </select>
                    <p class="text-[11px] text-slate-400 mt-1">Select "Every Page Visit / Refresh" to verify changes immediately upon refresh.</p>
                </div>

                <!-- Display Delay -->
                <div>
                    <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">
                        Display Delay (Seconds)
                    </label>
                    <div class="flex items-center gap-2">
                        <input type="number"
                               step="0.1"
                               min="0"
                               max="10"
                               name="delaySeconds"
                               id="popup-delay-input"
                               value="<%= (popup && popup.delaySeconds !== undefined) ? popup.delaySeconds : 0.5 %>"
                               class="w-full text-xs font-medium rounded-xl border-slate-300 shadow-xs focus:border-blue-500 focus:ring-blue-500 py-2 px-3"
                               placeholder="e.g. 0.5">
                        <span class="text-xs font-bold text-slate-500 shrink-0">sec</span>
                    </div>
                    <p class="text-[11px] text-slate-400 mt-1">How many seconds after visitor lands before modal smoothly fades in (default: 0.5s).</p>
                </div>
            </div>
        </div>

        <!-- Section 2: Headline, Badge & Description -->
        <div class="bg-white rounded-2xl border border-slate-200/90 shadow-xs overflow-hidden">
            <div class="px-5 py-4 bg-slate-50 border-b border-slate-100 flex items-center gap-2.5">
                <div class="w-8 h-8 rounded-lg bg-blue-100 text-blue-600 flex items-center justify-center font-bold text-sm">
                    2
                </div>
                <div>
                    <h2 class="text-sm font-bold text-slate-800">Badge & Announcement Content</h2>
                    <p class="text-[11px] text-slate-500">Configure the top badge pill, primary title with accented highlight, and body paragraph.</p>
                </div>
            </div>

            <div class="p-5 sm:p-6 space-y-5">
                <!-- Badge Pill Controls -->
                <div class="grid grid-cols-1 md:grid-cols-12 gap-4">
                    <div class="md:col-span-8">
                        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">
                            Badge Pill Text
                        </label>
                        <input type="text"
                               name="badgeText"
                               id="popup-badgetext-input"
                               value="<%= (popup && popup.badgeText) ? popup.badgeText : 'Special Offer' %>"
                               class="w-full text-xs font-medium rounded-xl border-slate-300 shadow-xs focus:border-blue-500 focus:ring-blue-500 py-2.5 px-3"
                               placeholder="e.g. Special Offer or Special Announcement">
                    </div>
                    <div class="md:col-span-4">
                        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">
                            Badge Pill Tone
                        </label>
                        <select name="badgeColor"
                                id="popup-badgecolor-input"
                                class="w-full text-xs font-medium rounded-xl border-slate-300 shadow-xs focus:border-blue-500 focus:ring-blue-500 bg-white py-2.5 px-3">
                            <option value="rose" <%= (!popup || !popup.badgeColor || popup.badgeColor === 'rose') ? 'selected' : '' %>>Rose / Pink (Soft Warm)</option>
                            <option value="emerald" <%= (popup && (popup.badgeColor === 'emerald' || popup.badgeColor === 'green')) ? 'selected' : '' %>>Emerald Green</option>
                            <option value="blue" <%= (popup && popup.badgeColor === 'blue') ? 'selected' : '' %>>Solanki Corporate Blue</option>
                            <option value="amber" <%= (popup && (popup.badgeColor === 'amber' || popup.badgeColor === 'orange')) ? 'selected' : '' %>>Amber / Gold</option>
                            <option value="purple" <%= (popup && popup.badgeColor === 'purple') ? 'selected' : '' %>>Purple / Violet</option>
                        </select>
                    </div>
                </div>

                <!-- Title & Highlight -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">
                            Main Headline Title
                        </label>
                        <input type="text"
                               name="title"
                               id="popup-title-input"
                               value="<%= (popup && popup.title) ? popup.title : 'High-Performance HDPE Pipes' %>"
                               class="w-full text-xs font-medium rounded-xl border-slate-300 shadow-xs focus:border-blue-500 focus:ring-blue-500 py-2.5 px-3"
                               placeholder="e.g. High-Performance HDPE Pipes">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">
                            Highlighted Accent Text <span class="text-emerald-600 font-semibold">(Rendered in Green with Flourish)</span>
                        </label>
                        <input type="text"
                               name="titleHighlight"
                               id="popup-titlehighlight-input"
                               value="<%= (popup && popup.titleHighlight) ? popup.titleHighlight : 'at Factory Best Prices!' %>"
                               class="w-full text-xs font-medium rounded-xl border-slate-300 shadow-xs focus:border-blue-500 focus:ring-blue-500 py-2.5 px-3"
                               placeholder="e.g. at Factory Best Prices!">
                    </div>
                </div>

                <!-- Description Paragraph -->
                <div>
                    <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">
                        Description / Announcement Details
                    </label>
                    <textarea name="description"
                              id="popup-desc-input"
                              rows="3"
                              class="w-full text-xs font-medium rounded-xl border-slate-300 shadow-xs focus:border-blue-500 focus:ring-blue-500 py-2.5 px-3"
                              placeholder="Describe your promotion, offer, or update in a few concise sentences..."><%= (popup && popup.description) ? popup.description : '' %></textarea>
                </div>
            </div>
        </div>

        <!-- Section 3: Call to Action (CTA Button) -->
        <div class="bg-white rounded-2xl border border-slate-200/90 shadow-xs overflow-hidden">
            <div class="px-5 py-4 bg-slate-50 border-b border-slate-100 flex items-center gap-2.5">
                <div class="w-8 h-8 rounded-lg bg-blue-100 text-blue-600 flex items-center justify-center font-bold text-sm">
                    3
                </div>
                <div>
                    <h2 class="text-sm font-bold text-slate-800">Action Button (CTA)</h2>
                    <p class="text-[11px] text-slate-500">Define the button text, target link, and styling.</p>
                </div>
            </div>

            <div class="p-5 sm:p-6 grid grid-cols-1 md:grid-cols-3 gap-4">
                <div>
                    <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">
                        Button Label
                    </label>
                    <input type="text"
                           name="buttonText"
                           id="popup-btntext-input"
                           value="<%= (popup && (popup.buttonText || popup.ctaText)) ? (popup.buttonText || popup.ctaText) : 'Explore Products' %>"
                           class="w-full text-xs font-medium rounded-xl border-slate-300 shadow-xs focus:border-blue-500 focus:ring-blue-500 py-2.5 px-3"
                           placeholder="e.g. Shop Now or Explore Products">
                </div>

                <div>
                    <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">
                        Button Destination Link
                    </label>
                    <input type="text"
                           name="buttonLink"
                           id="popup-btnlink-input"
                           value="<%= (popup && (popup.buttonLink || popup.ctaLink)) ? (popup.buttonLink || popup.ctaLink) : '/hdpe' %>"
                           class="w-full text-xs font-medium rounded-xl border-slate-300 shadow-xs focus:border-blue-500 focus:ring-blue-500 py-2.5 px-3"
                           placeholder="e.g. /hdpe, /products or /contact">
                </div>

                <div>
                    <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">
                        Button Color Theme
                    </label>
                    <select name="buttonColor"
                            id="popup-btncolor-input"
                            class="w-full text-xs font-medium rounded-xl border-slate-300 shadow-xs focus:border-blue-500 focus:ring-blue-500 bg-white py-2.5 px-3">
                        <option value="emerald" <%= (!popup || !popup.buttonColor || popup.buttonColor === 'emerald' || popup.ctaColor === 'emerald') ? 'selected' : '' %>>Vibrant Emerald (Mockup Style)</option>
                        <option value="blue" <%= (popup && (popup.buttonColor === 'blue' || popup.ctaColor === 'blue')) ? 'selected' : '' %>>Corporate Royal Blue</option>
                        <option value="dark" <%= (popup && (popup.buttonColor === 'dark' || popup.ctaColor === 'dark')) ? 'selected' : '' %>>Dark Slate / Charcoal</option>
                    </select>
                </div>
            </div>
        </div>

        <!-- Section 4: Promotional Image -->
        <div class="bg-white rounded-2xl border border-slate-200/90 shadow-xs overflow-hidden">
            <div class="px-5 py-4 bg-slate-50 border-b border-slate-100 flex items-center gap-2.5">
                <div class="w-8 h-8 rounded-lg bg-blue-100 text-blue-600 flex items-center justify-center font-bold text-sm">
                    4
                </div>
                <div>
                    <h2 class="text-sm font-bold text-slate-800">Promotional Image</h2>
                    <p class="text-[11px] text-slate-500">Upload a new image or specify an image URL for the left card banner.</p>
                </div>
            </div>

            <div class="p-5 sm:p-6 grid grid-cols-1 md:grid-cols-12 gap-6 items-center">
                <!-- Preview Thumbnail -->
                <div class="md:col-span-4 flex flex-col items-center">
                    <span class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2 self-start">Current Preview</span>
                    <% const currentImg = (popup && (popup.imageUrl || popup.image)) ? (popup.imageUrl || popup.image) : '/images/sp_img1.jpeg'; %>
                    <div class="w-full max-w-[240px] h-48 rounded-2xl overflow-hidden bg-slate-100 border-2 border-dashed border-slate-300 flex items-center justify-center relative shadow-xs">
                        <img id="admin-preview-img-display"
                             src="<%= currentImg %>"
                             alt="Current popup image"
                             class="w-full h-full object-cover">
                    </div>
                </div>

                <!-- Upload and URL inputs -->
                <div class="md:col-span-8 space-y-4">
                    <!-- File Upload Input -->
                    <div>
                        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">
                            Upload New Image
                        </label>
                        <input type="file"
                               name="popupImage"
                               id="popup-file-input"
                               accept="image/png, image/jpeg, image/webp"
                               class="block w-full text-xs text-slate-500 file:mr-4 file:py-2.5 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-bold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100 cursor-pointer border border-slate-200 rounded-xl p-1 bg-slate-50/50">
                        <p class="text-[11px] text-slate-400 mt-1">Recommended: Clean product photograph, square or 4:5 aspect ratio (e.g. 600×600 or 800×800).</p>
                    </div>

                    <!-- Direct Image URL Input -->
                    <div>
                        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">
                            Or Image URL Path
                        </label>
                        <input type="text"
                               name="imageUrl"
                               id="popup-imgurl-input"
                               value="<%= currentImg %>"
                               class="w-full text-xs font-medium rounded-xl border-slate-300 shadow-xs focus:border-blue-500 focus:ring-blue-500 py-2.5 px-3 font-mono"
                               placeholder="e.g. /images/sp_img1.jpeg">
                    </div>
                </div>
            </div>
        </div>

        <!-- Submit & Quick Action Bar -->
        <div class="sticky bottom-4 z-20 bg-white/95 backdrop-blur-md p-4 rounded-2xl border border-slate-200 shadow-lg flex items-center justify-between">
            <div class="text-xs text-slate-500 flex items-center gap-2">
                <svg class="w-4 h-4 text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <span>Changes take effect immediately on the live website upon saving.</span>
            </div>

            <div class="flex items-center gap-3">
                <button type="button"
                        id="btn-live-test-bottom"
                        class="px-4 py-2 rounded-xl border border-slate-300 bg-white hover:bg-slate-50 text-slate-700 font-bold text-xs shadow-xs transition">
                    Test Preview
                </button>
                <button type="submit"
                        class="px-6 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs shadow-md hover:shadow-lg transition flex items-center gap-2">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                    </svg>
                    <span>Save Popup Configuration</span>
                </button>
            </div>
        </div>

    </form>
</div>

<!-- ========================================== -->
<!-- IN-ADMIN INTERACTIVE PREVIEW MODAL         -->
<!-- ========================================== -->
<div id="admin-test-modal"
     class="fixed inset-0 z-[10000] flex items-center justify-center p-3 sm:p-5 md:p-6 transition-all duration-300 opacity-0 pointer-events-none hidden"
     role="dialog"
     aria-modal="true">

  <!-- Backdrop -->
  <div id="admin-test-backdrop"
       class="absolute inset-0 bg-slate-950/60 backdrop-blur-sm transition-opacity duration-300"></div>

  <!-- Dialog Card -->
  <div id="admin-test-card"
       class="relative bg-white rounded-3xl sm:rounded-[32px] shadow-2xl border border-slate-100 max-w-[680px] w-full overflow-hidden transform scale-95 transition-all duration-300 ease-out z-10">

    <!-- Close Button -->
    <button id="admin-test-close"
            type="button"
            class="absolute top-3 right-3 sm:top-4 sm:right-4 z-30 w-8 h-8 sm:w-9 sm:h-9 rounded-full bg-slate-100/90 hover:bg-slate-200 text-slate-500 hover:text-slate-800 flex items-center justify-center transition shadow-sm focus:outline-none">
      <svg class="w-4 h-4 sm:w-4.5 sm:h-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M18 6L6 18M6 6l12 12"/>
      </svg>
    </button>

    <!-- Grid -->
    <div class="grid grid-cols-1 md:grid-cols-12 items-stretch">
      <!-- Left Column: Image -->
      <div class="md:col-span-5 p-3.5 sm:p-5 flex items-center justify-center bg-slate-50/70 border-b md:border-b-0 md:border-r border-slate-100">
        <div class="w-full h-48 sm:h-56 md:h-full min-h-[200px] md:min-h-[280px] rounded-2xl sm:rounded-[22px] overflow-hidden bg-white shadow-sm border border-slate-200/60 relative flex items-center justify-center">
          <img id="admin-preview-dialog-img"
               src="<%= (popup && (popup.imageUrl || popup.image)) ? (popup.imageUrl || popup.image) : '/images/sp_img1.jpeg' %>"
               alt="Announcement Preview"
               class="w-full h-full object-cover object-center" />
        </div>
      </div>

      <!-- Right Column: Content -->
      <div class="md:col-span-7 p-6 sm:p-7 md:p-8 flex flex-col justify-between relative bg-white overflow-hidden">
        <div class="relative z-10">
          <!-- Badge -->
          <div id="admin-preview-dialog-badge-wrap" class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold mb-3 border bg-rose-50 text-rose-600 border-rose-200/80">
            <svg class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z" />
            </svg>
            <span id="admin-preview-dialog-badge-text"><%= (popup && popup.badgeText) ? popup.badgeText : 'Special Offer' %></span>
          </div>

          <!-- Headline -->
          <h3 class="text-xl sm:text-2xl md:text-[25px] font-bold text-slate-900 tracking-tight leading-snug mb-3">
            <span id="admin-preview-dialog-title"><%= (popup && popup.title) ? popup.title : 'High-Performance HDPE Pipes' %></span>
            <span class="relative inline-block text-emerald-600 font-extrabold ml-1">
              <span id="admin-preview-dialog-highlight"><%= (popup && popup.titleHighlight) ? popup.titleHighlight : 'at Factory Best Prices!' %></span>
              <svg class="absolute -top-3.5 -right-2 sm:-right-3 w-6 h-4 text-emerald-500" viewBox="0 0 32 20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                <path d="M4 16 L2 4" />
                <path d="M14 14 L16 2" />
                <path d="M24 16 L28 6" />
              </svg>
            </span>
          </h3>

          <!-- Description -->
          <p id="admin-preview-dialog-desc" class="text-slate-600 text-xs sm:text-sm leading-relaxed mb-6 font-normal">
            <%= (popup && popup.description) ? popup.description : 'Supplying BIS-licensed PE80 & PE100 HDPE water and sewerage pipes directly from our plants.' %>
          </p>
        </div>

        <!-- Button -->
        <div class="relative z-10 pt-2 flex items-center">
          <a id="admin-preview-dialog-btn"
             href="#"
             onclick="return false;"
             class="inline-flex items-center justify-center gap-2 px-6 py-2.5 sm:py-3 rounded-xl sm:rounded-full font-semibold text-sm transition-all duration-200 shadow-md group bg-emerald-600 text-white">
            <span id="admin-preview-dialog-btn-text"><%= (popup && (popup.buttonText || popup.ctaText)) ? (popup.buttonText || popup.ctaText) : 'Explore Products' %></span>
            <svg class="w-4 h-4 ml-0.5 transition-transform duration-200 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.4">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
            </svg>
          </a>
        </div>

        <!-- Decorative Bottom Corner Wave -->
        <div class="pointer-events-none absolute -bottom-3 -right-3 w-40 sm:w-52 h-24 sm:h-28 opacity-60 z-0 overflow-hidden">
          <svg viewBox="0 0 200 120" fill="none" class="w-full h-full">
            <path d="M0,120 C60,90 120,120 180,60 C210,30 220,10 220,120 Z" fill="#34d399" opacity="0.4"/>
            <path d="M20,120 C80,100 140,110 190,40 C215,10 230,0 230,120 Z" fill="#059669" opacity="0.5"/>
          </svg>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  (function () {
    // DOM Elements
    const fileInput = document.getElementById('popup-file-input');
    const urlInput = document.getElementById('popup-imgurl-input');
    const adminDisplayImg = document.getElementById('admin-preview-img-display');
    const previewDialogImg = document.getElementById('admin-preview-dialog-img');

    const badgeTextInput = document.getElementById('popup-badgetext-input');
    const badgeColorInput = document.getElementById('popup-badgecolor-input');
    const titleInput = document.getElementById('popup-title-input');
    const highlightInput = document.getElementById('popup-titlehighlight-input');
    const descInput = document.getElementById('popup-desc-input');
    const btnTextInput = document.getElementById('popup-btntext-input');
    const btnColorInput = document.getElementById('popup-btncolor-input');

    const testModal = document.getElementById('admin-test-modal');
    const testCard = document.getElementById('admin-test-card');
    const testBackdrop = document.getElementById('admin-test-backdrop');
    const testClose = document.getElementById('admin-test-close');
    const btnPreviewTop = document.getElementById('btn-admin-preview-modal');
    const btnPreviewBottom = document.getElementById('btn-live-test-bottom');

    // Handle local image file upload preview
    if (fileInput) {
      fileInput.addEventListener('change', function () {
        if (this.files && this.files[0]) {
          const reader = new FileReader();
          reader.onload = function (e) {
            if (adminDisplayImg) adminDisplayImg.src = e.target.result;
            if (previewDialogImg) previewDialogImg.src = e.target.result;
          };
          reader.readAsDataURL(this.files[0]);
        }
      });
    }

    // Handle direct URL input change
    if (urlInput) {
      urlInput.addEventListener('input', function () {
        const val = this.value.trim();
        if (val) {
          if (adminDisplayImg) adminDisplayImg.src = val;
          if (previewDialogImg) previewDialogImg.src = val;
        }
      });
    }

    // Live sync form fields to test dialog
    function syncDialogFields() {
      const bText = document.getElementById('admin-preview-dialog-badge-text');
      const bWrap = document.getElementById('admin-preview-dialog-badge-wrap');
      const tSpan = document.getElementById('admin-preview-dialog-title');
      const hSpan = document.getElementById('admin-preview-dialog-highlight');
      const dPara = document.getElementById('admin-preview-dialog-desc');
      const btnSpan = document.getElementById('admin-preview-dialog-btn-text');
      const btnEl = document.getElementById('admin-preview-dialog-btn');

      if (bText && badgeTextInput) bText.textContent = badgeTextInput.value || 'Special Offer';
      if (tSpan && titleInput) tSpan.textContent = titleInput.value || '';
      if (hSpan && highlightInput) hSpan.textContent = highlightInput.value || '';
      if (dPara && descInput) dPara.textContent = descInput.value || '';
      if (btnSpan && btnTextInput) btnSpan.textContent = btnTextInput.value || 'Explore Products';

      // Badge color tone classes
      if (bWrap && badgeColorInput) {
        const tone = badgeColorInput.value;
        bWrap.className = 'inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold mb-3 border ';
        if (tone === 'emerald' || tone === 'green') {
          bWrap.className += 'bg-emerald-50 text-emerald-700 border-emerald-200/80';
        } else if (tone === 'blue') {
          bWrap.className += 'bg-blue-50 text-blue-700 border-blue-200/80';
        } else if (tone === 'amber' || tone === 'orange') {
          bWrap.className += 'bg-amber-50 text-amber-700 border-amber-200/80';
        } else if (tone === 'purple') {
          bWrap.className += 'bg-purple-50 text-purple-700 border-purple-200/80';
        } else {
          bWrap.className += 'bg-rose-50 text-rose-600 border-rose-200/80';
        }
      }

      // Button styling
      if (btnEl && btnColorInput) {
        const c = btnColorInput.value;
        btnEl.className = 'inline-flex items-center justify-center gap-2 px-6 py-2.5 sm:py-3 rounded-xl sm:rounded-full font-semibold text-sm transition-all duration-200 shadow-md group ';
        if (c === 'blue') {
          btnEl.className += 'bg-blue-600 hover:bg-blue-700 text-white';
        } else if (c === 'dark') {
          btnEl.className += 'bg-slate-900 hover:bg-slate-800 text-white';
        } else {
          btnEl.className += 'bg-emerald-600 hover:bg-emerald-700 text-white';
        }
      }
    }

    function showTestModal() {
      syncDialogFields();
      if (!testModal) return;
      testModal.classList.remove('hidden');
      void testModal.offsetWidth;
      testModal.classList.remove('opacity-0', 'pointer-events-none');
      testModal.classList.add('opacity-100');
      if (testCard) {
        testCard.classList.remove('scale-95');
        testCard.classList.add('scale-100');
      }
    }

    function hideTestModal() {
      if (!testModal) return;
      testModal.classList.remove('opacity-100');
      testModal.classList.add('opacity-0', 'pointer-events-none');
      if (testCard) {
        testCard.classList.remove('scale-100');
        testCard.classList.add('scale-95');
      }
      setTimeout(() => {
        testModal.classList.add('hidden');
      }, 300);
    }

    if (btnPreviewTop) btnPreviewTop.addEventListener('click', showTestModal);
    if (btnPreviewBottom) btnPreviewBottom.addEventListener('click', showTestModal);
    if (testClose) testClose.addEventListener('click', hideTestModal);
    if (testBackdrop) testBackdrop.addEventListener('click', hideTestModal);

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && testModal && !testModal.classList.contains('hidden')) {
        hideTestModal();
      }
    });
  })();
</script>

<%- include('partials/admin-footer') %>

