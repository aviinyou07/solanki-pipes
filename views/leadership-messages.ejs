<%- include('partials/header') %>

<%
    const d = (typeof data !== 'undefined' && data) ? data : {};
    const settings = d.settings || {};
    const carouselSettings = settings.carousel || {};
    
    // Filter active leaders
    const allLeaders = Array.isArray(d.leaders) ? d.leaders : [];
    const activeLeaders = allLeaders
        .filter(l => l.status === 'active')
        .sort((a, b) => (Number(a.displayOrder) || 0) - (Number(b.displayOrder) || 0));
        
    // Filter active action cards
    const allActions = Array.isArray(d.actionCards) ? d.actionCards : [];
    const activeActions = allActions
        .filter(c => c.status === 'active')
        .sort((a, b) => (Number(a.displayOrder) || 0) - (Number(b.displayOrder) || 0));

    // Page titles & texts
    const pageTitle = settings.pageTitle || 'Leadership Messages';
    const breadcrumbHome = settings.breadcrumbHome || 'Home';
    const breadcrumbAbout = settings.breadcrumbAbout || 'About Us';
    const breadcrumbCurrent = settings.breadcrumbCurrent || 'Leadership Messages';
    const tagline = settings.tagline || 'PIPES FOR A STRONGER TOMORROW';
    const showTagline = settings.showTagline !== false;
    
    const actionSubtitle = settings.actionSubtitle || 'INFRASTRUCTURE & IMPACT';
    const actionTitle = settings.actionTitle || 'LEADERSHIP IN ACTION';
    const actionLocationBadge = settings.actionLocationBadge || '• Fatehabad & Bhiwani Facilities';
%>

<!-- Google Fonts for Editorial Serif & Script accents -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Caveat:wght@600;700&family=Dancing+Script:wght@700&family=Playfair+Display:ital,wght@0,600;0,700;1,600&display=swap" rel="stylesheet">

<main class="bg-[#F8FAFC] min-h-screen font-sans text-slate-800" id="leadershipPage">

    <!-- Top Hero Banner -->
    <section class="relative text-white py-12 md:py-16 px-6 md:px-12 overflow-hidden border-b border-blue-900/40 shadow-inner">
        <!-- Industrial pipes background overlay -->
        <div class="absolute inset-0 bg-cover bg-center opacity-15 mix-blend-luminosity scale-105" style="background-image: url('/images/sp_img3.jpeg');"></div>
        <div class="absolute inset-0 bg-gradient-to-r from-[#071739] via-[#0B2559] to-[#051129]"></div>

        <div class="max-w-7xl mx-auto flex flex-col md:flex-row md:items-center md:justify-between gap-6 relative z-10">
            <!-- Left: Page Title & Breadcrumbs -->
            <div>
                <h1 class="text-3xl md:text-5xl font-serif text-white tracking-wide font-normal" style="font-family: 'Playfair Display', serif;">
                    <%= pageTitle %>
                </h1>
                <nav class="flex items-center space-x-2 text-xs md:text-sm text-blue-200/80 mt-3 font-medium" aria-label="Breadcrumb">
                    <a href="/" class="hover:text-white transition-colors"><%= breadcrumbHome %></a>
                    <span class="text-blue-400/60">›</span>
                    <a href="/about" class="hover:text-white transition-colors"><%= breadcrumbAbout %></a>
                    <span class="text-blue-400/60">›</span>
                    <span class="text-[#38BDF8] font-bold tracking-wide"><%= breadcrumbCurrent %></span>
                </nav>
            </div>

            <!-- Right: Tagline -->
            <% if (showTagline && tagline) { %>
            <div class="text-left md:text-right">
                <span class="text-xs md:text-sm uppercase tracking-widest text-blue-100 font-semibold block">
                    <%= tagline %>
                </span>
                <div class="h-0.5 w-24 bg-[#38BDF8] mt-2 md:ml-auto rounded-full"></div>
            </div>
            <% } %>
        </div>
    </section>

    <!-- Main Content Container -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 lg:py-16">

        <% if (activeLeaders.length === 0) { %>
            <!-- Empty State -->
            <div class="bg-white rounded-3xl p-12 text-center border border-slate-200 shadow-sm max-w-2xl mx-auto my-12">
                <div class="w-16 h-16 bg-blue-50 text-blue-600 rounded-full flex items-center justify-center mx-auto mb-4">
                    <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
                </div>
                <h3 class="text-xl font-bold text-slate-900 mb-2">No Leadership Messages Available</h3>
                <p class="text-slate-500 text-sm mb-6">Leadership profiles and messages are currently being updated. Please check back shortly.</p>
                <a href="/" class="inline-flex items-center gap-2 px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs rounded-xl transition shadow-sm">
                    <span>Return to Home</span>
                </a>
            </div>
        <% } else { %>

            <!-- Leadership Carousel Section -->
            <section class="relative mb-14" aria-label="Leadership Carousel" id="leadershipCarouselSection">

                <!-- Previous Arrow -->
                <% if (carouselSettings.showArrows !== false && activeLeaders.length > 1) { %>
                <button type="button" id="carouselPrevBtn" class="absolute -left-3 md:-left-6 top-1/2 -translate-y-1/2 z-30 w-11 h-11 md:w-12 md:h-12 bg-white text-blue-900 rounded-full shadow-xl border border-slate-200/80 flex items-center justify-center hover:bg-blue-50 hover:scale-105 active:scale-95 transition-all focus:outline-none focus:ring-2 focus:ring-blue-500" aria-label="Previous Leader">
                    <svg class="w-5 h-5 text-blue-900" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" /></svg>
                </button>
                <% } %>

                <!-- Next Arrow -->
                <% if (carouselSettings.showArrows !== false && activeLeaders.length > 1) { %>
                <button type="button" id="carouselNextBtn" class="absolute -right-3 md:-right-6 top-1/2 -translate-y-1/2 z-30 w-11 h-11 md:w-12 md:h-12 bg-white text-blue-900 rounded-full shadow-xl border border-slate-200/80 flex items-center justify-center hover:bg-blue-50 hover:scale-105 active:scale-95 transition-all focus:outline-none focus:ring-2 focus:ring-blue-500" aria-label="Next Leader">
                    <svg class="w-5 h-5 text-blue-900" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
                </button>
                <% } %>

                <!-- Carousel Viewport -->
                <div class="overflow-hidden rounded-3xl" id="carouselViewport">
                    <div id="carouselSlidesWrapper" class="relative">
                        
                        <% activeLeaders.forEach((leader, index) => { %>
                            <div class="leader-slide transition-opacity duration-500 ease-in-out <%= index === 0 ? 'block opacity-100' : 'hidden opacity-0' %>" data-index="<%= index %>" data-leader-id="<%= leader.id %>">
                                
                                <div class="bg-white rounded-3xl border border-slate-200/90 shadow-sm p-6 sm:p-8 lg:p-10">
                                    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-stretch">
                                        
                                        <!-- Left Column: Portrait Card with Overlaid Quote -->
                                        <div class="lg:col-span-5 relative rounded-2xl md:rounded-3xl overflow-hidden shadow-xl bg-slate-950 flex flex-col justify-end min-h-[480px] md:min-h-[560px] lg:min-h-[620px] border border-slate-200/70 group">
                                            <!-- Portrait Image -->
                                            <img src="<%= leader.portraitImage || '/images/sukinder_solanki.jpg' %>" alt="<%= leader.name %> — <%= leader.designation %>" class="absolute inset-0 w-full h-full object-cover object-top group-hover:scale-102 transition duration-700" loading="<%= index === 0 ? 'eager' : 'lazy' %>">
                                            
                                            <!-- Gradient Overlay -->
                                            <div class="absolute inset-0 bg-gradient-to-t from-[#071739] via-[#071739]/45 to-transparent"></div>

                                            <!-- Overlaid Quote Box -->
                                            <div class="relative z-10 p-6 md:p-8 text-white">
                                                <% if (leader.quote) { %>
                                                <p class="text-xs md:text-sm italic text-blue-100 mb-3.5 leading-relaxed border-l-2 border-[#38BDF8] pl-3.5 font-medium">“<%= leader.quote %>”</p>
                                                <% } %>
                                                <h2 class="text-lg md:text-xl font-bold text-white tracking-wide"><%= leader.name %></h2>
                                                <p class="text-xs md:text-sm text-[#38BDF8] font-semibold mt-0.5">
                                                    <%= leader.designation %><% if (leader.companyName) { %>, <%= leader.companyName %><% } %>
                                                </p>
                                            </div>
                                        </div>

                                        <!-- Right Column: Editorial Message & Narrative -->
                                        <div class="lg:col-span-7 flex flex-col justify-between relative pt-2">
                                            
                                            <!-- Top Header & Giant Quotation Mark Accent -->
                                            <div class="relative">
                                                <!-- Giant Decorative Quote Mark in top right background -->
                                                <div class="absolute right-0 -top-8 select-none pointer-events-none text-9xl md:text-[140px] font-serif text-blue-100/70 leading-none font-bold z-0" style="font-family: 'Playfair Display', serif;">
                                                    ”
                                                </div>

                                                <!-- Small Role Label -->
                                                <div class="flex items-center gap-2 mb-3.5 relative z-10">
                                                    <span class="w-6 h-0.5 bg-blue-600 rounded"></span>
                                                    <span class="text-xs font-bold uppercase tracking-widest text-blue-700">
                                                        <%= leader.roleLabel || 'A MESSAGE FROM LEADERSHIP' %>
                                                    </span>
                                                </div>

                                                <!-- Main Headline & Highlight Accent -->
                                                <div class="relative z-10 mb-6">
                                                    <h2 class="text-2xl sm:text-3xl md:text-4xl lg:text-[40px] font-black text-slate-900 tracking-tight leading-tight">
                                                        <%= leader.headline %>
                                                        <% if (leader.headlineHighlight) { %>
                                                            <span class="text-blue-600 block sm:inline"><%= leader.headlineHighlight %></span>
                                                        <% } %>
                                                    </h2>
                                                </div>
                                            </div>

                                            <!-- Message Letter Body -->
                                            <div class="space-y-4 text-slate-700 text-sm md:text-[15px] leading-relaxed relative z-10 font-normal">
                                                <% if (leader.greeting) { %>
                                                <p class="font-bold text-slate-900 text-base md:text-lg">
                                                    <%= leader.greeting %>
                                                </p>
                                                <% } %>

                                                <% if (Array.isArray(leader.paragraphs) && leader.paragraphs.length > 0) { %>
                                                    <% leader.paragraphs.forEach(paragraph => { %>
                                                        <p class="leading-relaxed"><%= paragraph %></p>
                                                    <% }); %>
                                                <% } else if (typeof leader.paragraphs === 'string' && leader.paragraphs.trim()) { %>
                                                    <p class="leading-relaxed"><%= leader.paragraphs %></p>
                                                <% } %>
                                            </div>

                                            <!-- Sign-off & Supporting Image Section -->
                                            <div class="pt-6 mt-6 border-t border-slate-200/80 grid grid-cols-1 sm:grid-cols-12 items-end gap-6 relative z-10">
                                                
                                                <!-- Left: Signature & Title -->
                                                <div class="sm:col-span-7 space-y-1">
                                                    <% if (leader.closing) { %>
                                                    <p class="text-xs text-slate-500 font-semibold mb-1"><%= leader.closing %></p>
                                                    <% } %>

                                                    <!-- Signature: Image or Typed Cursive -->
                                                    <div class="py-1">
                                                        <% if (leader.signatureType === 'image' && leader.signature) { %>
                                                            <img src="<%= leader.signature %>" alt="<%= leader.name %> Signature" class="h-12 w-auto object-contain">
                                                        <% } else { %>
                                                            <span class="text-3xl text-blue-950 font-bold tracking-wide select-none" style="font-family: 'Caveat', cursive;">
                                                                <%= leader.signatureName || leader.name %>
                                                            </span>
                                                        <% } %>
                                                    </div>

                                                    <h3 class="text-sm md:text-base font-bold text-slate-900"><%= leader.name %></h3>
                                                    <p class="text-xs text-slate-500 font-semibold leading-tight"><%= leader.designation %></p>
                                                    <% if (leader.companyName) { %>
                                                    <p class="text-xs text-blue-700 font-extrabold tracking-wider uppercase leading-tight mt-0.5"><%= leader.companyName %></p>
                                                    <% } %>
                                                </div>

                                                <!-- Right: Supporting Product / Pipe Fittings Graphic -->
                                                <% if (leader.supportingImage) { %>
                                                <div class="sm:col-span-5 flex justify-start sm:justify-end">
                                                    <div class="bg-slate-50/80 p-2 rounded-2xl border border-slate-200 shadow-sm">
                                                        <img src="<%= leader.supportingImage %>" alt="Solanki Pipes Infrastructure" class="w-40 sm:w-48 h-auto object-contain rounded-xl">
                                                    </div>
                                                </div>
                                                <% } %>

                                            </div>

                                        </div>

                                    </div>
                                </div>

                            </div>
                        <% }); %>

                    </div>
                </div>

                <!-- Carousel Pagination Dots -->
                <% if (carouselSettings.showDots !== false && activeLeaders.length > 1) { %>
                <div class="flex items-center justify-center gap-2 mt-6" id="carouselDotsContainer" aria-label="Carousel pagination">
                    <% activeLeaders.forEach((_, index) => { %>
                        <button type="button" class="carousel-dot transition-all duration-300 rounded-full <%= index === 0 ? 'w-8 h-2.5 bg-blue-600' : 'w-2.5 h-2.5 bg-slate-300 hover:bg-slate-400' %>" data-slide-index="<%= index %>" aria-label="Go to leader slide <%= index + 1 %>"></button>
                    <% }); %>
                </div>
                <% } %>

                <!-- Leader Navigation Tabs/Cards Below Carousel -->
                <% if (carouselSettings.showLeaderTabs !== false && activeLeaders.length > 1) { %>
                <div class="mt-8">
                    <div class="flex items-center justify-center gap-3 sm:gap-4 overflow-x-auto pb-2 scrollbar-none px-2" id="leaderTabsContainer" role="tablist">
                        <% activeLeaders.forEach((leader, index) => { %>
                            <button type="button" class="leader-tab group flex items-center gap-3 py-3 px-5 sm:px-6 rounded-2xl sm:rounded-full border text-left transition-all duration-300 whitespace-nowrap focus:outline-none focus:ring-2 focus:ring-blue-500 shrink-0 <%= index === 0 ? 'bg-blue-600 text-white shadow-md border-blue-600 active' : 'bg-blue-50/70 hover:bg-blue-100/60 text-slate-700 border-blue-100 hover:border-blue-200' %>" data-tab-index="<%= index %>" role="tab" aria-selected="<%= index === 0 ? 'true' : 'false' %>">
                                
                                <!-- User Icon Circle -->
                                <div class="w-8 h-8 rounded-full flex items-center justify-center shrink-0 transition-colors <%= index === 0 ? 'bg-white/20 text-white' : 'bg-blue-100 text-blue-700 group-hover:bg-blue-200' %>">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>
                                </div>

                                <!-- Text -->
                                <div>
                                    <span class="block text-xs sm:text-sm font-bold <%= index === 0 ? 'text-white' : 'text-slate-900 group-hover:text-blue-700' %>">
                                        <%= leader.name %>
                                    </span>
                                    <span class="block text-[11px] <%= index === 0 ? 'text-blue-100 font-medium' : 'text-slate-500 font-normal' %>">
                                        <%= leader.designation %>
                                    </span>
                                </div>
                            </button>
                        <% }); %>
                    </div>
                </div>
                <% } %>

            </section>

        <% } %>

        <!-- Leadership in Action Section -->
        <% if (activeActions.length > 0) { %>
        <section class="mt-12 lg:mt-16" aria-label="Leadership in Action">
            <div class="bg-white border border-slate-200/90 rounded-3xl p-6 sm:p-8 lg:p-10 shadow-sm">
                
                <!-- Section Header -->
                <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8 border-b border-slate-100 pb-5">
                    <div>
                        <div class="flex items-center gap-2 mb-1.5">
                            <span class="w-5 h-0.5 bg-blue-600 rounded"></span>
                            <span class="text-xs font-bold uppercase tracking-wider text-blue-700"><%= actionSubtitle %></span>
                        </div>
                        <h2 class="text-2xl md:text-3xl font-black text-slate-900 tracking-tight uppercase"><%= actionTitle %></h2>
                    </div>

                    <% if (actionLocationBadge) { %>
                    <div class="flex items-center">
                        <span class="inline-flex items-center gap-2 text-xs font-bold text-blue-900 bg-blue-50/90 px-4 py-2 rounded-full border border-blue-200 shadow-xs">
                            <span class="w-2.5 h-2.5 rounded-full bg-blue-600 animate-pulse"></span>
                            <%= actionLocationBadge.replace(/^[•\s]+/, '') %>
                        </span>
                    </div>
                    <% } %>
                </div>

                <!-- Action Cards Grid -->
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
                    <% activeActions.forEach((card) => { %>
                        <div class="group relative rounded-2xl overflow-hidden shadow-sm bg-slate-950 h-60 border border-slate-100 transition-all duration-300 hover:shadow-lg">
                            <img src="<%= card.image || '/images/sp_img1.jpeg' %>" alt="<%= card.title %>" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy">
                            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/90 via-slate-950/30 to-transparent"></div>
                            
                            <div class="absolute bottom-4 left-4 right-4 text-white">
                                <span class="text-[10px] sm:text-[11px] font-bold uppercase tracking-wider text-[#38BDF8] block">
                                    <%= card.category %>
                                </span>
                                <h3 class="text-xs sm:text-sm font-bold text-white mt-1 leading-snug">
                                    <%= card.title %>
                                </h3>
                                <% if (card.description) { %>
                                <p class="text-[11px] text-slate-300 mt-1 line-clamp-2 opacity-90 group-hover:opacity-100 transition-opacity">
                                    <%= card.description %>
                                </p>
                                <% } %>
                            </div>
                        </div>
                    <% }); %>
                </div>

            </div>
        </section>
        <% } %>

    </div>

</main>

<!-- Client Carousel Script with Admin Controls, Swipe, and Keyboard Access -->
<script>
(function() {
    // Configuration from backend / admin
    const config = {
        autoplay: <%= carouselSettings.autoplay !== false %>,
        autoplaySpeed: <%= Number(carouselSettings.autoplaySpeed) || 6000 %>,
        pauseOnHover: <%= carouselSettings.pauseOnHover !== false %>,
        transitionStyle: '<%= carouselSettings.transitionStyle || "slide" %>',
        transitionSpeed: <%= Number(carouselSettings.transitionSpeed) || 500 %>,
        enableSwipe: <%= carouselSettings.enableSwipe !== false %>,
        defaultIndex: <%= Number(carouselSettings.defaultActiveSlide) || 0 %>
    };

    const slides = document.querySelectorAll('.leader-slide');
    const dots = document.querySelectorAll('.carousel-dot');
    const tabs = document.querySelectorAll('.leader-tab');
    const prevBtn = document.getElementById('carouselPrevBtn');
    const nextBtn = document.getElementById('carouselNextBtn');
    const section = document.getElementById('leadershipCarouselSection');

    if (!slides || slides.length === 0) return;

    let currentIndex = Math.min(Math.max(config.defaultIndex, 0), slides.length - 1);
    let autoplayTimer = null;
    let isTransitioning = false;

    // Show specified slide
    function goToSlide(index) {
        if (isTransitioning) return;
        if (index < 0) index = slides.length - 1;
        if (index >= slides.length) index = 0;

        isTransitioning = true;
        currentIndex = index;

        slides.forEach((slide, idx) => {
            if (idx === currentIndex) {
                slide.classList.remove('hidden');
                // Trigger reflow for transition
                void slide.offsetWidth;
                slide.classList.remove('opacity-0');
                slide.classList.add('opacity-100', 'block');
            } else {
                slide.classList.remove('opacity-100', 'block');
                slide.classList.add('opacity-0', 'hidden');
            }
        });

        // Update Dots
        dots.forEach((dot, idx) => {
            if (idx === currentIndex) {
                dot.className = 'carousel-dot transition-all duration-300 rounded-full w-8 h-2.5 bg-blue-600';
            } else {
                dot.className = 'carousel-dot transition-all duration-300 rounded-full w-2.5 h-2.5 bg-slate-300 hover:bg-slate-400';
            }
        });

        // Update Leader Tabs
        tabs.forEach((tab, idx) => {
            const iconDiv = tab.querySelector('div:first-child');
            const nameSpan = tab.querySelector('span:first-child');
            const roleSpan = tab.querySelector('span:last-child');

            if (idx === currentIndex) {
                tab.className = 'leader-tab group flex items-center gap-3 py-3 px-5 sm:px-6 rounded-2xl sm:rounded-full border text-left transition-all duration-300 whitespace-nowrap focus:outline-none focus:ring-2 focus:ring-blue-500 shrink-0 bg-blue-600 text-white shadow-md border-blue-600 active';
                tab.setAttribute('aria-selected', 'true');
                if (iconDiv) iconDiv.className = 'w-8 h-8 rounded-full flex items-center justify-center shrink-0 transition-colors bg-white/20 text-white';
                if (nameSpan) nameSpan.className = 'block text-xs sm:text-sm font-bold text-white';
                if (roleSpan) roleSpan.className = 'block text-[11px] text-blue-100 font-medium';
            } else {
                tab.className = 'leader-tab group flex items-center gap-3 py-3 px-5 sm:px-6 rounded-2xl sm:rounded-full border text-left transition-all duration-300 whitespace-nowrap focus:outline-none focus:ring-2 focus:ring-blue-500 shrink-0 bg-blue-50/70 hover:bg-blue-100/60 text-slate-700 border-blue-100 hover:border-blue-200';
                tab.setAttribute('aria-selected', 'false');
                if (iconDiv) iconDiv.className = 'w-8 h-8 rounded-full flex items-center justify-center shrink-0 transition-colors bg-blue-100 text-blue-700 group-hover:bg-blue-200';
                if (nameSpan) nameSpan.className = 'block text-xs sm:text-sm font-bold text-slate-900 group-hover:text-blue-700';
                if (roleSpan) roleSpan.className = 'block text-[11px] text-slate-500 font-normal';
            }
        });

        setTimeout(() => {
            isTransitioning = false;
        }, Math.min(config.transitionSpeed, 300));
    }

    // Autoplay Controls
    function startAutoplay() {
        if (!config.autoplay || slides.length <= 1) return;
        stopAutoplay();
        autoplayTimer = setInterval(() => {
            goToSlide(currentIndex + 1);
        }, config.autoplaySpeed);
    }

    function stopAutoplay() {
        if (autoplayTimer) {
            clearInterval(autoplayTimer);
            autoplayTimer = null;
        }
    }

    // Attach Event Listeners
    if (prevBtn) {
        prevBtn.addEventListener('click', () => {
            goToSlide(currentIndex - 1);
            startAutoplay();
        });
    }

    if (nextBtn) {
        nextBtn.addEventListener('click', () => {
            goToSlide(currentIndex + 1);
            startAutoplay();
        });
    }

    dots.forEach((dot) => {
        dot.addEventListener('click', () => {
            const idx = parseInt(dot.getAttribute('data-slide-index'), 10);
            if (!isNaN(idx)) {
                goToSlide(idx);
                startAutoplay();
            }
        });
    });

    tabs.forEach((tab) => {
        tab.addEventListener('click', () => {
            const idx = parseInt(tab.getAttribute('data-tab-index'), 10);
            if (!isNaN(idx)) {
                goToSlide(idx);
                startAutoplay();
            }
        });
    });

    // Pause on Hover
    if (config.pauseOnHover && section) {
        section.addEventListener('mouseenter', stopAutoplay);
        section.addEventListener('mouseleave', startAutoplay);
    }

    // Keyboard Navigation
    document.addEventListener('keydown', (e) => {
        if (e.target && ['input', 'textarea', 'select'].includes(e.target.tagName.toLowerCase())) return;
        if (e.key === 'ArrowLeft') {
            goToSlide(currentIndex - 1);
            startAutoplay();
        } else if (e.key === 'ArrowRight') {
            goToSlide(currentIndex + 1);
            startAutoplay();
        }
    });

    // Touch Swipe Detection
    if (config.enableSwipe && section) {
        let touchStartX = 0;
        let touchEndX = 0;

        section.addEventListener('touchstart', (e) => {
            touchStartX = e.changedTouches[0].screenX;
        }, { passive: true });

        section.addEventListener('touchend', (e) => {
            touchEndX = e.changedTouches[0].screenX;
            const diff = touchEndX - touchStartX;
            if (Math.abs(diff) > 40) {
                if (diff < 0) {
                    goToSlide(currentIndex + 1); // Swipe left -> next
                } else {
                    goToSlide(currentIndex - 1); // Swipe right -> prev
                }
                startAutoplay();
            }
        }, { passive: true });
    }

    // Initialize initial slide & autoplay
    goToSlide(currentIndex);
    startAutoplay();
})();
</script>

