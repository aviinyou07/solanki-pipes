<%- include('partials/header') %>

    <header class="py-16 px-8 max-w-7xl mx-auto text-center">
        <h1 class="text-4xl md:text-8xl font-bold tracking-tight text-black mb-4">
            <%= (typeof pageData !== 'undefined' && pageData && pageData.titlePart1) ? pageData.titlePart1 : 'CONTACTING' %> <span class="font-light"><%= (typeof pageData !== 'undefined' && pageData && pageData.titlePart2) ? pageData.titlePart2 : 'SOLANKI' %></span>
        </h1>
        <p class="text-3xl md:text-6xl font-light mt-2 text-gray-700">
            <%= (typeof pageData !== 'undefined' && pageData && pageData.subtitle) ? pageData.subtitle : 'First Step to Excellence.' %>
        </p>
    </header>

    <main class="max-w-7xl mx-auto px-6 py-10">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-20">
            <!-- Location Card -->
            <div class="bg-white rounded-2xl p-7 border border-slate-200/80 shadow-sm hover:shadow-md transition">
                <div class="flex items-center gap-3 mb-6">
                    <div class="w-10 h-10 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center border border-blue-100">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"/></svg>
                    </div>
                    <div>
                        <span class="text-[10px] uppercase font-bold text-slate-400 tracking-wider block">Physical Presence</span>
                        <h3 class="font-extrabold text-sm uppercase text-slate-900">
                            <%= (typeof pageData !== 'undefined' && pageData && pageData.headOfficeTitle) ? pageData.headOfficeTitle : 'Head Office' %>
                        </h3>
                    </div>
                </div>

                <div class="space-y-4 text-xs">
                    <div>
                        <p class="font-bold text-slate-900 uppercase">
                            <%= (typeof pageData !== 'undefined' && pageData && pageData.headOfficeFirm) ? pageData.headOfficeFirm : 'Solanki Industries (Partnership Firm) — Brand: Solanki Pipes' %>
                        </p>
                        <p class="text-slate-600 mt-1 leading-relaxed">
                            <%- (typeof pageData !== 'undefined' && pageData && pageData.headOfficeAddress) ? pageData.headOfficeAddress.replace(/\n/g, '<br>') : 'Fatehabad Road, Mehuwala,<br>Fatehabad - 125053, Haryana, India.' %>
                        </p>
                    </div>

                    <div class="pt-3 border-t border-slate-100">
                        <span class="text-[10px] uppercase font-bold text-blue-700 tracking-wider block mb-1">
                            <%= (typeof pageData !== 'undefined' && pageData && pageData.manufacturingTitle) ? pageData.manufacturingTitle : 'Manufacturing Unit' %>
                        </span>
                        <p class="text-slate-600 leading-relaxed">
                            <%- (typeof pageData !== 'undefined' && pageData && pageData.manufacturingAddress) ? pageData.manufacturingAddress.replace(/\n/g, '<br>') : 'Khasra No. 115//2/2, Sarsa Ghoghra,<br>Bhiwani, Haryana 127021' %>
                        </p>
                    </div>
                </div>
            </div>

            <!-- Contact Numbers & WhatsApp Card -->
            <div class="bg-white rounded-2xl p-7 border border-slate-200/80 shadow-sm hover:shadow-md transition">
                <% 
                  const contactPhone1 = (typeof pageData !== 'undefined' && pageData && pageData.phone1) ? pageData.phone1 : ((typeof siteSettings !== 'undefined' && siteSettings && siteSettings.phone1) ? siteSettings.phone1 : '99921-77822');
                  const contactPhone2 = (typeof pageData !== 'undefined' && pageData && pageData.phone2) ? pageData.phone2 : ((typeof siteSettings !== 'undefined' && siteSettings && siteSettings.phone2) ? siteSettings.phone2 : '94664-58070');
                  const contactEmail = (typeof pageData !== 'undefined' && pageData && pageData.email) ? pageData.email : ((typeof siteSettings !== 'undefined' && siteSettings && siteSettings.email) ? siteSettings.email : 'sales@solankipipes.com');
                  const contactWhatsapp = (typeof pageData !== 'undefined' && pageData && pageData.whatsapp) ? pageData.whatsapp : ((typeof siteSettings !== 'undefined' && siteSettings && siteSettings.whatsapp) ? siteSettings.whatsapp : '919992177822');
                  const contactWhatsappBtn = (typeof pageData !== 'undefined' && pageData && pageData.whatsappBtnText) ? pageData.whatsappBtnText : 'Chat on WhatsApp';
                %>
                <div class="flex items-center gap-3 mb-6">
                    <div class="w-10 h-10 rounded-xl bg-cyan-50 text-cyan-700 flex items-center justify-center border border-cyan-100">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"/></svg>
                    </div>
                    <div>
                        <span class="text-[10px] uppercase font-bold text-slate-400 tracking-wider block">Support & Sales</span>
                        <h3 class="font-extrabold text-sm uppercase text-slate-900">Direct Lines</h3>
                    </div>
                </div>

                <div class="space-y-4 text-xs">
                    <div>
                        <span class="text-[10px] uppercase font-bold text-slate-400 block mb-1">Telephone</span>
                        <div class="text-slate-800 font-bold flex flex-wrap gap-2 text-sm">
                            <a href="tel:+<%= contactPhone1.replace(/[^0-9]/g, '') %>" class="hover:text-blue-600 transition"><%= contactPhone1 %></a>
                            <% if (contactPhone2) { %>
                            <span class="text-slate-300">|</span>
                            <a href="tel:+<%= contactPhone2.replace(/[^0-9]/g, '') %>" class="hover:text-blue-600 transition"><%= contactPhone2 %></a>
                            <% } %>
                        </div>
                    </div>

                    <div class="pt-3 border-t border-slate-100">
                        <span class="text-[10px] uppercase font-bold text-slate-400 block mb-1">Email Inquiries</span>
                        <a href="mailto:<%= contactEmail %>" class="text-blue-600 hover:text-blue-700 font-bold text-sm transition"><%= contactEmail %></a>
                    </div>

                    <div class="pt-2">
                        <a href="https://wa.me/<%= contactWhatsapp.replace(/[^0-9]/g, '') %>" target="_blank"
                            class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl text-white bg-emerald-600 hover:bg-emerald-700 shadow-md transition font-bold text-xs uppercase tracking-wide w-full">
                            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 00-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" /></svg>
                            <span><%= contactWhatsappBtn %></span>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Follow & Ecosystem Card -->
            <div class="bg-white rounded-2xl p-7 border border-slate-200/80 shadow-sm hover:shadow-md transition flex flex-col justify-between">
                <div>
                    <div class="flex items-center gap-3 mb-6">
                        <div class="w-10 h-10 rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center border border-purple-100">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 017.843 4.582M12 3a8.997 8.997 0 00-7.843 4.582m15.686 0A11.953 11.953 0 0112 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0121 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0112 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 013 12c0-1.605.42-3.113 1.157-4.418"/></svg>
                        </div>
                        <div>
                            <span class="text-[10px] uppercase font-bold text-slate-400 tracking-wider block">Connect</span>
                            <h3 class="font-extrabold text-sm uppercase text-slate-900">Digital Presence</h3>
                        </div>
                    </div>

                    <p class="text-xs text-slate-500 leading-relaxed mb-4">
                        Follow our official channels for real-time infrastructure updates, supply dispatch notes, and tender announcements.
                    </p>

                    <div class="flex items-center gap-3 mb-6">
                        <a href="<%= (typeof siteSettings !== 'undefined' && siteSettings && siteSettings.facebook) ? siteSettings.facebook : 'https://facebook.com/solankipipes' %>" target="_blank"
                            class="w-10 h-10 rounded-xl bg-slate-50 hover:bg-blue-600 text-slate-600 hover:text-white flex items-center justify-center transition border border-slate-200">
                            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
                        </a>
                        <a href="<%= (typeof siteSettings !== 'undefined' && siteSettings && siteSettings.instagram) ? siteSettings.instagram : 'https://instagram.com/solankipipes' %>" target="_blank"
                            class="w-10 h-10 rounded-xl bg-slate-50 hover:bg-pink-600 text-slate-600 hover:text-white flex items-center justify-center transition border border-slate-200">
                            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
                        </a>
                        <a href="<%= (typeof siteSettings !== 'undefined' && siteSettings && siteSettings.linkedin) ? siteSettings.linkedin : 'https://linkedin.com/company/solanki-pipes' %>" target="_blank"
                            class="w-10 h-10 rounded-xl bg-slate-50 hover:bg-blue-700 text-slate-600 hover:text-white flex items-center justify-center transition border border-slate-200">
                            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
                        </a>
                    </div>
                </div>

                <div class="pt-3 border-t border-slate-100 flex flex-wrap gap-3 text-[11px] font-bold uppercase tracking-wider text-slate-500">
                    <a href="/about" class="hover:text-blue-600 transition">About</a>
                    <span>•</span>
                    <a href="/quality" class="hover:text-blue-600 transition">Quality</a>
                    <span>•</span>
                    <a href="/downloads" class="hover:text-blue-600 transition">Downloads</a>
                </div>
            </div>
        </div>

        <div class="max-w-7xl mt-12">
            <h2 class="text-3xl md:text-6xl font-bold leading-tight mb-4 text-center uppercase tracking-tight">
                <%- (typeof pageData !== 'undefined' && pageData && pageData.formHeading) ? pageData.formHeading.replace(/\n/g, '<br>') : 'LET\'S BEGIN TOGETHER<br>FOR A NEW PROJECT PIPELINE' %>
            </h2>
            <p class="text-center text-gray-500 mb-12 max-w-2xl mx-auto text-sm md:text-base">
                <%= (typeof pageData !== 'undefined' && pageData && pageData.formSubheading) ? pageData.formSubheading : 'Reach out to discuss custom specifications, bulk quotations, or project tenders.' %>
            </p>

            <form
                class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-10 bg-white p-8 md:p-12 rounded-3xl border border-gray-100 shadow-sm relative">
                <div class="relative">
                    <input type="text" name="FullName" required placeholder="FULL NAME *"
                        class="w-full border-b border-gray-300 py-4 px-4 focus:outline-none focus:border-blue-500 text-xs placeholder-gray-400 bg-transparent">
                </div>
                <div class="relative">
                    <input type="text" name="Company" placeholder="COMPANY"
                        class="w-full border-b border-gray-300 py-4 px-4 focus:outline-none focus:border-blue-500 text-xs placeholder-gray-400 bg-transparent">
                </div>
                <div class="relative">
                    <input type="text" name="Designation" placeholder="DESIGNATION"
                        class="w-full border-b border-gray-300 py-4 px-4 focus:outline-none focus:border-blue-500 text-xs placeholder-gray-400 bg-transparent">
                </div>
                <div class="relative">
                    <input type="text" name="Mobile" required placeholder="MOBILE (WITH COUNTRY CODE) *"
                        class="w-full border-b border-gray-300 py-4 px-4 focus:outline-none focus:border-blue-500 text-xs placeholder-gray-400 bg-transparent">
                </div>
                <div class="relative">
                    <input type="email" name="Email" required placeholder="EMAIL *"
                        class="w-full border-b border-gray-300 py-4 px-4 focus:outline-none focus:border-blue-500 text-xs placeholder-gray-400 bg-transparent">
                </div>
                <div class="relative">
                    <select name="EnquiryType" required
                        class="w-full border-b border-gray-300 py-4 px-4 focus:outline-none focus:border-blue-500 text-xs text-gray-400 bg-transparent">
                        <option value="" disabled selected>ENQUIRY TYPE *</option>
                        <option value="Quotation">Quotation</option>
                        <option value="Vendor Empanelment">Vendor Empanelment</option>
                        <option value="Technical">Technical</option>
                        <option value="Other">Other</option>
                    </select>
                </div>
                <div class="md:col-span-2 relative">
                    <textarea name="ProjectDetails" required placeholder="PROJECT / PIPE SIZE / QUANTITY *" rows="3"
                        class="w-full border-b border-gray-300 py-4 px-4 focus:outline-none focus:border-blue-500 text-xs placeholder-gray-400 bg-transparent resize-none"></textarea>
                </div>
                <div class="md:col-span-2 relative">
                    <textarea name="Message" placeholder="MESSAGE" rows="3"
                        class="w-full border-b border-gray-300 py-4 px-4 focus:outline-none focus:border-blue-500 text-xs placeholder-gray-400 bg-transparent resize-none"></textarea>
                </div>

                <div class="md:col-span-2 relative py-2">
                    <!-- Premium reCAPTCHA Box -->
                    <div
                        class="w-64 bg-gray-50 border border-gray-200 rounded-xl p-4 flex items-center justify-between shadow-sm">
                        <div class="flex items-center gap-3">
                            <input type="checkbox" required id="recaptcha_check"
                                class="w-6 h-6 border-gray-300 rounded text-blue-600 focus:ring-blue-500 cursor-pointer">
                            <label for="recaptcha_check"
                                class="text-xs text-gray-700 font-semibold cursor-pointer select-none">I'm not a
                                robot</label>
                        </div>
                        <div class="flex flex-col items-center">
                            <img src="https://www.gstatic.com/recaptcha/api2/logo_48.png" alt="reCAPTCHA"
                                class="w-8 h-8">
                            <span class="text-[8px] text-gray-400 mt-0.5">reCAPTCHA</span>
                        </div>
                    </div>
                </div>

                <div class="pt-4 md:col-span-2">
                    <button type="submit"
                        class="bg-blue-600 hover:bg-blue-700 text-white rounded-xl w-full md:w-1/2 h-12 flex items-center justify-center shadow-lg transition duration-300 group">
                        <span class="text-[12px] font-bold uppercase tracking-wider flex items-center gap-2">
                            Submit Enquiry
                            <svg class="w-4 h-4 transform group-hover:translate-x-1 transition-transform" fill="none"
                                stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                            </svg>
                        </span>
                    </button>
                </div>
            </form>

            <!-- Prominent WhatsApp B2B Banner -->
            <div
                class="mt-12 p-8 bg-gradient-to-r from-emerald-50 via-teal-50 to-green-50 rounded-3xl border border-emerald-200/80 flex flex-col md:flex-row justify-between items-center gap-6 shadow-sm">
                <div class="flex items-center gap-4">
                    <div
                        class="w-14 h-14 rounded-2xl bg-emerald-600 text-white flex items-center justify-center shadow-md shrink-0">
                        <svg class="w-7 h-7 fill-current" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347m-5.421 7.403"/>
                        </svg>
                    </div>
                    <div class="text-left">
                        <h4 class="font-extrabold text-lg text-emerald-950">Prefer Direct Discussion?</h4>
                        <p class="text-xs md:text-sm text-emerald-800 font-medium">For Indian B2B buyers and project contractors, direct WhatsApp communication speeds up quotations 5–10× faster.</p>
                    </div>
                </div>
                <a href="https://wa.me/<%= contactWhatsapp.replace(/[^0-9]/g, '') %>" target="_blank"
                    class="bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-3.5 px-8 rounded-xl shadow-lg shadow-emerald-600/20 transition-all flex items-center gap-2 text-xs uppercase tracking-wider group shrink-0 hover:scale-105">
                    <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
