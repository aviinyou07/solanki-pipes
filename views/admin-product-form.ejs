<%- include('partials/admin-header') %>

<div class="flex-grow p-6 md:p-10 max-w-7xl w-full mx-auto">

    <!-- Page Header -->
    <div class="flex items-center justify-between mb-8">
        <div>
            <a href="/admin/products" class="text-blue-700 hover:text-blue-900 text-sm font-semibold flex items-center gap-1 mb-3">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
                Back to Products
            </a>
            <h1 class="text-3xl font-extrabold text-gray-900 uppercase tracking-tight"><%= product ? 'Edit' : 'Add New' %> <span class="text-blue-600">Product</span></h1>
            <p class="text-gray-500 text-sm mt-1">Manage product details, images, video demonstrations, animations, features, and specifications.</p>
        </div>
    </div>

    <!-- Form Card -->
    <form action="<%= action %>" method="POST" enctype="multipart/form-data" class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden mb-12">
        <div class="p-6 md:p-8 space-y-10">
            
            <!-- 1. Basic & Header Details Section -->
            <div>
                <h3 class="text-lg font-bold text-gray-900 mb-4 pb-2 border-b border-gray-200 flex items-center gap-2">
                    <span class="w-2.5 h-6 bg-blue-600 rounded-sm"></span>
                    <span>1. General & Header Information</span>
                </h3>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <!-- Name -->
                    <div>
                        <label class="block text-xs font-bold text-gray-700 uppercase mb-2">Product Name *</label>
                        <input type="text" name="name" required placeholder="e.g. HDPE PIPES or SPRINKLER PIPES" value="<%= product ? product.name : '' %>" class="w-full border border-gray-300 rounded-lg py-2.5 px-3.5 focus:outline-none focus:border-blue-500 text-sm">
                    </div>

                    <!-- Slug / ID -->
                    <div>
                        <label class="block text-xs font-bold text-gray-700 uppercase mb-2">Slug / ID (URL identifier) *</label>
                        <input type="text" name="slug" required placeholder="e.g. hdpe, sprinkler" value="<%= product ? (product.slug || product._id || '').toLowerCase() : '' %>" class="w-full border border-gray-300 rounded-lg py-2.5 px-3.5 focus:outline-none focus:border-blue-500 text-sm font-mono" <%= product ? 'readonly' : '' %>>
                        <p class="text-[11px] text-gray-400 mt-1">Primary identifier e.g. /hdpe, /sprinkler</p>
                    </div>

                    <!-- Page Headline -->
                    <div>
                        <label class="block text-xs font-bold text-gray-700 uppercase mb-2">Page Main Headline</label>
                        <input type="text" name="headline" placeholder="e.g. HDPE SPRINKLER PIPES (IS 14151)" value="<%= product ? (product.headline || product.name) : '' %>" class="w-full border border-gray-300 rounded-lg py-2.5 px-3.5 focus:outline-none focus:border-blue-500 text-sm">
                    </div>

                    <!-- Middle Banner Tagline -->
                    <div>
                        <label class="block text-xs font-bold text-gray-700 uppercase mb-2">Banner Tagline</label>
                        <input type="text" name="tagline" placeholder="e.g. Precision Water Distribution, Maximum Crop Yield" value="<%= product ? (product.tagline || 'Better pipe, Better life') : 'Better pipe, Better life' %>" class="w-full border border-gray-300 rounded-lg py-2.5 px-3.5 focus:outline-none focus:border-blue-500 text-sm">
                    </div>

                    <!-- Page Link -->
                    <div>
                        <label class="block text-xs font-bold text-gray-700 uppercase mb-2">Page Link URL</label>
                        <input type="text" name="link" placeholder="e.g. /hdpe, /sprinkler" value="<%= product ? (product.link || '/' + (product.slug || product._id || '')).toLowerCase() : '' %>" class="w-full border border-gray-300 rounded-lg py-2.5 px-3.5 focus:outline-none focus:border-blue-500 text-sm font-mono">
                    </div>

                    <!-- Badge Text -->
                    <div>
                        <label class="block text-xs font-bold text-gray-700 uppercase mb-2">Status Badge (Optional)</label>
                        <input type="text" name="badge" placeholder="e.g. BIS Certified, Popular Agriculture" value="<%= product ? product.badge : '' %>" class="w-full border border-gray-300 rounded-lg py-2.5 px-3.5 focus:outline-none focus:border-blue-500 text-sm">
                    </div>

                    <!-- Standards & Compliance -->
                    <div>
                        <label class="block text-xs font-bold text-gray-700 uppercase mb-2">Standards & Certification</label>
                        <input type="text" name="standards" placeholder="e.g. IS 4984:2016 or IS 14151 (Part 1 & 2)" value="<%= product ? product.standards : '' %>" class="w-full border border-gray-300 rounded-lg py-2.5 px-3.5 focus:outline-none focus:border-blue-500 text-sm">
                    </div>

                    <!-- Size Range -->
                    <div>
                        <label class="block text-xs font-bold text-gray-700 uppercase mb-2">Available Size Range</label>
                        <input type="text" name="sizeRange" placeholder="e.g. 20 mm to 1000 mm OD or 50 mm to 110 mm OD" value="<%= product ? product.sizeRange : '' %>" class="w-full border border-gray-300 rounded-lg py-2.5 px-3.5 focus:outline-none focus:border-blue-500 text-sm">
                    </div>

                    <!-- Pressure Rating -->
                    <div>
                        <label class="block text-xs font-bold text-gray-700 uppercase mb-2">Pressure Rating / Classes</label>
                        <input type="text" name="pressureRating" placeholder="e.g. PN 2.5 to PN 16 or Class 1 to Class 4 (2.5 to 6 kg/cm²)" value="<%= product ? product.pressureRating : '' %>" class="w-full border border-gray-300 rounded-lg py-2.5 px-3.5 focus:outline-none focus:border-blue-500 text-sm">
                    </div>

                    <!-- Material Grade -->
                    <div>
                        <label class="block text-xs font-bold text-gray-700 uppercase mb-2">Material Polymer Grade</label>
                        <input type="text" name="materialGrade" placeholder="e.g. PE 80 / PE 100 or PE 63 / PE 80" value="<%= product ? product.materialGrade : '' %>" class="w-full border border-gray-300 rounded-lg py-2.5 px-3.5 focus:outline-none focus:border-blue-500 text-sm">
                    </div>

                    <!-- Hero Subtitle -->
                    <div class="md:col-span-2">
                        <label class="block text-xs font-bold text-gray-700 uppercase mb-2">Hero Header Subtitle</label>
                        <textarea name="heroSubtitle" rows="2" placeholder="Introductory hero summary..." class="w-full border border-gray-300 rounded-lg py-2.5 px-3.5 focus:outline-none focus:border-blue-500 text-sm"><%= product ? product.heroSubtitle : '' %></textarea>
                    </div>

                    <!-- Short Description -->
                    <div class="md:col-span-2">
                        <label class="block text-xs font-bold text-gray-700 uppercase mb-2">Short Description (Cards & Previews)</label>
                        <textarea name="shortDescription" rows="2" placeholder="Brief summary of the product..." class="w-full border border-gray-300 rounded-lg py-2.5 px-3.5 focus:outline-none focus:border-blue-500 text-sm"><%= product ? product.shortDescription : '' %></textarea>
                    </div>
                </div>
            </div>

            <!-- 2. Detailed About & Content Section -->
            <div>
                <h3 class="text-lg font-bold text-gray-900 mb-4 pb-2 border-b border-gray-200 flex items-center gap-2">
                    <span class="w-2.5 h-6 bg-blue-600 rounded-sm"></span>
                    <span>2. Detailed Page Content & Applications</span>
                </h3>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="md:col-span-2">
                        <label class="block text-xs font-bold text-gray-700 uppercase mb-2">About Section Title</label>
                        <input type="text" name="aboutTitle" placeholder="e.g. About HDPE Pipes or About Sprinkler Irrigation Pipes" value="<%= product ? (product.aboutTitle || `About ${product.name}`) : '' %>" class="w-full border border-gray-300 rounded-lg py-2.5 px-3.5 focus:outline-none focus:border-blue-500 text-sm">
                    </div>

                    <div class="md:col-span-2">
                        <label class="block text-xs font-bold text-gray-700 uppercase mb-2">Full About Content (Separate paragraphs with double enter)</label>
                        <textarea name="aboutText" rows="6" placeholder="Detailed technical narrative..." class="w-full border border-gray-300 rounded-lg py-2.5 px-3.5 focus:outline-none focus:border-blue-500 text-sm leading-relaxed"><%= product ? product.aboutText : '' %></textarea>
                    </div>

                    <div class="md:col-span-2">
                        <label class="block text-xs font-bold text-gray-700 uppercase mb-2">Recommended Application Areas (One per line)</label>
                        <textarea name="applications" rows="4" placeholder="Potable Water Supply Networks&#10;Lift Irrigation Projects&#10;Agricultural Micro-Irrigation" class="w-full border border-gray-300 rounded-lg py-2.5 px-3.5 focus:outline-none focus:border-blue-500 text-sm"><%= product && product.applications ? product.applications.join('\n') : '' %></textarea>
                    </div>
                </div>
            </div>

            <!-- 3. Product Images Section -->
            <div>
                <h3 class="text-lg font-bold text-gray-900 mb-4 pb-2 border-b border-gray-200 flex items-center gap-2">
                    <span class="w-2.5 h-6 bg-blue-600 rounded-sm"></span>
                    <span>3. Product Images Management</span>
                </h3>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <!-- 1. Main Card Image -->
                    <div class="bg-slate-50 p-5 rounded-xl border border-slate-200">
                        <label class="block text-xs font-bold text-gray-800 uppercase mb-1">1. Main Card Image</label>
                        <p class="text-[11px] text-gray-500 mb-3">Displayed on product cards on Home page.</p>
                        <% if (product && product.mainImage) { %>
                            <div class="mb-3 flex items-center gap-3 bg-white p-2 rounded-lg border border-gray-200">
                                <img src="<%= product.mainImage %>" alt="Main" class="w-16 h-16 object-contain">
                                <span class="text-xs text-gray-500 truncate font-mono"><%= product.mainImage %></span>
                            </div>
                        <% } %>
                        <input type="file" name="mainImage" accept="image/*" class="w-full text-xs text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-blue-600 file:text-white hover:file:bg-blue-700 cursor-pointer">
                    </div>

                    <!-- 2. Hover Image -->
                    <div class="bg-slate-50 p-5 rounded-xl border border-slate-200">
                        <label class="block text-xs font-bold text-gray-800 uppercase mb-1">2. Hover Card Image</label>
                        <p class="text-[11px] text-gray-500 mb-3">Displayed when hovering over product card on Home page.</p>
                        <% if (product && product.hoverImage) { %>
                            <div class="mb-3 flex items-center gap-3 bg-white p-2 rounded-lg border border-gray-200">
                                <img src="<%= product.hoverImage %>" alt="Hover" class="w-16 h-16 object-contain">
                                <span class="text-xs text-gray-500 truncate font-mono"><%= product.hoverImage %></span>
                            </div>
                        <% } %>
                        <input type="file" name="hoverImage" accept="image/*" class="w-full text-xs text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-blue-600 file:text-white hover:file:bg-blue-700 cursor-pointer">
                    </div>

                    <!-- 3. Hero Image -->
                    <div class="bg-slate-50 p-5 rounded-xl border border-slate-200">
                        <label class="block text-xs font-bold text-gray-800 uppercase mb-1">3. Hero Slider Image</label>
                        <p class="text-[11px] text-gray-500 mb-3">Displayed on Home page top slider banner.</p>
                        <% if (product && product.heroImage) { %>
                            <div class="mb-3 flex items-center gap-3 bg-white p-2 rounded-lg border border-gray-200">
                                <img src="<%= product.heroImage %>" alt="Hero" class="w-16 h-16 object-contain">
                                <span class="text-xs text-gray-500 truncate font-mono"><%= product.heroImage %></span>
                            </div>
                        <% } %>
                        <input type="file" name="heroImage" accept="image/*" class="w-full text-xs text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-blue-600 file:text-white hover:file:bg-blue-700 cursor-pointer">
                    </div>

                    <!-- 4. Detail Page Display Image -->
                    <div class="bg-slate-50 p-5 rounded-xl border border-slate-200">
                        <label class="block text-xs font-bold text-gray-800 uppercase mb-1">4. Product Detail Showcase Image</label>
                        <p class="text-[11px] text-gray-500 mb-3">Hero image on the individual product page.</p>
                        <% if (product && product.detailImage) { %>
                            <div class="mb-3 flex items-center gap-3 bg-white p-2 rounded-lg border border-gray-200">
                                <img src="<%= product.detailImage %>" alt="Detail" class="w-16 h-16 object-contain">
                                <span class="text-xs text-gray-500 truncate font-mono"><%= product.detailImage %></span>
                            </div>
                        <% } %>
                        <input type="file" name="detailImage" accept="image/*" class="w-full text-xs text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-blue-600 file:text-white hover:file:bg-blue-700 cursor-pointer">
                    </div>

                    <!-- 5. Page Banner Image -->
                    <div class="bg-slate-50 p-5 rounded-xl border border-slate-200 md:col-span-2">
                        <label class="block text-xs font-bold text-gray-800 uppercase mb-1">5. Product Page Middle Banner Background Image</label>
                        <p class="text-[11px] text-gray-500 mb-3">Background photo behind the tagline banner.</p>
                        <% if (product && product.bannerImage) { %>
                            <div class="mb-3 flex items-center gap-3 bg-white p-2 rounded-lg border border-gray-200">
                                <img src="<%= product.bannerImage %>" alt="Banner" class="w-24 h-12 object-cover rounded">
                                <span class="text-xs text-gray-500 truncate font-mono"><%= product.bannerImage %></span>
                            </div>
                        <% } %>
                        <input type="file" name="bannerImage" accept="image/*" class="w-full text-xs text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-blue-600 file:text-white hover:file:bg-blue-700 cursor-pointer">
                    </div>
                </div>

                <!-- Product Gallery Images -->
                <div class="mt-6 pt-6 border-t border-slate-200">
                    <label class="block text-xs font-bold text-gray-800 uppercase mb-2">6. Product Gallery Images (3 Photos)</label>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                        <div class="bg-slate-50 p-4 rounded-xl border border-slate-200">
                            <span class="text-xs font-bold text-gray-600 block mb-2">Gallery Photo #1</span>
                            <% if (product && product.galleryImages && product.galleryImages[0]) { %>
                                <div class="mb-2 bg-white p-1 rounded border border-gray-200">
                                    <img src="<%= product.galleryImages[0] %>" class="h-12 w-auto object-contain">
                                </div>
                            <% } %>
                            <input type="file" name="gallery1" accept="image/*" class="w-full text-xs text-gray-500 file:mr-2 file:py-1 file:px-2 file:rounded file:border-0 file:text-xs file:bg-blue-600 file:text-white">
                        </div>
                        <div class="bg-slate-50 p-4 rounded-xl border border-slate-200">
                            <span class="text-xs font-bold text-gray-600 block mb-2">Gallery Photo #2</span>
                            <% if (product && product.galleryImages && product.galleryImages[1]) { %>
                                <div class="mb-2 bg-white p-1 rounded border border-gray-200">
                                    <img src="<%= product.galleryImages[1] %>" class="h-12 w-auto object-contain">
                                </div>
                            <% } %>
                            <input type="file" name="gallery2" accept="image/*" class="w-full text-xs text-gray-500 file:mr-2 file:py-1 file:px-2 file:rounded file:border-0 file:text-xs file:bg-blue-600 file:text-white">
                        </div>
                        <div class="bg-slate-50 p-4 rounded-xl border border-slate-200">
                            <span class="text-xs font-bold text-gray-600 block mb-2">Gallery Photo #3</span>
                            <% if (product && product.galleryImages && product.galleryImages[2]) { %>
                                <div class="mb-2 bg-white p-1 rounded border border-gray-200">
                                    <img src="<%= product.galleryImages[2] %>" class="h-12 w-auto object-contain">
                                </div>
                            <% } %>
                            <input type="file" name="gallery3" accept="image/*" class="w-full text-xs text-gray-500 file:mr-2 file:py-1 file:px-2 file:rounded file:border-0 file:text-xs file:bg-blue-600 file:text-white">
                        </div>
                    </div>
                </div>
            </div>

            <!-- 4. Video Showcase Section -->
            <div class="bg-gradient-to-br from-blue-50/60 to-indigo-50/40 p-6 rounded-2xl border border-blue-100">
                <h3 class="text-lg font-bold text-gray-900 mb-4 pb-2 border-b border-blue-200 flex items-center gap-2">
                    <span class="w-2.5 h-6 bg-blue-600 rounded-sm"></span>
                    <span>4. Video Demonstration Management</span>
                </h3>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <label class="block text-xs font-bold text-gray-700 uppercase mb-2">Video Title</label>
                        <input type="text" name="videoTitle" placeholder="e.g. Solanki Sprinkler Quick-Lock Assembly Demonstration" value="<%= product ? product.videoTitle : '' %>" class="w-full bg-white border border-gray-300 rounded-lg py-2.5 px-3.5 focus:outline-none focus:border-blue-500 text-sm">
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-gray-700 uppercase mb-2">Video Embed / Stream URL (YouTube or external MP4)</label>
                        <input type="text" name="videoUrl" placeholder="https://www.youtube.com/embed/... or https://domain.com/video.mp4" value="<%= product ? product.videoUrl : '' %>" class="w-full bg-white border border-gray-300 rounded-lg py-2.5 px-3.5 focus:outline-none focus:border-blue-500 text-sm font-mono">
                    </div>

                    <div class="md:col-span-2">
                        <label class="block text-xs font-bold text-gray-700 uppercase mb-2">Video Description</label>
                        <textarea name="videoDescription" rows="2" placeholder="Short description of the demonstration video..." class="w-full bg-white border border-gray-300 rounded-lg py-2.5 px-3.5 focus:outline-none focus:border-blue-500 text-sm"><%= product ? product.videoDescription : '' %></textarea>
                    </div>

                    <div class="md:col-span-2 bg-white p-4 rounded-xl border border-gray-200">
                        <label class="block text-xs font-bold text-gray-800 uppercase mb-1">Upload Direct Video File (Optional .mp4, .webm)</label>
                        <% if (product && product.videoFile) { %>
                            <div class="mb-2 text-xs text-blue-700 font-mono font-semibold">Current uploaded video: <%= product.videoFile %></div>
                        <% } %>
                        <input type="file" name="videoFile" accept="video/mp4,video/webm" class="w-full text-xs text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-blue-600 file:text-white hover:file:bg-blue-700 cursor-pointer">
                    </div>
                </div>
            </div>

            <!-- 5. Animation Showcase Section -->
            <div class="bg-gradient-to-br from-emerald-50/60 to-teal-50/40 p-6 rounded-2xl border border-emerald-100">
                <h3 class="text-lg font-bold text-gray-900 mb-4 pb-2 border-b border-emerald-200 flex items-center gap-2">
                    <span class="w-2.5 h-6 bg-emerald-600 rounded-sm"></span>
                    <span>5. Animation & Dynamic Flow Graphics</span>
                </h3>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <label class="block text-xs font-bold text-gray-700 uppercase mb-2">Animation Headline</label>
                        <input type="text" name="animationTitle" placeholder="e.g. Quick-Action Clamp & 360° Uniform Spray Distribution" value="<%= product ? product.animationTitle : '' %>" class="w-full bg-white border border-gray-300 rounded-lg py-2.5 px-3.5 focus:outline-none focus:border-emerald-500 text-sm">
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-gray-700 uppercase mb-2">Animation Image / Graphic URL (GIF, SVG, Lottie)</label>
                        <input type="text" name="animationUrl" placeholder="https://... or leave blank for interactive fluid simulation" value="<%= product ? product.animationUrl : '' %>" class="w-full bg-white border border-gray-300 rounded-lg py-2.5 px-3.5 focus:outline-none focus:border-emerald-500 text-sm font-mono">
                    </div>

                    <div class="md:col-span-2">
                        <label class="block text-xs font-bold text-gray-700 uppercase mb-2">Animation Subtitle / Technical Note</label>
                        <textarea name="animationSubtitle" rows="2" placeholder="Description of the flow mechanics and durability..." class="w-full bg-white border border-gray-300 rounded-lg py-2.5 px-3.5 focus:outline-none focus:border-emerald-500 text-sm"><%= product ? product.animationSubtitle : '' %></textarea>
                    </div>

                    <div class="md:col-span-2 bg-white p-4 rounded-xl border border-gray-200">
                        <label class="block text-xs font-bold text-gray-800 uppercase mb-1">Upload Animation File (GIF / MP4 / SVG / JSON)</label>
                        <% if (product && product.animationFile) { %>
                            <div class="mb-2 text-xs text-emerald-700 font-mono font-semibold">Current animation file: <%= product.animationFile %></div>
                        <% } %>
                        <input type="file" name="animationFile" accept="image/gif,image/svg+xml,video/mp4,application/json" class="w-full text-xs text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-emerald-600 file:text-white hover:file:bg-emerald-700 cursor-pointer">
                    </div>
                </div>
            </div>

            <!-- 6. Key Features Builder -->
            <div>
                <div class="flex items-center justify-between mb-4 pb-2 border-b border-gray-200">
                    <h3 class="text-lg font-bold text-gray-900 flex items-center gap-2">
                        <span class="w-2.5 h-6 bg-blue-600 rounded-sm"></span>
                        <span>6. Key Features & Highlights</span>
                    </h3>
                    <button type="button" onclick="addFeatureRow()" class="px-3 py-1.5 bg-blue-50 hover:bg-blue-100 text-blue-700 text-xs font-bold rounded-lg border border-blue-200 transition-colors flex items-center gap-1">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
                        <span>Add Feature</span>
                    </button>
                </div>

                <div id="features-container" class="space-y-4">
                    <% if (product && product.features && product.features.length > 0) { %>
                        <% product.features.forEach((feat, idx) => { %>
                            <div class="feature-row bg-slate-50 p-4 rounded-xl border border-slate-200 grid grid-cols-1 md:grid-cols-12 gap-3 items-center">
                                <div class="md:col-span-3">
                                    <label class="block text-[10px] font-bold text-gray-500 uppercase mb-1">Icon URL</label>
                                    <input type="text" name="featureIcons" value="<%= feat.icon %>" placeholder="Icon URL" class="w-full bg-white border border-gray-300 rounded-lg p-2 text-xs">
                                </div>
                                <div class="md:col-span-3">
                                    <label class="block text-[10px] font-bold text-gray-500 uppercase mb-1">Feature Title *</label>
                                    <input type="text" name="featureTitles" value="<%= feat.title %>" placeholder="e.g. 100% Virgin Grade" class="w-full bg-white border border-gray-300 rounded-lg p-2 text-xs font-bold">
                                </div>
                                <div class="md:col-span-5">
                                    <label class="block text-[10px] font-bold text-gray-500 uppercase mb-1">Description</label>
                                    <input type="text" name="featureDescriptions" value="<%= feat.description %>" placeholder="Short description..." class="w-full bg-white border border-gray-300 rounded-lg p-2 text-xs">
                                </div>
                                <div class="md:col-span-1 text-right pt-4 md:pt-0">
                                    <button type="button" onclick="this.closest('.feature-row').remove()" class="p-2 text-rose-600 hover:bg-rose-50 rounded-lg border border-rose-200 transition-colors">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                                    </button>
                                </div>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <div class="feature-row bg-slate-50 p-4 rounded-xl border border-slate-200 grid grid-cols-1 md:grid-cols-12 gap-3 items-center">
                            <div class="md:col-span-3">
                                <label class="block text-[10px] font-bold text-gray-500 uppercase mb-1">Icon URL</label>
                                <input type="text" name="featureIcons" value="https://cdn-icons-png.flaticon.com/512/1705/1705833.png" placeholder="Icon URL" class="w-full bg-white border border-gray-300 rounded-lg p-2 text-xs">
                            </div>
                            <div class="md:col-span-3">
                                <label class="block text-[10px] font-bold text-gray-500 uppercase mb-1">Feature Title *</label>
                                <input type="text" name="featureTitles" value="IS 14151 Certified" placeholder="Feature Title" class="w-full bg-white border border-gray-300 rounded-lg p-2 text-xs font-bold">
                            </div>
                            <div class="md:col-span-5">
                                <label class="block text-[10px] font-bold text-gray-500 uppercase mb-1">Description</label>
                                <input type="text" name="featureDescriptions" value="Manufactured strictly in accordance with BIS standards." placeholder="Description" class="w-full bg-white border border-gray-300 rounded-lg p-2 text-xs">
                            </div>
                            <div class="md:col-span-1 text-right pt-4 md:pt-0">
                                <button type="button" onclick="this.closest('.feature-row').remove()" class="p-2 text-rose-600 hover:bg-rose-50 rounded-lg border border-rose-200 transition-colors">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                                </button>
                            </div>
                        </div>
                    <% } %>
                </div>
            </div>

            <!-- 7. Specifications Table Builder -->
            <div>
                <div class="flex items-center justify-between mb-4 pb-2 border-b border-gray-200">
                    <h3 class="text-lg font-bold text-gray-900 flex items-center gap-2">
                        <span class="w-2.5 h-6 bg-blue-600 rounded-sm"></span>
                        <span>7. Specifications Table Rows</span>
                    </h3>
                    <button type="button" onclick="addSpecRow()" class="px-3 py-1.5 bg-blue-50 hover:bg-blue-100 text-blue-700 text-xs font-bold rounded-lg border border-blue-200 transition-colors flex items-center gap-1">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
                        <span>Add Spec Row</span>
                    </button>
                </div>

                <div id="specs-container" class="space-y-3">
                    <% if (product && product.specifications && product.specifications.length > 0) { %>
                        <% product.specifications.forEach(spec => { %>
                            <div class="spec-row bg-slate-50 p-3.5 rounded-xl border border-slate-200 grid grid-cols-1 md:grid-cols-12 gap-3 items-center">
                                <div class="md:col-span-3">
                                    <label class="block text-[10px] font-bold text-gray-500 uppercase mb-1">Nominal OD / Size</label>
                                    <input type="text" name="specSizes" value="<%= spec.size %>" placeholder="e.g. 63 mm" class="w-full bg-white border border-gray-300 rounded-lg p-2 text-xs font-bold">
                                </div>
                                <div class="md:col-span-3">
                                    <label class="block text-[10px] font-bold text-gray-500 uppercase mb-1">Class / SDR Rating</label>
                                    <input type="text" name="specClasses" value="<%= spec.classType %>" placeholder="e.g. Class 1 / Class 2" class="w-full bg-white border border-gray-300 rounded-lg p-2 text-xs">
                                </div>
                                <div class="md:col-span-3">
                                    <label class="block text-[10px] font-bold text-gray-500 uppercase mb-1">Working Pressure</label>
                                    <input type="text" name="specPressures" value="<%= spec.workingPressure %>" placeholder="e.g. 2.5 - 4.0 kg/cm²" class="w-full bg-white border border-gray-300 rounded-lg p-2 text-xs">
                                </div>
                                <div class="md:col-span-2">
                                    <label class="block text-[10px] font-bold text-gray-500 uppercase mb-1">Wall Thickness</label>
                                    <input type="text" name="specThicknesses" value="<%= spec.wallThickness %>" placeholder="e.g. 1.80 - 2.80 mm" class="w-full bg-white border border-gray-300 rounded-lg p-2 text-xs font-mono">
                                </div>
                                <div class="md:col-span-1 text-right pt-4 md:pt-0">
                                    <button type="button" onclick="this.closest('.spec-row').remove()" class="p-2 text-rose-600 hover:bg-rose-50 rounded-lg border border-rose-200 transition-colors">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                                    </button>
                                </div>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <div class="spec-row bg-slate-50 p-3.5 rounded-xl border border-slate-200 grid grid-cols-1 md:grid-cols-12 gap-3 items-center">
                            <div class="md:col-span-3">
                                <label class="block text-[10px] font-bold text-gray-500 uppercase mb-1">Nominal OD / Size</label>
                                <input type="text" name="specSizes" value="63 mm" placeholder="e.g. 63 mm" class="w-full bg-white border border-gray-300 rounded-lg p-2 text-xs font-bold">
                            </div>
                            <div class="md:col-span-3">
                                <label class="block text-[10px] font-bold text-gray-500 uppercase mb-1">Class / SDR Rating</label>
                                <input type="text" name="specClasses" value="Class 1 / Class 2" placeholder="e.g. Class 1" class="w-full bg-white border border-gray-300 rounded-lg p-2 text-xs">
                            </div>
                            <div class="md:col-span-3">
                                <label class="block text-[10px] font-bold text-gray-500 uppercase mb-1">Working Pressure</label>
                                <input type="text" name="specPressures" value="2.5 - 4.0 kg/cm²" placeholder="e.g. 2.5 - 4.0 kg/cm²" class="w-full bg-white border border-gray-300 rounded-lg p-2 text-xs">
                            </div>
                            <div class="md:col-span-2">
                                <label class="block text-[10px] font-bold text-gray-500 uppercase mb-1">Wall Thickness</label>
                                <input type="text" name="specThicknesses" value="1.80 - 2.80 mm" placeholder="e.g. 1.80 - 2.80 mm" class="w-full bg-white border border-gray-300 rounded-lg p-2 text-xs font-mono">
                            </div>
                            <div class="md:col-span-1 text-right pt-4 md:pt-0">
                                <button type="button" onclick="this.closest('.spec-row').remove()" class="p-2 text-rose-600 hover:bg-rose-50 rounded-lg border border-rose-200 transition-colors">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                                </button>
                            </div>
                        </div>
                    <% } %>
                </div>
            </div>

            <!-- Submit Buttons -->
            <div class="pt-6 border-t border-gray-100 flex items-center justify-end gap-4">
                <a href="/admin/products" class="px-5 py-2.5 text-xs font-bold text-gray-600 hover:text-gray-900 border border-gray-300 rounded-lg transition-colors">Cancel</a>
                <button type="submit" class="px-7 py-3 text-xs font-bold text-white bg-blue-600 hover:bg-blue-700 rounded-xl shadow-lg transition-all flex items-center gap-2">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                    <span>Save Product Changes</span>
                </button>
            </div>
        </div>
    </form>
</div>

<script>
function addFeatureRow() {
    const container = document.getElementById('features-container');
    const div = document.createElement('div');
    div.className = 'feature-row bg-slate-50 p-4 rounded-xl border border-slate-200 grid grid-cols-1 md:grid-cols-12 gap-3 items-center';
    div.innerHTML = `
        <div class="md:col-span-3">
            <label class="block text-[10px] font-bold text-gray-500 uppercase mb-1">Icon URL</label>
            <input type="text" name="featureIcons" value="https://cdn-icons-png.flaticon.com/512/1705/1705833.png" placeholder="Icon URL" class="w-full bg-white border border-gray-300 rounded-lg p-2 text-xs">
        </div>
        <div class="md:col-span-3">
            <label class="block text-[10px] font-bold text-gray-500 uppercase mb-1">Feature Title *</label>
            <input type="text" name="featureTitles" placeholder="e.g. UV Stabilized" class="w-full bg-white border border-gray-300 rounded-lg p-2 text-xs font-bold">
        </div>
        <div class="md:col-span-5">
            <label class="block text-[10px] font-bold text-gray-500 uppercase mb-1">Description</label>
            <input type="text" name="featureDescriptions" placeholder="Description of feature..." class="w-full bg-white border border-gray-300 rounded-lg p-2 text-xs">
        </div>
        <div class="md:col-span-1 text-right pt-4 md:pt-0">
            <button type="button" onclick="this.closest('.feature-row').remove()" class="p-2 text-rose-600 hover:bg-rose-50 rounded-lg border border-rose-200 transition-colors">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
            </button>
        </div>
    `;
    container.appendChild(div);
}

function addSpecRow() {
    const container = document.getElementById('specs-container');
    const div = document.createElement('div');
    div.className = 'spec-row bg-slate-50 p-3.5 rounded-xl border border-slate-200 grid grid-cols-1 md:grid-cols-12 gap-3 items-center';
    div.innerHTML = `
        <div class="md:col-span-3">
            <label class="block text-[10px] font-bold text-gray-500 uppercase mb-1">Nominal OD / Size</label>
            <input type="text" name="specSizes" placeholder="e.g. 75 mm" class="w-full bg-white border border-gray-300 rounded-lg p-2 text-xs font-bold">
        </div>
        <div class="md:col-span-3">
            <label class="block text-[10px] font-bold text-gray-500 uppercase mb-1">Class / SDR Rating</label>
            <input type="text" name="specClasses" placeholder="e.g. Class 2" class="w-full bg-white border border-gray-300 rounded-lg p-2 text-xs">
        </div>
        <div class="md:col-span-3">
            <label class="block text-[10px] font-bold text-gray-500 uppercase mb-1">Working Pressure</label>
            <input type="text" name="specPressures" placeholder="e.g. 3.2 kg/cm²" class="w-full bg-white border border-gray-300 rounded-lg p-2 text-xs">
        </div>
        <div class="md:col-span-2">
            <label class="block text-[10px] font-bold text-gray-500 uppercase mb-1">Wall Thickness</label>
            <input type="text" name="specThicknesses" placeholder="e.g. 2.10 - 3.70 mm" class="w-full bg-white border border-gray-300 rounded-lg p-2 text-xs font-mono">
        </div>
        <div class="md:col-span-1 text-right pt-4 md:pt-0">
            <button type="button" onclick="this.closest('.spec-row').remove()" class="p-2 text-rose-600 hover:bg-rose-50 rounded-lg border border-rose-200 transition-colors">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
            </button>
        </div>
    `;
    container.appendChild(div);
}
</script>

<%- include('partials/admin-footer') %>
