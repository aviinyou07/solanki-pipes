                </div>
                <h4 class="text-lg font-black text-slate-900 mb-2">Laboratory Testing</h4>
                <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-normal">
                    Full IS 4984 / IS 14333 test battery on finished pipe — every batch, in-house.
                </p>
            </div>

        </div>

    </section>

    <!-- ========================================== -->
    <!-- 8. IN-HOUSE TESTING LABORATORY (8 TESTS GRID) -->
    <!-- ========================================== -->
    <section class="max-w-7xl mx-auto px-4 sm:px-8 lg:px-12 py-16">
        
        <!-- Section Header -->
        <div class="mb-10 text-left" data-aos="fade-up">
            <div class="flex items-center gap-2 mb-2">
                <span class="text-xs font-black tracking-widest text-[#0284c7] uppercase">IN-HOUSE TESTING LABORATORY</span>
                <span class="w-10 h-[2px] bg-[#0284c7]"></span>
            </div>
            <h2 class="text-2xl sm:text-3xl lg:text-4xl font-black text-slate-900 tracking-tight mb-3">
                Tested for Performance. Proven for Reliability.
            </h2>
            <p class="text-sm sm:text-base text-slate-600 max-w-3xl">
                Comprehensive in-house testing capabilities as per IS 4984 / IS 14333.
            </p>
        </div>

        <!-- 8 Test Cards Grid -->
        <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-8 gap-3.5">
            
            <!-- 1. Hydrostatic Testing -->
            <div class="bg-white rounded-2xl border border-slate-200/90 p-4 flex flex-col items-center text-center shadow-sm hover:border-sky-300 hover:shadow-md transition-all">
                <div class="w-10 h-10 rounded-xl bg-sky-50 text-[#0284c7] flex items-center justify-center mb-3">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"/></svg>
                </div>
                <h5 class="text-xs font-bold text-slate-900 leading-snug">Hydrostatic Testing at 80°C</h5>
            </div>

            <!-- 2. Oxidation Induction -->
            <div class="bg-white rounded-2xl border border-slate-200/90 p-4 flex flex-col items-center text-center shadow-sm hover:border-sky-300 hover:shadow-md transition-all">
                <div class="w-10 h-10 rounded-xl bg-sky-50 text-[#0284c7] flex items-center justify-center mb-3">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg>
                </div>
                <h5 class="text-xs font-bold text-slate-900 leading-snug">Oxidation Induction Time</h5>
            </div>

            <!-- 3. Dimensions & Ovality -->
            <div class="bg-white rounded-2xl border border-slate-200/90 p-4 flex flex-col items-center text-center shadow-sm hover:border-sky-300 hover:shadow-md transition-all">
                <div class="w-10 h-10 rounded-xl bg-sky-50 text-[#0284c7] flex items-center justify-center mb-3">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"/></svg>
                </div>
                <h5 class="text-xs font-bold text-slate-900 leading-snug">Dimensions & Ovality</h5>
            </div>

            <!-- 4. Tensile & Elongation -->
            <div class="bg-white rounded-2xl border border-slate-200/90 p-4 flex flex-col items-center text-center shadow-sm hover:border-sky-300 hover:shadow-md transition-all">
                <div class="w-10 h-10 rounded-xl bg-sky-50 text-[#0284c7] flex items-center justify-center mb-3">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/></svg>
                </div>
                <h5 class="text-xs font-bold text-slate-900 leading-snug">Tensile & Elongation</h5>
            </div>

            <!-- 5. Carbon Black & Dispersion -->
            <div class="bg-white rounded-2xl border border-slate-200/90 p-4 flex flex-col items-center text-center shadow-sm hover:border-sky-300 hover:shadow-md transition-all">
                <div class="w-10 h-10 rounded-xl bg-sky-50 text-[#0284c7] flex items-center justify-center mb-3">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/></svg>
                </div>
                <h5 class="text-xs font-bold text-slate-900 leading-snug">Carbon Black & Dispersion</h5>
            </div>

            <!-- 6. Density Testing -->
            <div class="bg-white rounded-2xl border border-slate-200/90 p-4 flex flex-col items-center text-center shadow-sm hover:border-sky-300 hover:shadow-md transition-all">
                <div class="w-10 h-10 rounded-xl bg-sky-50 text-[#0284c7] flex items-center justify-center mb-3">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3"/></svg>
                </div>
                <h5 class="text-xs font-bold text-slate-900 leading-snug">Density Testing</h5>
            </div>

            <!-- 7. Melt Flow Rate -->
            <div class="bg-white rounded-2xl border border-slate-200/90 p-4 flex flex-col items-center text-center shadow-sm hover:border-sky-300 hover:shadow-md transition-all">
                <div class="w-10 h-10 rounded-xl bg-sky-50 text-[#0284c7] flex items-center justify-center mb-3">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"/></svg>
                </div>
                <h5 class="text-xs font-bold text-slate-900 leading-snug">Melt Flow Rate</h5>
            </div>

            <!-- 8. Reversion Testing -->
            <div class="bg-white rounded-2xl border border-slate-200/90 p-4 flex flex-col items-center text-center shadow-sm hover:border-sky-300 hover:shadow-md transition-all">
                <div class="w-10 h-10 rounded-xl bg-sky-50 text-[#0284c7] flex items-center justify-center mb-3">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
                </div>
                <h5 class="text-xs font-bold text-slate-900 leading-snug">Reversion Testing</h5>
            </div>

        </div>

    </section>

    <!-- ========================================== -->
    <!-- 9. FIELD GALLERY & CASE SHOWCASE -->
    <!-- ========================================== -->
    <% if (typeof product !== 'undefined' && product && product.galleryImages && product.galleryImages.length > 0) { %>
    <section class="max-w-7xl mx-auto px-4 sm:px-8 lg:px-12 py-12">
        <div class="mb-8 text-left" data-aos="fade-up">
            <div class="flex items-center gap-2 mb-2">
                <span class="text-xs font-black tracking-widest text-[#0284c7] uppercase">FIELD GALLERY</span>
                <span class="w-10 h-[2px] bg-[#0284c7]"></span>
            </div>
            <h2 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">HDPE Piping in Infrastructure & Water Supply</h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6" data-aos="fade-up">
            <% if (product.galleryImages[0]) { %>
            <div class="h-64 rounded-2xl overflow-hidden shadow-sm border border-slate-200 group">
                <img src="<%= product.galleryImages[0] %>" alt="HDPE Gallery 1" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
            </div>
            <% } %>
            <% if (product.galleryImages[1]) { %>
            <div class="h-64 rounded-2xl overflow-hidden shadow-sm border border-slate-200 group">
                <img src="<%= product.galleryImages[1] %>" alt="HDPE Gallery 2" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
            </div>
            <% } %>
            <% if (product.galleryImages[2]) { %>
            <div class="h-64 rounded-2xl overflow-hidden shadow-sm border border-slate-200 group">
                <img src="<%= product.galleryImages[2] %>" alt="HDPE Gallery 3" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
            </div>
            <% } %>
        </div>
    </section>
    <% } %>

    <!-- ========================================== -->
    <!-- 10. BOTTOM CTA BANNER (LET'S BUILD STRONGER INFRASTRUCTURE) -->
    <!-- ========================================== -->
    <section class="max-w-7xl mx-auto px-4 sm:px-8 lg:px-12 py-12">
        <div class="relative z-10 w-full p-6 grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
            
            <!-- Left White Card -->
            <div class="lg:col-span-7 bg-white/95 backdrop-blur rounded-3xl p-6 sm:p-10 border border-white/60">
                <div class="flex items-center gap-2 mb-3">
                    <span class="text-xs font-black tracking-widest text-[#0284c7] uppercase">SOLANKI HDPE PIPES</span>
                    <span class="w-10 h-[2px] bg-[#0284c7]"></span>
                </div>

                <h3 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight mb-3">
                    Let's Build Stronger Infrastructure Together
                </h3>

                <p class="text-xs sm:text-sm text-slate-600 font-normal leading-relaxed mb-8">
                    Partner with Solanki Industries for high-performance HDPE piping solutions engineered for a brighter, more sustainable future.
                </p>

                <div class="flex flex-wrap items-center gap-3.5">
                    <a href="/contact" class="inline-flex items-center gap-2 bg-[#0284c7] hover:bg-[#0369a1] text-white text-xs font-bold px-6 py-3 rounded-xl shadow-md transition-all">
                        <span>Request a Quote</span>
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                    </a>
                    <a href="/contact" class="inline-flex items-center gap-2 bg-white hover:bg-slate-50 border border-slate-300 text-slate-700 text-xs font-bold px-6 py-3 rounded-xl transition-all">
                        <span>Contact Us</span>
                    </a>
                </div>
            </div>

            <!-- Right Sector List with Icons -->
            <div class="lg:col-span-5 flex flex-col space-y-4 pl-0 lg:pl-10 text-slate-800">
                
                <div class="flex items-center gap-4 bg-white/60 backdrop-blur border border-slate-200/80 px-5 py-3.5 rounded-2xl shadow-sm">
                    <div class="w-9 h-9 rounded-xl bg-sky-50 text-[#0284c7] flex items-center justify-center shrink-0">
                        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M7.707 3.293a1 1 0 010 1.414L5.414 7H11a7 7 0 017 7v2a1 1 0 11-2 0v-2a5 5 0 00-5-5H5.414l2.293 2.293a1 1 0 11-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                    </div>
                    <span class="text-sm font-black tracking-wider uppercase">WATER SUPPLY</span>
                </div>

                <div class="flex items-center gap-4 bg-white/60 backdrop-blur border border-slate-200/80 px-5 py-3.5 rounded-2xl shadow-sm">
                    <div class="w-9 h-9 rounded-xl bg-sky-50 text-[#0284c7] flex items-center justify-center shrink-0">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/></svg>
                    </div>
                    <span class="text-sm font-black tracking-wider uppercase">SEWERAGE</span>
                </div>

                <div class="flex items-center gap-4 bg-white/60 backdrop-blur border border-slate-200/80 px-5 py-3.5 rounded-2xl shadow-sm">
                    <div class="w-9 h-9 rounded-xl bg-sky-50 text-[#0284c7] flex items-center justify-center shrink-0">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
                    </div>
                    <span class="text-sm font-black tracking-wider uppercase">INDUSTRIAL</span>
                </div>

                <div class="flex items-center gap-4 bg-white/60 backdrop-blur border border-slate-200/80 px-5 py-3.5 rounded-2xl shadow-sm">
                    <div class="w-9 h-9 rounded-xl bg-sky-50 text-[#0284c7] flex items-center justify-center shrink-0">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
                    </div>
                    <span class="text-sm font-black tracking-wider uppercase">INFRASTRUCTURE</span>
                </div>

            </div>

        </div>
    </section>

    <!-- ========================================== -->
    <!-- 11. EXPLORE OTHER PRODUCTS -->
    <!-- ========================================== -->
    <section class="max-w-7xl mx-auto px-4 sm:px-8 lg:px-12 py-12">
        <h3 class="text-center font-black text-2xl sm:text-3xl mb-8 uppercase text-slate-900 tracking-tight">
            Explore Other Products
        </h3>
        <div class="flex flex-wrap justify-center gap-8 md:gap-12">
            <% if (typeof products !== 'undefined' && products.length > 0) { %>
                <% products.filter(p => !product || (p._id !== product._id && p.id !== 'hdpe' && p._id !== 'hdpe')).forEach(p => { %>
                    <a class="group flex flex-col gap-4 items-center justify-center text-center cursor-pointer bg-white p-6 rounded-2xl border border-slate-200/90 shadow-sm hover:border-sky-300 hover:shadow-md transition-all w-64"
                        href="<%= p.link || '/' + p.slug %>">
                        <img alt="<%= p.name %>" class="w-40 h-28 object-contain transition-transform duration-300 group-hover:scale-105"
                            src="<%= p.hoverImage || p.mainImage %>">
                        <p class="text-sm group-hover:text-[#0284c7] font-extrabold text-slate-900 transition-colors uppercase tracking-wide"><%= p.name %></p>
                    </a>
                <% }) %>
            <% } %>

            <a class="group flex flex-col gap-4 items-center justify-center text-center cursor-pointer bg-white p-6 rounded-2xl border border-slate-200/90 shadow-sm hover:border-sky-300 hover:shadow-md transition-all w-64" href="/sprinkler">
                <img alt="Sprinkler Pipes" class="w-40 h-28 object-contain transition-transform duration-300 group-hover:scale-105" src="/images/lift_irrigation.jpeg">
                <p class="text-sm group-hover:text-[#0284c7] font-extrabold text-slate-900 transition-colors uppercase tracking-wide">HDPE SPRINKLER PIPES</p>
            </a>

            <a class="group flex flex-col gap-4 items-center justify-center text-center cursor-pointer bg-white p-6 rounded-2xl border border-slate-200/90 shadow-sm hover:border-sky-300 hover:shadow-md transition-all w-64" href="/">
                <div class="w-40 h-28 flex items-center justify-center bg-sky-50 rounded-xl group-hover:bg-[#0284c7] transition-colors">
                    <svg class="w-10 h-10 text-[#0284c7] group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
                    </svg>
                </div>
                <p class="text-sm group-hover:text-[#0284c7] font-extrabold text-slate-900 transition-colors uppercase tracking-wide">BACK TO HOME</p>
            </a>
        </div>
    </section>

</div>

<%- include('partials/footer') %>