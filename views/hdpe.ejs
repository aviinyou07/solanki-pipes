<%- include('partials/header') %>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Caveat:wght@600;700&family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

<div class="font-['Inter',sans-serif] bg-[#f8fafc] text-slate-800 antialiased overflow-hidden pb-16">

    <!-- ========================================== -->
    <!-- 1. HERO SECTION -->
    <!-- ========================================== -->
    <section class="relative w-full bg-gradient-to-b from-[#e0f2fe]/60 via-[#f0f9ff]/40 to-white pt-10 pb-16 px-4 sm:px-8 lg:px-12 border-b border-sky-100/60">
        <div class="max-w-7xl mx-auto">
            
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-8 items-center">
                
                <!-- Left Hero Content -->
                <div class="lg:col-span-6 flex flex-col justify-center text-left" data-aos="fade-right">
                    
                    <!-- Tag Header -->
                    <div class="flex items-center gap-2 mb-4">
                        <span class="text-xs font-black tracking-widest text-[#0284c7] uppercase"><%= (typeof product !== 'undefined' && product && product.name) ? product.name : 'SOLANKI HDPE PIPES' %></span>
                        <span class="w-10 h-[2px] bg-[#0284c7]"></span>
                    </div>

                    <!-- Main Title -->
                    <h1 class="text-3xl sm:text-5xl lg:text-[3.5rem] font-black tracking-tight text-[#0f172a] leading-[1.12] mb-5">
                        <% if (typeof product !== 'undefined' && product && product.headline) { %>
                            <%= product.headline %>
                        <% } else { %>
                            Reliable Piping <br>
                            <span class="text-[#0369a1]">for a Better Tomorrow</span>
                        <% } %>
                    </h1>

                    <!-- Subtitle -->
                    <p class="text-base sm:text-lg text-slate-600 font-normal leading-relaxed mb-8 max-w-xl">
                        <%= (typeof product !== 'undefined' && product && (product.heroSubtitle || product.shortDescription)) ? (product.heroSubtitle || product.shortDescription) : 'High-quality PE80 & PE100 HDPE pipes for water supply, sewerage and infrastructure applications.' %>
                    </p>

                    <!-- Key Spec Metric Badges in 1 row -->
                    <div class="grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-3 gap-2 mb-8">
                        <div class="flex items-center gap-2 bg-white/90 border border-slate-200/90 rounded-xl p-2.5 shadow-sm">
                            <div class="w-7 h-7 rounded-lg bg-sky-50 text-sky-600 flex items-center justify-center shrink-0">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
                            </div>
                            <div class="leading-tight">
                                <div class="text-[11px] font-extrabold text-slate-900"><%= (typeof product !== 'undefined' && product && product.materialGrade) ? product.materialGrade : 'PE80 & PE100' %></div>
                                <div class="text-[9px] text-slate-500 font-medium">Grades</div>
                            </div>
                        </div>

                        <div class="flex items-center gap-2 bg-white/90 border border-slate-200/90 rounded-xl p-2.5 shadow-sm">
                            <div class="w-7 h-7 rounded-lg bg-sky-50 text-sky-600 flex items-center justify-center shrink-0">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>
                            </div>
                            <div class="leading-tight">
                                <div class="text-[11px] font-extrabold text-slate-900"><%= (typeof product !== 'undefined' && product && product.sizeRange) ? product.sizeRange : '~11,808 MT/Yr' %></div>
                                <div class="text-[9px] text-slate-500 font-medium"><%= (typeof product !== 'undefined' && product && product.sizeRange) ? 'Size Range' : 'Capacity' %></div>
                            </div>
                        </div>

                        <div class="flex items-center gap-2 bg-white/90 border border-slate-200/90 rounded-xl p-2.5 shadow-sm col-span-2 sm:col-span-1">
                            <div class="w-7 h-7 rounded-lg bg-emerald-50 text-emerald-600 flex items-center justify-center shrink-0">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
                            </div>
                            <div class="leading-tight">
                                <div class="text-[11px] font-extrabold text-slate-900"><%= (typeof product !== 'undefined' && product && (product.badge || product.standards)) ? (product.badge || product.standards) : 'BIS Certified' %></div>
                                <div class="text-[9px] text-slate-500 font-medium"><%= (typeof product !== 'undefined' && product && product.standards) ? product.standards : 'Products' %></div>
                            </div>
                        </div>
                    </div>

                    <!-- CTA Buttons -->
                    <div class="flex flex-wrap items-center gap-4">
                        <a href="#specifications" class="inline-flex items-center gap-2 bg-[#0284c7] hover:bg-[#0369a1] text-white text-sm font-bold px-7 py-3.5 rounded-xl shadow-md hover:shadow-lg transition-all duration-200 transform hover:-translate-y-0.5">
                            <span>Explore Products</span>
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                        </a>
                        <a href="<%= (typeof siteSettings !== 'undefined' && siteSettings && siteSettings.catalogPdf) ? siteSettings.catalogPdf : '/images/Catalog Solanki Pipes.pdf' %>" download class="inline-flex items-center gap-2 bg-white hover:bg-slate-50 border border-slate-300 text-slate-700 text-sm font-bold px-6 py-3.5 rounded-xl shadow-sm transition-all duration-200">
                            <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
                            <span>Download Brochure</span>
                        </a>
                    </div>
                </div>

                <!-- Right Hero Image with Cursive Tagline -->
                <div class="lg:col-span-6 relative flex items-center justify-center" data-aos="fade-left">
                    <!-- Glowing Background -->
                    <div class="absolute inset-0 bg-gradient-to-tr from-sky-200/50 to-blue-200/30 rounded-3xl blur-2xl -z-10 scale-95"></div>

                    <!-- Pipe Image Stack -->
                    <div class="w-full flex justify-center">
                        <img src="<%= (typeof product !== 'undefined' && product && (product.detailImage || product.heroImage || product.mainImage)) ? (product.detailImage || product.heroImage || product.mainImage) : '/images/collection.png' %>" alt="<%= (typeof product !== 'undefined' && product && product.name) ? product.name : 'Solanki HDPE Pipe Stack' %>" class="w-full max-w-lg h-auto object-contain transform transition-transform duration-700 hover:scale-105 drop-shadow-xl">
                    </div>
                </div>

            </div>

        </div>
    </section>

    <!-- ========================================== -->
    <!-- 2. MANUFACTURING CAPABILITY SECTION -->
    <!-- ========================================== -->
    <section class="max-w-7xl mx-auto px-4 sm:px-8 lg:px-12 py-16">
        
        <!-- Section Header -->
        <div class="mb-10 text-left" data-aos="fade-up">
            <div class="flex items-center gap-2 mb-2">
                <span class="text-xs font-black tracking-widest text-[#0284c7] uppercase">MANUFACTURING CAPABILITY</span>
                <span class="w-10 h-[2px] bg-[#0284c7]"></span>
            </div>
            <h2 class="text-2xl sm:text-3xl lg:text-4xl font-black text-slate-900 tracking-tight mb-3">
                Advanced Manufacturing. Consistent Quality.
            </h2>
            <p class="text-sm sm:text-base text-slate-600 max-w-3xl">
                Three automated in-house extrusion lines delivering precision-engineered HDPE pipes up to DN 1000 mm.
            </p>
        </div>

        <!-- 3 Extrusion Line Cards -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
            
            <!-- Extrusion Line 1 -->
            <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden group hover:shadow-md transition-shadow" data-aos="fade-up" data-aos-delay="100">
                <div class="relative h-48 sm:h-56 w-full overflow-hidden bg-slate-900">
                    <img src="/images/sp_img1.jpeg" alt="Extrusion Line 1" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 opacity-95">
                    <div class="absolute bottom-3 left-3 bg-[#0369a1] text-white text-xs font-extrabold px-3 py-1.5 rounded-lg shadow">
                        Extrusion Line 1
                    </div>
                </div>
            </div>

            <!-- Extrusion Line 2 -->
            <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden group hover:shadow-md transition-shadow" data-aos="fade-up" data-aos-delay="200">
                <div class="relative h-48 sm:h-56 w-full overflow-hidden bg-slate-900">
                    <img src="/images/sp_img2.jpeg" alt="Extrusion Line 2" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 opacity-95">
                    <div class="absolute bottom-3 left-3 bg-[#0369a1] text-white text-xs font-extrabold px-3 py-1.5 rounded-lg shadow">
                        Extrusion Line 2
                    </div>
                </div>
            </div>

            <!-- Extrusion Line 3 -->
            <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden group hover:shadow-md transition-shadow" data-aos="fade-up" data-aos-delay="300">
                <div class="relative h-48 sm:h-56 w-full overflow-hidden bg-slate-900">
                    <img src="/images/sp_img3.jpeg" alt="Extrusion Line 3" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 opacity-95">
                    <div class="absolute bottom-3 left-3 bg-[#0369a1] text-white text-xs font-extrabold px-3 py-1.5 rounded-lg shadow">
                        Extrusion Line 3
                    </div>
                </div>
            </div>

        </div>

        <!-- Capability Note Description -->
        <p class="text-xs sm:text-sm text-slate-500 leading-relaxed max-w-4xl mb-8">
            Automated in-line process control — melt temperature, line speed and wall thickness are held continuously to spec, for consistent, dimensionally accurate, defect-free pipe on every run.
        </p>

        <!-- 3 Feature Highlight Boxes -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            
            <div class="flex items-center gap-4 bg-[#f0f9ff] border border-sky-200/80 rounded-2xl p-5">
                <div class="w-12 h-12 rounded-xl bg-white text-[#0284c7] flex items-center justify-center shadow-sm shrink-0 border border-sky-100">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/></svg>
                </div>
                <div>
                    <h4 class="text-base font-extrabold text-slate-900"><%= (typeof product !== 'undefined' && product && product.materialGrade) ? product.materialGrade : 'PE80 & PE100' %></h4>
                    <p class="text-xs text-slate-500 font-medium mt-0.5">High-Grade Polymers</p>
                </div>
            </div>

            <div class="flex items-center gap-4 bg-[#f0f9ff] border border-sky-200/80 rounded-2xl p-5">
                <div class="w-12 h-12 rounded-xl bg-white text-[#0284c7] flex items-center justify-center shadow-sm shrink-0 border border-sky-100">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/></svg>
                </div>
                <div>
                    <h4 class="text-base font-extrabold text-slate-900"><%= (typeof product !== 'undefined' && product && product.sizeRange) ? product.sizeRange : 'Up to DN 1000 mm' %></h4>
                    <p class="text-xs text-slate-500 font-medium mt-0.5">Large-diameter capability</p>
                </div>
            </div>

            <div class="flex items-center gap-4 bg-[#f0f9ff] border border-sky-200/80 rounded-2xl p-5">
                <div class="w-12 h-12 rounded-xl bg-white text-[#0284c7] flex items-center justify-center shadow-sm shrink-0 border border-sky-100">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
                </div>
                <div>
                    <h4 class="text-base font-extrabold text-slate-900">~11,808 MT / Year</h4>
                    <p class="text-xs text-slate-500 font-medium mt-0.5">CIPET-assessed capacity</p>
                </div>
            </div>

        </div>

    </section>

    <!-- ========================================== -->
    <!-- 3. BIS CERTIFIED HDPE PIPES (IS 4984 vs IS 14333) -->
    <!-- ========================================== -->
    <section id="water-pipes" class="max-w-7xl mx-auto px-4 sm:px-8 lg:px-12 py-16">
        
        <!-- Section Header -->
        <div class="mb-10 text-left" data-aos="fade-up">
            <div class="flex items-center gap-2 mb-2">
                <span class="text-xs font-black tracking-widest text-[#0284c7] uppercase">BIS CERTIFIED HDPE PIPES</span>
                <span class="w-10 h-[2px] bg-[#0284c7]"></span>
            </div>
            <p class="text-sm sm:text-base text-slate-600 max-w-3xl">
                Our products are licensed under both key BIS standards for water supply and sewerage applications.
            </p>
        </div>

        <!-- 2 Standard Cards Grid -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
            
            <!-- Card 1: IS 4984:2016 (Water Supply) -->
            <div class="bg-white rounded-3xl border border-slate-200/90 shadow-lg p-6 sm:p-8 flex flex-col justify-between hover:border-sky-300 transition-colors" data-aos="fade-right">
                <div>
                    <!-- Header Icon & Title -->
                    <div class="flex items-center gap-4 mb-6">
                        <div class="w-14 h-14 rounded-2xl bg-[#0284c7] text-white flex items-center justify-center shadow-md shrink-0">
                            <svg class="w-7 h-7" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M7.707 3.293a1 1 0 010 1.414L5.414 7H11a7 7 0 017 7v2a1 1 0 11-2 0v-2a5 5 0 00-5-5H5.414l2.293 2.293a1 1 0 11-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clip-rule="evenodd"/><path d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1z"/></svg>
                        </div>
                        <div>
                            <h3 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">IS 4984:2016</h3>
                            <p class="text-sm font-bold text-[#0284c7]">HDPE Pipes for Water Supply</p>
                        </div>
                    </div>

                    <!-- Main Body Layout: Checkpoints + Pipe Graphic -->
                    <div class="grid grid-cols-1 sm:grid-cols-12 gap-6 items-center mb-8">
                        <div class="sm:col-span-7 space-y-2.5">
                            <div class="flex items-start gap-2.5 text-xs text-slate-700 font-medium">
                                <svg class="w-4 h-4 text-[#0284c7] shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                                <span>Licence: <strong>CM/L 9100182616</strong></span>
                            </div>
                            <div class="flex items-start gap-2.5 text-xs text-slate-700 font-medium">
                                <svg class="w-4 h-4 text-[#0284c7] shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                                <span>Brand: <strong>SOLANKI</strong></span>
                            </div>
                            <div class="flex items-start gap-2.5 text-xs text-slate-700 font-medium">
                                <svg class="w-4 h-4 text-[#0284c7] shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                                <span><%= (typeof product !== 'undefined' && product && product.materialGrade) ? product.materialGrade : 'PE80 & PE100' %></span>
                            </div>
                            <div class="flex items-start gap-2.5 text-xs text-slate-700 font-medium">
                                <svg class="w-4 h-4 text-[#0284c7] shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                                <span>Sizes up to <strong>DN 1000 mm</strong></span>
                            </div>
                            <div class="flex items-start gap-2.5 text-xs text-slate-700 font-medium">
                                <svg class="w-4 h-4 text-[#0284c7] shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                                <span>Multiple pressure ratings: <%= (typeof product !== 'undefined' && product && product.pressureRating) ? product.pressureRating : 'PN 2.5 to PN 16' %></span>
                            </div>
                            <div class="flex items-start gap-2.5 text-xs text-slate-700 font-medium">
                                <svg class="w-4 h-4 text-[#0284c7] shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                                <span>Incorporates Amendment No. 2 (April 2022)</span>
                            </div>
                            <div class="flex items-start gap-2.5 text-xs text-slate-700 font-medium">
                                <svg class="w-4 h-4 text-[#0284c7] shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                                <span>Valid to Dec 2026 - operative on BIS MANAK portal</span>
                            </div>
                        </div>

                        <!-- Right Pipe Display Image -->
                        <div class="sm:col-span-5 flex justify-center items-center">
                            <img src="<%= (typeof product !== 'undefined' && product && product.mainImage) ? product.mainImage : '/images/product_01.png' %>" alt="HDPE Water Supply Pipe" class="w-full max-w-[200px] h-auto object-contain drop-shadow-md">
                        </div>
                    </div>
                </div>

                <!-- Bottom Button -->
                <a href="/contact" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-[#0284c7] hover:bg-[#0369a1] text-white text-xs font-bold px-6 py-3 rounded-xl transition-colors">
                    <span>View Water Supply Pipes</span>
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                </a>
            </div>

            <!-- Card 2: IS 14333:2022 (Sewerage & Effluent) -->
            <div class="bg-white rounded-3xl border border-slate-200/90 shadow-lg p-6 sm:p-8 flex flex-col justify-between hover:border-sky-300 transition-colors" data-aos="fade-left">
                <div>
                    <!-- Header Icon & Title -->
                    <div class="flex items-center gap-4 mb-6">
                        <div class="w-14 h-14 rounded-2xl bg-[#0369a1] text-white flex items-center justify-center shadow-md shrink-0">
                            <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/></svg>
                        </div>
                        <div>
                            <h3 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">IS 14333:2022</h3>
                            <p class="text-sm font-bold text-[#0369a1]">HDPE Pipes for Sewerage & Effluent</p>
                        </div>
                    </div>

                    <!-- Main Body Layout: Checkpoints + Pipe Graphic -->
                    <div class="grid grid-cols-1 sm:grid-cols-12 gap-6 items-center mb-8">
                        <div class="sm:col-span-7 space-y-2.5">
                            <div class="flex items-start gap-2.5 text-xs text-slate-700 font-medium">
                                <svg class="w-4 h-4 text-[#0369a1] shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                                <span>Licence: <strong>CM/L 9100198114</strong></span>
                            </div>
                            <div class="flex items-start gap-2.5 text-xs text-slate-700 font-medium">
                                <svg class="w-4 h-4 text-[#0369a1] shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
